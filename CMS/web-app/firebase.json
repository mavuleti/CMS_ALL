{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["npm --prefix functions run build"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true, "port": 4000 }
  },
  "hosting": {
    "predeploy": ["node scripts/guard-hosting-deploy.mjs"],
    "public": "out",
    "ignore": [
      "firebase.json",
      ".firebaseignore",
      "**/.*",
      "**/node_modules/**",
      "**/*.zip",
      "README.md",
      "**/printable"
    ],
    "rewrites": [
      {
        "source": "/api/stripe-webhook",
        "function": {
          "functionId": "stripeWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/browser-error",
        "function": {
          "functionId": "recordBrowserError",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/record-download",
        "function": {
          "functionId": "recordDownload",
          "region": "us-central1"
        }
      }
    ],
    "redirects": [
      {
        "source": "/dinosaurs/tyrannosaurus-rex-dot-to-dot-puzzle/printable",
        "destination": "/dinosaurs/trex-61-dot-to-dot-printable-horizontal.pdf",
        "type": 301
      },
      {
        "source": "/dinosaurs/tyrannosaurus-rex-dot-to-dot-puzzle/printable/",
        "destination": "/dinosaurs/trex-61-dot-to-dot-printable-horizontal.pdf",
        "type": 301
      },
      {
        "source": "/dinosaurs/tyrannosaurus-rex-dot-to-dot-puzzle",
        "destination": "/dinosaurs/trex-61-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "source": "/dinosaurs/tyrannosaurus-rex-dot-to-dot-puzzle/",
        "destination": "/dinosaurs/trex-61-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "source": "/dinosaurs/apatosaurus",
        "destination": "/dinosaurs/brontosaurus-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "source": "/dinosaurs/apatosaurus/",
        "destination": "/dinosaurs/brontosaurus-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "source": "/dinosaurs/apatosaurus-dot-to-dot-puzzle-printable.pdf",
        "destination": "/dinosaurs/brontosaurus-dot-to-dot-puzzle-printable-horizontal.pdf",
        "type": 301
      },
      {
        "source": "/dinosaurs/brontosaurus-dot-to-dot-puzzle-printable.pdf",
        "destination": "/dinosaurs/brontosaurus-dot-to-dot-puzzle-printable-horizontal.pdf",
        "type": 301
      },
      {
        "source": "/dinosaurs/stegosaurus",
        "destination": "/dinosaurs/stegosaurus-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "source": "/dinosaurs/stegosaurus/",
        "destination": "/dinosaurs/stegosaurus-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "source": "/en/dinosaurs/stegosaurus",
        "destination": "/dinosaurs/stegosaurus-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "source": "/en/dinosaurs/stegosaurus/",
        "destination": "/dinosaurs/stegosaurus-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "source": "/fi/dinosaurs/stegosaurus",
        "destination": "/fi/dinosaurs/stegosaurus-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "source": "/fi/dinosaurs/stegosaurus/",
        "destination": "/fi/dinosaurs/stegosaurus-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "source": "/dinosaurs/pterodactyl",
        "destination": "/dinosaurs/pterodactyl-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "source": "/dinosaurs/pterodactyl/",
        "destination": "/dinosaurs/pterodactyl-dot-to-dot-puzzle/",
        "type": 301
      },
      {
        "regex": "^/$",
        "destination": "/en/",
        "type": 301
      },
      {
        "regex": "^/(ar-AE|ar-SA|ar-QA)/?$",
        "destination": "/ar/",
        "type": 301
      },
      {
        "regex": "^/(ar-AE|ar-SA|ar-QA)/(.+)$",
        "destination": "/ar/:2",
        "type": 301
      },
      {
        "regex": "^/(about|blog|canada|contact|cute|dinosaurs|flowers|garden|ocean|playgrounds|premium|privacy-policy|purchase|search|terms|uae|usa-250)/([^/.]+)/index\\.txt$",
        "destination": "/en/:1/:2/index.txt",
        "type": 301
      },
      {
        "regex": "^/(about|blog|canada|contact|cute|dinosaurs|flowers|garden|ocean|playgrounds|premium|privacy-policy|purchase|search|terms|uae|usa-250)(?:/([^/.]+))?/?$",
        "destination": "/en/:1/:2?/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://docs.google.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebaseinstallations.googleapis.com https://firebaseappcheck.googleapis.com https://content-firebaseappcheck.googleapis.com https://www.google.com/recaptcha/ https://*.cloudfunctions.net; font-src 'self' https://fonts.gstatic.com; form-action 'self' https://docs.google.com; frame-ancestors 'self'; frame-src https://www.youtube-nocookie.com https://docs.google.com https://www.google.com/recaptcha/ https://dottodot-7ab01.firebaseapp.com; img-src 'self' data: https://i.ytimg.com; object-src 'none'; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.googletagmanager.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; upgrade-insecure-requests"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "**/*.pdf",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/pdf"
          },
          {
            "key": "Content-Disposition",
            "value": "inline"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|otf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
