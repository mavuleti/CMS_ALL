2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Lar\",\"item\":\"https://dottodotfreeprintables.com/pt-BR/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Dinosaurs\",\"item\":\"https://dottodotfreeprintables.com/pt-BR/dinosaurs/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Tricerátopo\",\"item\":\"https://dottodotfreeprintables.com/pt-BR/dinosaurs/triceratops-dot-to-dot-puzzle/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"Tricerátopo\",\"description\":\"O Triceratops tinha três chifres e uma ampla franja óssea. Conecte 70 pontos com esta folha gratuita de conecte os pontos para jardim de infância e primeira série.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"Caminho de Navegação","children":[["$","$Lf",null,{"href":"/pt-BR/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Lar"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/pt-BR/dinosaurs/","children":"Dinosaurs"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"Tricerátopo"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"/images/triceratops-puzzle-400.webp","srcSet":"/images/triceratops-puzzle-400.webp 400w, /images/triceratops-puzzle-600.webp 600w, /images/triceratops-puzzle-700.webp 700w, /images/triceratops-puzzle.webp 540w","sizes":"(max-width: 640px) 92vw, (max-width: 960px) 600px, 540px","alt":"Tricerátops de três chifres e sua babadeira óssea formados por 70 pontos para imprimir","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Triceratops Conecte os Pontos: 70 Pontos de Três Chifres Grátis"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Siga os pontos para desenhar o dinossauro com chifres mais icônico de todos os tempos. O Triceratops tinha três chifres faciais e uma enorme franja óssea — e viveu ao lado do T-Rex! Esta folha de conecte os pontos é perfeita para jardim de infância e 1ª série."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Dificuldade 1 de 3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Os chifres do Triceratops podiam crescer até 90 cm de comprimento — mais longo que um bastão de beisebol!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],"$L10","$L11",["$","$L12",null,{"title":"Tricerátopo Conecte os Pontos Imprimível - PDF Grátis","imageUrl":"/images/triceratops-puzzle.webp","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/pt-BR/dinosaurs/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":"Dinosaurs"}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Tricerátopo"," ",""]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Com três chifres, uma magnífica gola óssea e a coragem de enfrentar um T-Rex, o Triceratops é um dos dinossauros mais reconhecíveis que já existiram. Este quebra-cabeça tem 70 pontos — um verdadeiro desafio que recompensa a paciência e a contagem cuidadosa. Resolva-o seção por seção e um dinossauro verdadeiramente espetacular surgirá. Preparado? Vamos lá!"}}],[["$","div","1–12",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–12"," — ","Os Três Chifres e o Focinho"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Comece no ponto 1 e siga até o ponto 12 para desenhar a característica mais famosa do Triceratops: os dois longos chifres acima da cabeça e o chifre nasal mais curto. Esta seção envolve diversas mudanças de direção, o que é ótimo para desenvolver o controle do lápis e a percepção espacial em crianças a partir de 6 anos."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Os dois chifres acima da cabeça podiam crescer até um metro de comprimento — mais compridos que um taco de beisebol! Os cientistas acreditam que o Triceratops os usava tanto para defesa contra predadores quanto para lutar com outros Triceratops durante a competição por território e parceiros."]}]]}]]}],["$","div","13–26",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["13–26"," — ","A Babado"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Ligue os pontos 13 a 26 para desenhar a grande franja semicircular que emoldura a parte de trás da cabeça. As crianças praticam um movimento amplo e arqueado aqui — um ótimo exercício para manter o lápis deslizando com firmeza pela página. Incentive-as a levantar o pulso e desenhar a partir do ombro."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"A gola não era de osso sólido — tinha duas grandes aberturas cobertas de pele, o que a tornava mais leve do que aparentava. Alguns cientistas acreditam que, quando viva, a gola era colorida e servia para comunicar humor e estado de saúde, algo como um painel de exibição vivo."]}]]}]]}],["$","div","27–42",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["27–42"," — ","O Corpo"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Trace os pontos de 27 a 42 para o corpo largo e robusto. O Triceratops tinha um corpo baixo e largo, e as crianças começam a perceber como sua forma difere da dos saurópodes mais altos. Esta é a sequência mais longa de pontos do quebra-cabeça — uma excelente oportunidade para praticar a concentração prolongada."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"O Triceratops tinha cerca de 9 metros de comprimento e pesava até 12 toneladas — aproximadamente o mesmo que dois elefantes africanos! Apesar do tamanho, era ágil o suficiente para se mover em alta velocidade. Imagine ver um daqueles magníficos chifres vindo em sua direção — uma visão impressionante, mesmo para um T-Rex!"]}]]}]]}],["$","div","43–58",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["43–58"," — ","As Quatro Pernas"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Ligue os pontos 43 a 58 para adicionar as quatro pernas poderosas e ligeiramente abertas. Ao contrário das pernas retas e semelhantes a pilares dos saurópodes, as pernas do Triceratops se abrem um pouco nos cotovelos. As crianças percebem essa diferença se você a apontar — desenvolvendo ótimas habilidades de observação juntamente com a prática da coordenação motora fina."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"O Triceratops tinha cascos em vez de garras — um fato surpreendente que muitas vezes encanta as crianças! As patas dianteiras podiam girar para fora, permitindo que ele abaixasse a cabeça e avançasse como um trator, usando seus três magníficos chifres para abrir caminho."]}]]}]]}],["$","div","59–70",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["59–70"," — ","A cauda"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Complete o quebra-cabeça ligando os pontos 59 a 70 para desenhar a cauda curta e grossa. Comparada às caudas longas dos saurópodes herbívoros, a cauda do Triceratops é larga e robusta. As crianças praticam uma finalização mais curta e controlada — um final gratificante para um desafio maior."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Evidências fósseis mostram que o T-Rex e o Triceratops viveram na mesma época e lugar — no oeste dos Estados Unidos, há cerca de 68 milhões de anos. Os cientistas acreditam que o Triceratops usava seus três impressionantes chifres para se defender, e há evidências de que os dois se encontraram mais de uma vez. Era uma vizinhança bem movimentada!"]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","trex-61-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/pt-BR/dinosaurs/trex-61-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"/images/trex-61-puzzle-400.webp","srcSet":"/images/trex-61-puzzle-400.webp 400w, /images/trex-61-puzzle-600.webp 600w, /images/trex-61-puzzle-700.webp 700w, /images/trex-61-puzzle.webp 420w","sizes":"(max-width: 760px) 92vw, 30vw","alt":"Poderoso Tiranossauro Rex surgindo de 61 pontos numerados, atividade grátis de dinossauro","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","children":[["$","p",null,{"className":"puzzle-category","children":"Dinosaurs"}],["$","h3",null,{"children":"Desafio T-Rex de 61 pontos"}],["$","div",null,{"className":"puzzle-meta","children":[["$","span",null,{"children":""}],["$","span",null,{"children":"1–0 pontos"}]]}],["$","$Lf",null,{"href":"/pt-BR/dinosaurs/trex-61-dot-to-dot-puzzle/","className":"download-link","children