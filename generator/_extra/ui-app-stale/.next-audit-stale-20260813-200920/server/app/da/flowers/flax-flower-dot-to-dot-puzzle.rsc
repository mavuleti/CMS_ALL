nter."]}],["$","li","Lyse Øjne Hvid Hør-55–72-Første blade",{"children":[["$","strong",null,{"children":["55–72"," (Første blade)",":"]}]," ",["$","span",null,{"aria-hidden":"true","style":{"display":"inline-block","width":34,"height":14,"borderRadius":7,"background":"#1CAC78","border":"1px solid rgba(0,0,0,0.18)","verticalAlign":"middle","marginInlineEnd":6}}],"Krayola Grin"," — Friske grønne blade kontrasterer pænt med de ensfarvede hvide kronblade."]}],["$","li","Lyse Øjne Hvid Hør-73–90-Blade og finish",{"children":[["$","strong",null,{"children":["73–90"," (Blade og finish)",":"]}]," ",["$","span",null,{"aria-hidden":"true","style":{"display":"inline-block","width":34,"height":14,"borderRadius":7,"background":"#1CAC78","border":"1px solid rgba(0,0,0,0.18)","verticalAlign":"middle","marginInlineEnd":6}}],"Krayola Grin"," — Matchende bladfarve afslutter planten pænt."]}]]}]]}],["$","article","Laks Bright Eyes Hør",{"style":{"marginBottom":28,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--pink-light, #f6a5c0)"},"children":[["$","h3",null,{"style":{"fontSize":"1.05rem","fontWeight":800,"marginBottom":6},"children":"Laks Bright Eyes Hør"}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":10},"children":"'Laks Bright Eyes'-varianten er en ægte langblomstrende hør med bløde laks pink kronblade omkring et mørkt orange-rødt centrum."}],["$","ul",null,{"style":{"lineHeight":1.8,"paddingInlineStart":20,"margin":0},"children":[["$","li","Laks Bright Eyes Hør-1–18-Blomstens centrum",{"children":[["$","strong",null,{"children":["1–18"," (Blomstens centrum)",":"]}]," ",["$","span",null,{"aria-hidden":"true","style":{"display":"inline-block","width":34,"height":14,"borderRadius":7,"background":"#FF5349","border":"1px solid rgba(0,0,0,0.18)","verticalAlign":"middle","marginInlineEnd":6}}],"Krayola Ræd Oranj"," — Denne dristige centrumfarve matcher det mørk orange-røde øje af den ægte laks hørvariant."]}],["$","li","Laks Bright Eyes Hø