2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Hem\",\"item\":\"https://dottodotfreeprintables.com/sv/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Dinosaurs\",\"item\":\"https://dottodotfreeprintables.com/sv/dinosaurs/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Struts\",\"item\":\"https://dottodotfreeprintables.com/sv/dinosaurs/ostriches-dinosaur-dot-to-dot-puzzle/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"Struts\",\"description\":\"Strutsar kan springa upp till 45 mph. Avslöja en över 55 punkter på våra gratis punkt till punkt sidor för barn i åldrarna 5–8, med en utskrivbar PDF redo att använda.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"Brödsmulor","children":[["$","$Lf",null,{"href":"/sv/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Hem"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/sv/dinosaurs/","children":"Dinosaurs"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"Struts"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"/images/ostriches-puzzle-400.webp","srcSet":"/images/ostriches-puzzle-400.webp 400w, /images/ostriches-puzzle-600.webp 600w, /images/ostriches-puzzle-700.webp 700w, /images/ostriches-puzzle.webp 540w","sizes":"(max-width: 640px) 92vw, (max-width: 960px) 600px, 540px","alt":"Springande struts, halsen sträckt, fångad i 55 utskrivbara punkter","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Struts Punkt till Punkt: 55 Punkter för den Snabbaste Fågeln"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Koppla ihop 55 enkla prickar för att avslöja den magnifika strutsen – den största levande fågeln på jorden! Strutsar kan inte flyga men de springer snabbare än en häst. Detta utskrivbara arbetsblad hjälper tidiga barn i grundskolan att öva på talföljd och pennkontroll samtidigt som de lär sig om detta fantastiska djur."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Svårighetsgrad 1 av 3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Strutsar är de snabbaste springande fåglarna på jorden och når hastigheter på upp till 72 km/h!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],"$L10","$L11",["$","$L12",null,{"title":"Struts Prick-och-drag Utskrivbar - Gratis PDF","imageUrl":"/images/ostriches-puzzle.webp","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/sv/dinosaurs/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":"Dinosaurs"}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Struts"," ",""]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Visste du att strutsar är de största fåglarna som lever idag – och de är faktiskt levande släktingar till dinosaurierna? Allt med en struts är byggt för fart och överlevnad på de öppna afrikanska slätterna. Denna prick-till-prick-övning är ett underbart sätt att utforska en av naturens mest extraordinära varelser. Vässa en penna, hitta punkt 1, och låt oss väcka denna magnifika fågel till liv!"}}],[["$","div","1–8",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–8"," — ","Huvudet och näbben"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Börja vid punkt 1 och anslut till punkt 8 för att skissa strutsens lilla, rundade huvud och platta näbb. Huvudet är förvånansvärt litet jämfört med fågelns kropp – barn märker detta naturligt, vilket öppnar upp för en bra konversation om djurens proportioner. Korta, mjuka penseldrag fungerar bäst här."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"En struts öga är större än dess hjärna – med sina ungefär fem centimeter i diameter är det det största ögat av alla landdjur på jorden. De enorma ögonen hjälper den att upptäcka rovdjur som lejon och geparder på mycket långt håll över den platta savannen."]}]]}]]}],["$","div","9–20",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["9–20"," — ","Den långa halsen"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Fortsätt från punkt 9 till punkt 20 för att rita den långa, graciösa halsen som sveper ner från huvudet till kroppen. Detta är en av de mest tillfredsställande delarna av pusslet – barn lär sig att hålla sin penna i rörelse i en flytande riktning utan att lyfta den. En härlig lektion i smidig linjekontroll."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"En struts hals kan bli upp till en meter lång och är nästan helt fjäderlös. Den bara huden ändrar färg när strutsen är upphetsad eller försöker locka till sig en partner – den blir ljusrosa eller röd. Naturens egen humörring!"]}]]}]]}],["$","div","21–35",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["21–35"," — ","Kroppen och vingarna"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Rita punkterna 21 till 35 för att fylla i strutsens runda, fluffiga kropp och dess små, dekorativa vingar. Även om strutsar inte kan flyga spelar deras vingar fortfarande en viktig roll. Barn övar på att rita rundare, mer ovala former här – en annan utmaning än halsens raka linjer."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Strutsar använder sina vingar som ett roder när de springer, och de lutar åt vänster eller höger för att hjälpa dem att ändra riktning i snabb takt. De sprider dem också brett för att skugga sina ungar från den flammande afrikanska solen – inbyggda parasoller!"]}]]}]]}],["$","div","36–46",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["36–46"," — ","De kraftfulla benen"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Koppla ihop punkterna 36 och 46 för att rita de två långa, muskulösa benen. Dessa är de snabbaste benen av alla fåglar på planeten, och barn börjar uppskatta hur långa de är i förhållande till kroppen. Uppmuntra till stadiga, säkra nedåtgående rörelser – den här delen belönar en djärv hand."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"En struts kan spurta i upp till 72 kilometer i timmen och fortsätta springa i 48 km/h över längre sträckor. Ett enda steg kan täcka upp till 5 meter – ungefär lika långt som en familjebil. Att försöka springa ifrån en struts vore en mycket dålig idé!"]}]]}]]}],["$","div","47–55",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["47–55"," — ","Fötterna och stjärtfjädrarna"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Avsluta med att koppla ihop punkterna 47 till 55 för att lägga till de distinkta tvåtåiga fötterna och de böljande stjärtfjädrarna. Strutsar är de enda fåglarna med bara två tår på varje fot. Barn övar på mindre, mer detaljerade arbeten här – en bra övning i precision när pusslet närmar sig slutfört."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Varje strutsfot har en stor dominant tå med en lång, seg klo som fungerar som en hov – perfekt för att springa på hård mark! Strutsar är förvånansvärt modiga och står stånd för att skydda sina ungar. En mycket djärv fågel verkligen!"]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","trex-61-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/sv/dinosaurs/trex-61-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"/images/trex-61-puzzle-400.webp","srcSet":"/images/trex-61-puzzle-400.webp 400w, /images/trex-61-puzzle-600.webp 600w, /images/trex-61-puzzle-700.webp 700w, /images/trex-61-puzzle.webp 420w","sizes":"(max-width: 760px) 92vw, 30vw","alt":"Mighty Tyrannosaurus Rex som trampar ut från 61 numrerade punkter, gratis dinosaurieark","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","children":[["$","p",null,{"className":"puzzle-category","children":"Dinosaurs"}],["$","h3",null,{"children":"T-Rex 61-punktsutmaning"}],["$","div",null,{"className":"puzzle-meta","children":[["$","span",null,{"children":""}],["$","span",null,{"children":"1–0 prickar"}]]}],["$","$Lf",null,{"href":"/sv/dinosaurs/trex-61-dot-to-dot-puzzle/","className":"download-link","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":15,"height":15,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true","children":[["$","path","r04s7s",{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.