e:["$","$L15",null,{"formats":"$undefined","locale":"no","messages":{"nav":{"scanMe":"Skann meg","blog":"Blogg","search":"Søk","kids":"Barn - Puslespill","teachers":"Lærere","parents":"Foreldre","contact":"Kontakt oss","freePack":"Gratis pakke"},"homepageUi":{"title":"Finn de perfekte prikk-til-prikk-utskriftene","description":"Skriv ut, koble prikkene, og gjør fantastiske bilder levende. Gratis og klart for moro!","searchPlaceholder":"Prøv hav, dinosaur eller blomster","filterPuzzles":"Filtrer puslespill","age":"Alder","dots":"prikker","featuredPuzzles":"Utvalgte utskrivbare puslespill","savePuzzle":"Lagre {name}","removeSavedPuzzle":"Fjern {name} fra lagrede","downloads":"nedlastinger","bookTitle":"Det beste fra 2026 · {count}","bookDescription":"Våre favoritt prikk-til-prikk-oppgaver i én utskrivbar PDF-bok.","searchUnavailable":"Søk er midlertidig utilgjengelig. Prøv igjen.","popularEyebrow":"Populært denne uken","mostDownloaded":"Mest nedlastede puslespill","downloadCountAria":"{count} eller flere nedlastinger","freshPrintables":"Friske utskrifter","recentlyAdded":"Nylig lagt til","browseCategories":"Bla gjennom puslespillkategorier","openCategories":"Åpne kategorimeny","closeCategories":"Lukk kategorimeny","browseByTheme":"Bla gjennom etter tema","quickLinks":"Hurtiglenker","bundlePacks":"Pakker med flere","parentsTeachers":"For foreldre og lærere","more":"Flere kategorier","kids":"Barn","categoryNames":{"cute":"Søte puslespill","flowers":"Blomster"}},"audience":{"kidsTitle":"For barn","kidsText":"Vennlige dyre-, dinosaur- og kjøretøytemaer med tydelige nummererte prikker. Enkle gevinster som bygger ekte selvtillit.","parentsTitle":"For foreldre","parentsText":"Skjermfrie aktiviteter for stille stunder hjemme, på reise og på restauranter. Skriv ut fra hvilken som helst enhet på under ett minutt.","teachersTitle":"For lærere","teachersText":"Lavforberedende koblinger til morgenarbeid, tidlige ferdige elever, vikarer og klasseromsstasjoner – ingen forberedelse n