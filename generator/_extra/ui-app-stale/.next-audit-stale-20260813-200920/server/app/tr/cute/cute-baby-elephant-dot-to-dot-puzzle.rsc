e:["$","$L15",null,{"formats":"$undefined","locale":"tr","messages":{"nav":{"scanMe":"Beni tarayın","blog":"Blog","search":"Aramak","kids":"Çocuklar - Bulmacalar","teachers":"Öğretmenler","parents":"Ebeveynler","contact":"Bize Ulaşın","freePack":"Ücretsiz paket"},"homepageUi":{"title":"Mükemmel noktadan noktaya yazdırılabilirleri bulun","description":"Yazdırın, noktaları birleştirin ve harika resimlere hayat verin. Ücretsiz ve eğlenceye hazır!","searchPlaceholder":"Okyanus, dinozor veya çiçek deneyin","filterPuzzles":"Bulmacaları filtrele","age":"Yaş","dots":"nokta","featuredPuzzles":"Öne çıkan yazdırılabilir bulmacalar","savePuzzle":"{name} kaydet","removeSavedPuzzle":"{name} öğesini kayıtlılardan kaldır","downloads":"indirme","bookTitle":"2026'nın en iyileri · {count}","bookDescription":"En sevdiğimiz noktadan noktaya bulmacalar tek bir yazdırılabilir PDF kitapta.","searchUnavailable":"Arama geçici olarak kullanılamıyor. Lütfen tekrar deneyin.","popularEyebrow":"Bu hafta popüler","mostDownloaded":"En çok indirilen bulmacalar","downloadCountAria":"{count} veya daha fazla indirme","freshPrintables":"Yeni yazdırılabilirler","recentlyAdded":"Son eklenenler","browseCategories":"Bulmaca kategorilerini gez","openCategories":"Kategoriler menüsünü aç","closeCategories":"Kategoriler menüsünü kapat","browseByTheme":"Temaya göre gez","quickLinks":"Hızlı bağlantılar","bundlePacks":"Paketler","parentsTeachers":"Ebeveynler ve Öğretmenler için","more":"Daha fazla kategori","kids":"Çocuklar","categoryNames":{"cute":"Şirin Bulmacalar","flowers":"Çiçekler"}},"audience":{"kidsTitle":"Çocuklar için","kidsText":"Sevimli hayvan, dinozor ve araç temalarıyla, numaralandırılmış net noktalar içeren bir oyun. Kolay kazanımlar gerçek özgüven oluşturur.","parentsTitle":"Ebeveynler için","parentsText":"Evde, seyahatte ve restoranlarda ekranlardan uzak, sakin zaman aktiviteleri. Herhangi bir cihazdan bir dakikadan kısa sürede çıktı alın.","teachersTitle":"Öğretmenler için","teachersText":"Sabah çalışmaları, erken bitirenler, yedek öğretmenler ve sınıf istasyonları için düşük hazırlık gerektiren noktaları birleştirme oyunu — hiçbir hazırlık gerektirmez."},"categories":{"eyebrow":"Tema ve beceri seviyesine göre düzenlenmiştir.","heading":"Noktadan noktaya birleştirme bulmacalarını kategoriye göre inceleyin.","description":"Küçük çocuklar için basit 10 noktalı şekillerden, daha büyük çocuklar için 200 noktalı meydan okumalara kadar — kategoriye göre sıralanmıştır, böylece doğru ücretsiz yazdırılabilir dosyayı saniyeler içinde bulabilirsiniz.","puzzles":"{count, plural, one {# bulmaca} other {# bulmaca}}","comingSoon":"Yakında gelecek","badges":{"dinosaurs":"Şimdi satışta!","ocean":"Şimdi satışta!","playgrounds":"Şimdi satışta!","garden":"Şimdi satışta!","usa250":"Yeni!","uae":"Şimdi satışta!","cute":"Yeni!","circus":"Yeni!"},"items":{"dinosaurs":{"name":"Dinozorlar","description":"Tarih öncesi eğlenceye dalın! T-Rex, Triceratops, Velociraptor ve çocuklarınızın bayılacağı {count} adet ücretsiz noktadan noktaya birleştirme bulmacası."},"animals":{"name":"Hayvanlar","description":"Sayı öğrenimine yeni başlayanlar için sevimli yaratıklar."},"vehicles":{"name":"Araçlar","description":"Otomobiller, kamyonlar, roketler ve makineler."},"fantasy":{"name":"Fantazi","description":"Kaleler, tek boynuzlu atlar, ejderhalar ve hikaye yazma ipuçları."},"seasonal":{"name":"Mevsimsel","description":"Tatil ve sınıf takvimi etkinlikleri."},"ocean":{"name":"Okyanus","description":"Deniz hayvanları ve sakinlik temalı boyama sayfaları."},"playgrounds":{"name":"Oyun alanları","description":"Küçük maceracılar için salıncaklar, kaydıraklar ve açık hava eğlenceleri."},"garden":{"name":"Bahçe","description":"Küçük bahçıvan yardımcıları için eldivenler, kürekler ve aletler."},"usa250":{"name":"Amerika'nın 250 Yılı","description":"Amerikan tarihini onurlandıran vatansever noktadan noktaya birleştirme bulmacalarıyla Amerika'nın 250. doğum gününü kutlayın."},"uae":{"name":"Birleşik Arap Emirlikleri","description":"Birleşik Arap Emirlikleri'ni keşfedin! Burj Al Arab gibi ikonik yerler, bağlantı kurmaya ve renklendirmeye hazır."},"space":{"name":"Uzay","description":"Gezegenler, astronotlar ve roket maceraları."},"worksheets":{"name":"Çalışma sayfaları","description":"Öğretmenler için hazır sayı sıralama çalışma sayfaları."},"bigDotBooks":{"name":"Büyük Nokta Kitapları","description":"Odaklanmış, daha büyük yaştaki öğrenciler için uzun bulmacalar."},"cute":{"name":"Sevimli","description":"Sevimli köpek yavruları, minik arabalar ve çocuklarınızın bayılacağı {count} güzel, ücretsiz noktadan noktaya birleştirme bulmacaları."},"circus":{"name":"Sirk","description":"Yüzük ustaları, büyük çadırlar ve genç öğreniciler için gösteri zamanı eğlencesi."}}},"puzzleSection":{"eyebrow":"Ücretsiz yazdırılabilir örnekler — kayıt olmaya gerek yok","heading":"Şimdi yazdırabileceğiniz popüler noktaları birleştirme sayfaları","weeklyPack":"Haftalık paketi inceleyin →","downloadLink":"Ücretsiz yazdırılabilir dosyayı indirin.","new":"Yeni","imageAlt":"{name} için ücretsiz noktadan noktaya birleştirme çalışma sayfası, {age} yaş grubu için.","categories":{"Dinosaurs":"Dinozorlar","Ocean":"Okyanus","Playgrounds":"Oyun alanları","Garden":"Bahçe","Cute":"Sevimli","USA 250 Years":"Amerika'nın 250 Yılı","UAE":"Birleşik Arap Emirlikleri"},"items":{"trex-61-dot-to-dot-puzzle":{"name":"T-Rex 61 Noktalı Meydan Okuma"},"brontosaurus-dot-to-dot-puzzle":{"name":"Brontosorüs"},"mermaid-dot-to-dot-puzzle":{"name":"Denizkızı"},"merman-dot-to-dot-puzzle":{"name":"Deniz adamı"},"seahorse-dot-to-dot-puzzle":{"name":"Denizatı"},"whale-dot-to-dot-puzzle":{"name":"Balina"},"swing-playgrounds-dot-to-dot-puzzle":{"name":"Salıncaklı Oyun Alanı"},"slide-playgrounds-dot-to-dot-puzzle":{"name":"Kaydıraklı Oyun Alanı"},"seesaw-playground-dot-to-dot-puzzle":{"name":"Tahterevalli Oyun Alanı"},"roller-coaster-playground-dot-to-dot-puzzle":{"name":"Lunapark Treni Oyun Alanı"},"wheelbarrow-playground-dot-to-dot-puzzle":{"name":"El arabası oyun alanı"},"garden-gloves-dot-to-dot-puzzle":{"name":"Bahçe Eldivenleri"},"garden-trowel-dot-to-dot-puzzle":{"name":"Bahçe Küreği"},"gas-balloon-usa-250-dot-to-dot-puzzle":{"name":"Gaz Balonu Amerika 250"},"america-250-birthday-fireworks-dot-to-dot-puzzle":{"name":"Amerika'nın 250. Doğum Günü Havai Fişekleri"},"america-250-anniversary-liberty-bell-wings-1776-dot-to-dot-puzzle":{"name":"Amerika 250 Özgürlük Çanı Kanatları"},"usa-250-astronaut-dot-to-dot-puzzle":{"name":"Amerika'nın 250. Astronotu"},"usa-250-anniversary-sports-kids-podium-dot-to-dot-puzzle":{"name":"Amerika'nın 250. Yıldönümü Spor Çocuk Podyumu"},"usa-250-anniversary-airplane-banner-dot-to-dot-puzzle":{"name":"Amerika'nın 250. Yıldönümü Uçak Afişi"},"usa-250-space-shuttle-dot-to-dot-puzzle":{"name":"Amerika 250 Uzay Mekiği"},"usa-250-birthday-balloons-stars-dot-to-dot-puzzle":{"name":"Amerika'nın 250. Doğum Günü Balonları ve Yıldızları"},"usa-250-birthday-cake-dot-to-dot-puzzle":{"name":"Amerika'nın 250. Doğum Günü Pastası"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"Amerika 250 Kartal Sancağı"},"burj-al-arab-dot-to-dot-puzzle":{"name":"Burc El Arap"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"Dallah Kahve Potu"}}},"benefits":{"eyebrow":"Erken çocukluk eğitimcileri tarafından desteklenmektedir.","heading":"Noktaları birleştirme çalışma sayfaları çocuk gelişimi için neden harika?","description":"Noktaları birleştirme etkinlikleri sadece eğlenceli olmakla kalmıyor, aynı zamanda okul öncesi ve anaokulu öğretmenleri tarafından temel erken öğrenme becerilerini geliştirmek için kullanılan, araştırmalarla desteklenen bir araçtır.","fineMotorTitle":"İnce motor becerilerini geliştirir.","fineMotorText":"Noktaları birleştirerek çizgi çizmek, çocukların kalem tutuşunu, el-göz koordinasyonunu ve el yazısı için ihtiyaç duydukları kas kontrolünü geliştirir.","numberTitle":"Sayı tanıma becerisini güçlendirir.","numberText":"1 → 2 → 3 noktalarını sırayla takip etmek, oyun yoluyla doğal bir şekilde sayma düzenini, sayı tanımayı ve temel matematik kavramlarını öğretir.","focusTitle":"Odaklanmayı ve konsantrasyonu artırır.","focusText":"Noktaları birleştirme bulmacasını tamamlamak sürekli dikkat gerektirir; bu da okul öncesi dönemden 3. sınıfa kadar olan çocuklar için odaklanmayı geliştirmek için sakin ve ekran dışı bir yoldur.","confidenceTitle":"Anında ödül ve özgüven","confidenceText":"Gizli resim ortaya çıktığında, çocuklar anında bir başarı duygusu hissederler. Bu küçük zafer, öğrenme sevgisini ve gelişim odaklı bir zihniyeti besler."},"howTo":{"eyebrow":"60 saniyeden kısa sürede hazır","heading":"Ücretsiz noktaları birleştirme çalışma sayfalarını nasıl indirip yazdırabilirsiniz?","step1Title":"Bulmacanızı seçin","step1Text":"Çocuğunuzun yaşına ve beceri seviyesine uygun bir tema (hayvanlar, dinozorlar, araçlar, tatil) ve nokta aralığı seçin.","step2Title":"Ücretsiz PDF dosyasını indirin.","step2Text":"\"Ücretsiz yazdırılabilir dosyayı indir\"e tıklayın — hesap gerekmez, e-posta gerekmez, ödeme duvarı yoktur. Tarayıcınız PDF dosyasını anında indirir.","step3Title":"Yazdırın ve keyfini çıkarın","step3Text":"Standart ABD Letter (8,5\" × 11\") boyutunda kağıda yazdırın. Siyah beyaz baskı mükemmel sonuç verir. Çocuğunuza verin ve noktaları birleştirmesini izleyin!"},"trust":{"eyebrow":"Veliler ve öğretmenler neden bizi tercih ediyor?","heading":"Ücretsiz, güvenli ve kullanımı son derece kolay.","noAccountTitle":"Hesap gerekmiyor.","noAccountText":"Noktaları birleştirme şablonunun her biri anında indirilir; kayıt olmaya, e-postaya veya ücretli içeriğe gerek yok. Sadece tıklayın ve yazdırın.","safeTitle":"Sınıf güvenli","safeText":"Okul yazıcıları için tasarlanmış, temiz ve reklamsız bulmaca sayfaları. Sabah çalışmaları, ödevler veya sakin zamanlar için uygundur.","fastTitle":"Tasarım gereği hızlı","fastText":"Statik sayfalar, optimize edilmiş görseller ve yerel yazı tipleri sayesinde bulmacalar telefon, tablet veya dizüstü bilgisayar fark etmeksizin her cihazda hızlı yüklenir."},"faq":{"eyebrow":"Sıkça sorulan sorular","heading":"Sıkça sorulan sorular","q1":"Bu sitedeki tüm noktaları birleştirme şablonları tamamen ücretsiz mi?","a1":"Evet — DotToDotFreePrintables.com'daki tüm noktaları birleştirme çalışma sayfaları %100 ücretsiz olarak indirilebilir ve yazdırılabilir. Hiçbir hesap, abonelik veya kredi kartı gerekmez.","q2":"Noktaları birleştirme çalışma sayfaları hangi yaş grubu için uygundur?","a2":"Yazdırılabilir materyallerimiz 2-12 yaş aralığını kapsar. Kolay çalışma sayfaları (10-20 nokta) küçük çocuklar ve okul öncesi çocuklar için uygundur, orta zorluktaki sayfalar (20-50 nokta) anaokulu ve 1. sınıf için idealdir ve daha zor sayfalar (50-200+ nokta) 2. sınıftan 6. sınıfa kadar olan öğrencileri zorlar.","q3":"Noktaları birleştirme etkinliği şablonları hangi formatta?","a3":"Tüm çalışma sayfaları, standart ABD Letter (8,5\" × 11\") kağıt boyutuna uygun, yazdırmaya hazır PDF dosyaları olarak indirilir. Herhangi bir tarayıcıda veya PDF görüntüleyicide açın ve yazdırın; özel bir yazılıma gerek yok.","q4":"Okul öncesi ve anaokulu için noktaları birleştirme çalışma sayfalarınız var mı?","a4":"Kesinlikle. En kolay çalışma sayfalarımız 1-10 noktadan başlar (2-4 yaş arası için mükemmel) ve okul öncesi ve anaokulu sınıfları için tasarlanmış alfabe ve sayı tanıma temalarını içerir.","q5":"Öğretmenler bu noktaları birleştirme çalışma sayfalarını sınıfta kullanabilir mi?","a5":"Evet! Yazdırılabilir materyallerimiz kişisel ve sınıf kullanımı için ücretsizdir. Sabah etkinlikleri, erken bitiren öğrenciler için aktiviteler, yedek ders planları, ince motor beceri merkezleri ve ödev paketleri için oldukça popülerdirler.","q6":"Noktaları birleştirme bulmacaları ince motor becerilerinin gelişimine yardımcı olur mu?","a6":"Evet, noktalar arasında çizgi çizmek, el yazısı hazırlığını destekleyen kalem kavrama gücünü ve el-göz koordinasyonunu geliştirir. Bu nedenle birçok ergoterapist ve anaokulu öğretmeni noktaları birleştirme etkinliklerini önermektedir.","q7":"Hayvanlar veya dinozorlar gibi temalı noktadan noktaya birleştirme oyun şablonlarınız var mı?","a7":"Hayvanlar, dinozorlar, araçlar, okyanus canlıları, oyun alanları, Amerika'nın 250. Yılı, uzay, fantezi, mevsimsel/tatil temaları, öğretmen çalışma sayfası paketleri ve büyük noktalı kitaplar dahil olmak üzere 11 kategorimiz var. Her hafta yeni tasarımlar ekleniyor.","q8":"Bu yapbozları siyah beyaz olarak yazdırabilir miyim?","a8":"Evet, noktaları birleştirme alıştırma sayfalarımızın tamamı mürekkep tasarrufu sağlamak için siyah beyaz baskı için tasarlanmıştır. Herhangi bir ev veya sınıf yazıcısında harika görünürler."},"newsletter":{"eyebrow":"Yazdırılabilir başlangıç ​​paketi — tamamen ücretsiz","heading":"20 adet ücretsiz noktadan noktaya birleştirme şablonu e-posta kutunuza gelsin.","description":"Hayvanlar, araçlar, dinozorlar ve mevsimsel temaları kapsayan, ebeveynler ve öğretmenler için uygun bir koleksiyon; tümü standart ABD Letter kağıdına göre boyutlandırılmış ve siyah beyaz baskı için optimize edilmiştir."},"blog":{"eyebrow":"Yetişkinler için fikirler","heading":"Evde ve sınıfta uygulanabilecek öğrenme ipuçları","viewAll":"Tüm makaleleri görüntüle","read":"Okumak"},"feedback":{"eyebrow":"Sizden haber almaktan mutluluk duyarız.","heading":"Geri bildirim gönder","description":"Bir bulmaca fikriniz mi var, bozuk bir bağlantı mı fark ettiniz veya sadece merhaba mı demek istiyorsunuz? Aşağıya bir not bırakın."},"footer":{"description":"Çocuklar, ebeveynler ve öğretmenler için ücretsiz noktaları birleştirme ve noktaları birleştirme alıştırma sayfaları. Tüm bulmacalar ücretsiz olarak indirilebilir, yazdırılabilir ve paylaşılabilir.","kids":"Çocuklar","parents":"Ebeveynler","teachers":"Öğretmenler","blog":"Blog","faq":"SSS","feedback":"Geri bildirim","about":"Hakkında","contact":"Temas etmek","privacy":"Mahremiyet","terms":"Şartlar","sitemap":"Site Haritası","copyright":"© {year} DotToDotFreePrintables.com · Çocuklar için ücretsiz yazdırılabilir etkinlikler"},"common":{"home":"Ev","new":"Yeni","comingSoon":"Yakında gelecek","downloadFree":"Ücretsiz yazdırılabilir dosyayı indirin.","viewDownload":"Görüntüle ve İndir","shareTitle":"{name} Bağlantı Noktası Yazdırılabilir - Ücretsiz PDF","downloadAria":"Ücretsiz {name} bağlantı noktası yazdırılabilir PDF indirin","bookmarkTitle":"{name} Bağlantı Noktası Yazdırılabilir – Çocuklar için Ücretsiz PDF","showSlide":"Slaytı göster {number}","ageRange":"Yaşlar {min}-{max}","difficultyLabel":"Zorluk seviyesi {level} (3 üzerinden)","difficulty":{"1":"Kolay","2":"Orta","3":"Zor"},"dots":"1–{count} nokta","homeVideoEyebrow":"Video","homeVideoH2":"Noktaları birleştirme oyununun eğlencesini izleyin.","skipToContent":"Ana içeriğe atla","joinTeachers":"{count}+ öğretmene katıl","breadcrumbAria":"İz"},"puzzleSearch":{"placeholder":"Search by name or topic... e.g. ocean, whale, T-Rex","searchAria":"Arama bulmacaları","clearSearch":"Clear search","toggleFilters":"Toggle filters","filters":"Filters","filterOptions":"Filter options","topic":"Topic","numberOfDots":"Number of dots","recentlyAddedOnly":"Recently added only","clearAllFilters":"Clear all filters","clearFilters":"Clear filters","resultsFound":"{count, plural, one {# bulmaca bulundu} other {# bulmaca bulundu}}","puzzlesAvailable":"{count, plural, one {# puzzle available} other {# puzzles available}}","noMatches":"Arama kriterlerinize uygun bulmaca bulunamadı.","openPuzzle":"Open {name}","imageAlt":"{name} noktadan noktaya birleştirme yazdırılabilir","viewPuzzle":"View puzzle →","dotRanges":{"under35":"Under 35 dots","35to50":"35-50 dots","51to70":"51-70 dots","over70":"70+ dots"},"categories":{"Dinosaurs":"Dinosaurs","Ocean":"Ocean","Playgrounds":"Playgrounds","Garden":"Garden","Cute":"Cute","USA 250 Years":"America 250 Years","UAE":"UAE"}},"newsletterForm":{"ariaLabel":"Ücretsiz noktadan noktaya birleştirme şablonu paketini edinin.","emailLabel":"E-posta adresi","submit":"Ücre