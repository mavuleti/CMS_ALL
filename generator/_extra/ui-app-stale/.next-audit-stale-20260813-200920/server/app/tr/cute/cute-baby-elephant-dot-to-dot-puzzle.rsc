fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Zorluk seviyesi 1 (3 üzerinden)","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Fil yavruları bazen tıpkı insan bebeklerinin başparmağını emmesi gibi rahatlamak için hortumlarını emerler; bu onların sakinleşmesine ve güvende hissetmelerine yardımcı olur."]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],"$L10","$L11",["$","$L12",null,{"title":"Sevimli Bebek Fil Bağlantı Noktası Yazdırılabilir - Ücretsiz PDF","imageUrl":"/images/cute-baby-elephant-puzzle.webp","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/tr/cute/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":"Cute"}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Sevimli Bebek Fil"," ",""]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"İşte karşınızda nazik bir dev! Büyük, sarkık kulakları, kıvrık hortumu ve yuvarlak, sevimli yüzüyle bir fil yavrusu, bir çocuğun çizebileceği en iç ısıtan hayvanlardan biridir. Bu 50 noktalı yapboz, fili parça parça oluşturuyor, bu yüzden bir kalem alın, rahat bir yer bulun ve bu küçük dostun sayfaya adım atmasına izin verin!"}}],[["$","div","1–13",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–13"," — ","Büyük Sallanan Kulaklar"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"1. noktadan başlayıp 13. noktaya kadar ilerleyerek filin büyük, sallanan kulaklarını çizin. Kulaklar, geniş ve yumuşak kıvrımları sayesinde yavaş ve dikkatli bir çizim için harika bir başlangıç ​​bölümüdür; çocukları her çizgiyi çizmeden önce bir sonraki noktaya bakmaya teşvik edin."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Fillerin devasa kulakları sadece duyma amaçlı değil, aynı zamanda dahili vantilatörler gibi de işlev görüyor. Filler kulaklarını çırparak içlerinden geçen kanı soğutuyor ve bu da tüm vücutlarının aşırı ısınmasını önlemeye yardımcı oluyor."]}]]}]]}],["$","div","14–26",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["14–26"," — ","Yüz ve Kıvrık Gövde"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"14. noktadan 26. noktaya kadar devam ederek filin yuvarlak yüzünü ve uzun, kıvrımlı hortumunu şekillendirin. Bu, bulmacanın en detaylı kısmı olduğundan, sabır gerektiren harika bir alıştırmadır; çocuklara hortumun kıvrıldığı kısımlarda acele etmemelerini hatırlatın."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Fil hortumunun içinde hiç kemik yoktur; neredeyse tamamen kaslardan oluşur, 40.000'den fazla kas hücresi vardır! Bu yüzden bir hortum, bir kütüğü kaldıracak kadar güçlü, aynı zamanda tek bir fıstığı alacak kadar da yumuşak olabilir."]}]]}]]}],["$","div","27–38",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["27–38"," — ","Vücut"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Filin yuvarlak ve sağlam gövdesini çizmek için 27 ile 38 arasındaki noktaları takip edin. Buradaki çizgiler yüz bölümündekilere göre daha uzun ve daha yumuşak; bu da çocukların kendinden emin, akıcı çizgiler çizmeyi öğrenmelerine yardımcı olan güzel bir ritim değişikliği."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Filler, yeryüzündeki en büyük kara hayvanlarıdır, ancak yavru filler doğduklarında bile yetişkin bir insan kadar ağırlığa ulaşabilirler; yaklaşık 100 kilogram (220 pound)!"]}]]}]]}],["$","div","39–50",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["39–50"," — ","Bacaklar ve Küçük Kuyruk"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Sağlam bacakları ve küçük sallanan kuyruğu eklemek için 39 ile 50 arasındaki noktaları birleştirerek işlemi tamamlayın. Sadece on iki nokta kaldı — burada yapılacak pürüzsüz ve kendinden emin bir bitiş, filin tamamını canlandıracak. Bitirdiğinizde mutlu bir gülümseme eklemeyi unutmayın!"}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Devasa boyutlarına rağmen filler aslında parmak uçlarında yürürler! Her topuğun altındaki yağ yastığı, ağırlıklarını desteklemeye yardımcı olur ve çimenlerin arasında neredeyse sessizce hareket etmelerini sağlar."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Cute"}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","cute-puppy-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/tr/cute/cute-puppy-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"/images/cute-puppy-puzzle-400.webp","srcSet":"/images/cute-puppy-puzzle-400.webp 400w, /images/cute-puppy-puzzle-600.webp 600w, /images/cute-puppy-puzzle-700.webp 700w, /images/cute-puppy-puzzle.webp 420w","sizes":"(max-width: 760px) 92vw, 30vw","alt":"Sarkık kulaklı sevimli yavru köpek, kuyruğunu sallayarak 70 yazdırılabilir noktadan beliriyor","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","