2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://dottodotfreeprintables.com/en/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Dinosaurs\",\"item\":\"https://dottodotfreeprintables.com/en/dinosaurs/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Spinosaurus\",\"item\":\"https://dottodotfreeprintables.com/en/dinosaurs/spinosaurus/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"Spinosaurus\",\"description\":\"Spinosaurus was longer than T-Rex and had a giant sail. Reveal it across 74 dots in this free dot to dot printable PDF for grades 1–2.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"Breadcrumb","children":[["$","$Lf",null,{"href":"/en/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Home"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/en/dinosaurs/","children":"Dinosaurs"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"Spinosaurus"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"/images/spinosaurus-74-puzzle-400.webp","srcSet":"/images/spinosaurus-74-puzzle-400.webp 400w, /images/spinosaurus-74-puzzle-600.webp 600w, /images/spinosaurus-74-puzzle-700.webp 700w, /images/spinosaurus-74-puzzle.webp 540w","sizes":"(max-width: 640px) 92vw, (max-width: 960px) 600px, 540px","alt":"Sail-backed Spinosaurus surfacing through 74 dots on a free dinosaur printable","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Spinosaurus Dot to Dot — 74 Dots, Bigger Than T-Rex"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Connect the dots to reveal the largest carnivorous dinosaur ever discovered — bigger than even T-Rex! Spinosaurus had a giant sail on its back and hunted fish in rivers. Great for 1st and 2nd graders who love big dinosaurs."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",74]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Difficulty 2 out of 3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":"on"}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Medium"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Spinosaurus could be up to 59 feet long — longer than a school bus!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],"$L10","$L11",["$","$L12",null,{"title":"Spinosaurus Dot-to-Dot Printable - Free PDF","imageUrl":"/images/spinosaurus-74-puzzle.webp","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/en/dinosaurs/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":"Dinosaurs"}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Spinosaurus"," ",""]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Move over, T-Rex — meet the Spinosaurus, the largest meat-eating dinosaur ever to walk the Earth! Longer than a school bus and equally at home in water as on land, Spinosaurus was a truly extraordinary animal. Its giant back sail makes it one of the most dramatic dinosaurs to draw. Grab a pencil and let this prehistoric giant rise from the page!"}}],[["$","div","1–15",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–15"," — ","The Head and Crocodile Jaws"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Start at dot 1 and work through to dot 15 to sketch the long, narrow skull that looks more like a crocodile than a typical dinosaur. Children immediately notice how different this head shape is from T-Rex, which is a fantastic observation to encourage. The elongated snout rewards a steady, patient hand."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Spinosaurus had cone-shaped teeth ideal for catching slippery fish — very different from the blade-like teeth of T-Rex. Its nostrils were positioned high on the skull, like a crocodile's, allowing it to keep most of its head submerged while still breathing. A brilliant piece of natural engineering."]}]]}]]}],["$","div","16–30",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["16–30"," — ","The Giant Sail"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Continue from dot 16 to dot 30 to draw the towering sail that rises dramatically from the spine. This is the most thrilling section of the puzzle — the sail can be up to six feet tall, and children get to trace its full impressive height. Long, upward strokes build great arm confidence."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"The sail was supported by spines extending from the vertebrae, some stretching over five feet tall. Scientists still debate its purpose — it may have regulated temperature, stored fat like a camel's hump, or been a spectacular display structure for attracting mates or intimidating rivals."]}]]}]]}],["$","div","31–45",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["31–45"," — ","The Body"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Trace dots 31 through 45 for the long, muscular body. Spinosaurus had a relatively low body profile compared to other large carnivores — adapted for swimming and wading in rivers. Children practise a flatter, more horizontal body shape here, which is a refreshing contrast to the upright stance of T-Rex."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"New fossil discoveries show Spinosaurus had short, dense bones — the opposite of what most dinosaurs had — which made it less buoyant and better suited to life underwater, much like modern diving birds. It is the only dinosaur we know of that spent significant time swimming."]}]]}]]}],["$","div","46–60",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["46–60"," — ","The Sturdy Legs"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Connect dots 46 to 60 to build the stocky hind legs that carried this giant along riverbanks. Spinosaurus walked on all fours much of the time, unlike the two-legged stance of T-Rex, so children get to practise a wider, more grounded stance here."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Recent skeletal studies suggest Spinosaurus may have moved on four legs, at least while wading, making it very different from most large meat-eating dinosaurs — most of which walked upright on two legs."]}]]}]]}],["$","div","61–74",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["61–74"," — ","The Paddle-Shaped Tail"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Finish with dots 61 through 74 to complete the long, broad, paddle-shaped tail. The tail was another recent discovery that shocked palaeontologists, making it an effective swimming tool. Children practise the wide, flat tail shape in this final section."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Spinosaurus was likely a slow, clumsy walker on land but a strong swimmer in rivers. Its paddle-like tail was confirmed only in 2020 from newly found fossil specimens in Morocco — proving that even the most studied dinosaurs can still surprise us."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","trex-61-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/en/dinosaurs/trex-61-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"/images/trex-61-puzzle-400.webp","srcSet":"/images/trex-61-puzzle-400.webp 400w, /images/trex-61-puzzle-600.webp 600w, /images/trex-61-puzzle-700.webp 700w, /images/trex-61-puzzle.webp 420w","sizes":"(max-width: 760px) 92vw, 30vw","alt":"Mighty Tyrannosaurus Rex stomping out of 61 numbered dots, free dinosaur sheet","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","children":[["$","p",null,{"className":"puzzle-category","children":"Dinosaurs"}],["$","h3",null,{"children":"T-Rex 61-Dot Challenge"}],["$","div",null,{"className":"puzzle-meta","children":[["$","span",null,{"children":""}],["$","span",null,{"children":"1–61 dots"}]]}],["$","$Lf",null,{"href":"/en/dinosaurs/trex-61-dot-to-dot-puzzle/","className":"download-link","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":15,"height":15,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true","children":[["$","path","r04s7s",{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 