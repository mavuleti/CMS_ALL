2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Thuis\",\"item\":\"https://dottodotfreeprintables.com/nl/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Usa 250\",\"item\":\"https://dottodotfreeprintables.com/nl/usa-250/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Amerika 250 Adelaarsbanner\",\"item\":\"https://dottodotfreeprintables.com/nl/usa-250/america-250-anniversary-eagle-banner-dot-to-dot-puzzle/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"Amerika 250 Adelaarsbanner\",\"description\":\"Gekozen als nationaal symbool in 1782, draagt een Amerikaanse zeearend de Amerika 250 banner over 104 punten. Print de gratis PDF voor 6–10 jaar.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"Broodkruimel","children":[["$","$Lf",null,{"href":"/nl/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Thuis"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/nl/usa-250/","children":"Usa 250"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"Amerika 250 Adelaarsbanner"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"/images/america-250-anniversary-eagle-banner-puzzle-400.webp","srcSet":"/images/america-250-anniversary-eagle-banner-puzzle-400.webp 400w, /images/america-250-anniversary-eagle-banner-puzzle-600.webp 600w, /images/america-250-anniversary-eagle-banner-puzzle-700.webp 700w, /images/america-250-anniversary-eagle-banner-puzzle.webp 540w","sizes":"(max-width: 640px) 92vw, (max-width: 960px) 600px, 540px","alt":"Statige zeearend met lang spandoek, vleugels gespreid over 104 printbare stippen","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":"Usa 250"}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Amerika 250 Arend Banner Punt tot Punt — 104 Punten Hoog"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Verbind 104 stippen om een ​​majestueuze Amerikaanse zeearend te onthullen die een patriottische vlag draagt ​​ter ere van het 250-jarig bestaan ​​van Amerika! Dit gratis printbare werkblad helpt kinderen bij het oefenen van getallenreeksen en concentratie, terwijl ze een van Amerika's krachtigste symbolen van vrijheid en kracht eren. Perfect voor kinderen van 6 tot 10 jaar."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Moeilijkheidsgraad 1 uit 3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","De Amerikaanse zeearend werd in 1782 gekozen als nationaal symbool van de Verenigde Staten. Hij staat afgebeeld op het Grootzegel van de Verenigde Staten, de presidentiële vlag en talloze officiële emblemen – als symbool voor vrijheid, kracht en de onverzettelijke geest van de Amerikaanse republiek."]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],"$L10","$L11",["$","$L12",null,{"title":"Amerika 250 Adelaarsbanner Verbinden de Punten Afdrukbaar - Gratis PDF","imageUrl":"/images/america-250-anniversary-eagle-banner-puzzle.webp","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/nl/usa-250/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":"Usa 250"}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Amerika 250 Adelaarsbanner"," ",""]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Amerika viert zijn 250e verjaardag – en geen enkel symbool belichaamt die geest beter dan de machtige Amerikaanse zeearend! Al 244 jaar siert de adelaar het Grootzegel van de Verenigde Staten en zweeft hij als levend symbool van vrijheid. Vandaag houdt jouw adelaar een banier vast om Amerika's grootste verjaardag te verkondigen. Pak een potlood, zoek punt 1 op en laten we deze adelaar helpen vliegen!"}}],[["$","div","1–22",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–22"," — ","De kop en snavel van de adelaar"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Begin bij punt 1 en verbind deze met punt 22 om de stoere, trotse kop van de Amerikaanse zeearend te tekenen, inclusief zijn scherpe, gebogen snavel. Kinderen oefenen hier met korte, gerichte strepen en zachte rondingen, waardoor ze hun potloodbeheersing verbeteren terwijl ze het meest herkenbare kenmerk van de arend vormen."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"De Amerikaanse zeearend is eigenlijk niet kaal! Zijn naam komt van het oude Engelse woord \"balde\", wat wit betekent. De opvallende witte kopveren verschijnen wanneer de vogel volwassen is, rond de leeftijd van vijf jaar. Daarvoor hebben jonge arenden een gevlekt bruin-wit verenkleed."]}]]}]]}],["$","div","23–46",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["23–46"," — ","De spanwijdte — Linkervleugel"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Ga verder van punt 23 naar punt 46 om de krachtige linkervleugel van de adelaar te tekenen. Deze lange, vloeiende streken zijn een uitstekende oefening voor kinderen om hun armbewegingen en potloodbeheersing op grote schaal te ontwikkelen. Stimuleer een vloeiende, zelfverzekerde streep van schouder tot vleugelpunt."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"De spanwijdte van de vleugels van een Amerikaanse zeearend kan oplopen tot 2,4 meter (bijna 8 voet) van punt tot punt – ongeveer net zo breed als een kleine auto in de lengte! Dankzij die enorme vleugels kan de arend urenlang zweven op stijgende warme luchtstromen, thermiek genaamd, zonder ook maar een millimeter te hoeven slaan."]}]]}]]}],["$","div","47–70",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["47–70"," — ","De spanwijdte — rechtervleugel"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Spiegel de linkervleugel door de punten 47 tot en met 70 met elkaar te verbinden om de rechtervleugel te vormen. Symmetrie is een belangrijk visueel concept voor jonge leerlingen, en het voltooien van beide vleugels geeft een bevredigend gevoel van evenwicht en voldoening. Let op hoe de lijnen nu in de tegenovergestelde richting lopen."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Adelaars hebben tot wel 7000 veren die hun lichaam bedekken, elk precies gevormd voor zijn functie: brede vliegveren voor lift, zachte lichaamsveren voor isolatie en stijve staartveren om te sturen. Ze ruien en laten hun veren geleidelijk teruggroeien, zodat ze altijd kunnen vliegen."]}]]}]]}],["$","div","71–88",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["71–88"," — ","De Klauwen en de Vaderlandslievende Vaandel"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Verbind de stippen 71 tot en met 88 om de krachtige klauwen van de adelaar te tekenen die de wapperende jubileumbanner vastgrijpen. Kinderen oefenen met scherpe hoeken en gebogen lintvormen – meer veeleisende penseelstreken die nauwkeurige aandacht en een vaste hand belonen."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"De klauwen van een adelaar kunnen een grijpkracht uitoefenen van ongeveer 400 pond per vierkante inch (psi) – veel sterker dan een gemiddelde menselijke hand. Klauwen worden gebruikt om vissen en kleine zoogdieren te vangen, en de greep van de adelaar is zo stevig dat prooien zelden ontsnappen als ze eenmaal gevangen zijn."]}]]}]]}],["$","div","89–104",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["89–104"," — ","De sterren, het schild en de laatste details"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Maak de puzzel af door de punten 89 tot en met 104 met elkaar te verbinden. Zo voeg je de patriottische sterren, schildmarkeringen en de laatste details toe die deze adelaar echt Amerikaans maken. Neem de tijd voor deze laatste punten; een zorgvuldige afwerking zorgt ervoor dat het geheel prachtig in elkaar past."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Het Grootzegel van de Verenigde Staten, ontworpen in 1782, toont een Amerikaanse zeearend die in de ene klauw een olijftak vasthoudt (als symbool voor vrede) en in de andere een bundel van 13 pijlen (als symbool voor de bereidheid om de vrijheid te verdedigen). De arend kijkt naar de olijftak – een herinnering dat vrede altijd de eerste keuze is."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Usa 250"}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","gas-balloon-usa-250-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/nl/usa-250/gas-balloon-usa-250-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"/images/gas-balloon-usa-250-puzzle-400.webp","srcSet":"/images/gas-balloon-usa-250-puzzle-400.webp 400w, /images/gas-balloon-usa-250-puzzle-600.webp 600w, /images/gas-balloon-u