,"gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Складність 1 з 3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Приблизно дві третини ведмедів-полярників у світі живуть у Канаді."]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],"$L10","$L11",["$","$L12",null,{"title":"Білий ведмідь Роздруковка з точками - Безкоштовний PDF","imageUrl":"/images/canada-polar-bear-puzzle.webp","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/uk/canada/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":"Канада"}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Білий ведмідь"," ",""]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Білі ведмеді блукають замерзлими берегами та морськими льодами канадської Арктики. Їхнє густе хутро, маленькі вуха та велетенські лапи допомагають їм зберігати тепло та пересуватися снігом, льодом і водою. Ця головоломка на 74 точки зображує білого ведмедя від носа до широких лап. Починайте з точки 1 і долайте цей шлях обережною лінією за лінією."}}],[["$","div","1–15",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–15"," — ","Ніс та голова"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Починайте з точки 1 і з'єднайте до точки 15, щоб сформувати ніс, морду та округлу голову. Тримайте лінії м'якими навколо обличчя, щоб профіль ведмедя виглядав гладким."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Білий ведмідь має чудове нюхання, яке допомагає йому знаходити тюленів, свою основну здобич, крізь лід."]}]]}]]}],["$","div","16–30",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["16–30"," — ","Спина та плечі"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Продовжуйте з точки 16 до точки 30 вздовж міцних плечей та вигнутої спини. Намагайтеся провести цей довгий контур рівними штрихами замість багатьох дрібних позначок."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Білі ведмеді — найбільші сухопутні хижаки в Канаді. Дорослі самці можуть важити кілька сотень кілограмів."]}]]}]]}],["$","div","31–45",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["31–45"," — ","Задні ноги"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Обведіть точки 31–45, щоб намалювати задні ноги та лапи. Уважно перевіряйте кожну цифру там, де контур змінює напрямок біля лап."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Широкі лапи білого ведмедя розподіляють вагу по снігу і працюють як весла під час плавання."]}]]}]]}],["$","div","46–60",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["46–60"," — ","Черев та передні лапи"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"З'єднайте точки 46–60 під тілом та навколо передніх лап. Короткі, контрольовані лінії допоможуть вам слідувати за більш крутими вигинами."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Під хутром, яке здається білим, у білих ведмедів чорна шкіра. Їхнє хутро допомагає їм злитися зі сніговим арктичним пейзажем."]}]]}]]}],["$","div","61–74",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["61–74"," — ","Грудна клітка та фініш"]}],["$","p",null,{"style":{"lineHei