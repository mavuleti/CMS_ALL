xWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"/images/roller-coaster-playground-puzzle-400.webp","srcSet":"/images/roller-coaster-playground-puzzle-400.webp 400w, /images/roller-coaster-playground-puzzle-600.webp 600w, /images/roller-coaster-playground-puzzle-700.webp 700w, /images/roller-coaster-playground-puzzle.webp 540w","sizes":"(max-width: 640px) 92vw, (max-width: 960px) 600px, 540px","alt":"Ātrā rotaļlietu auto, kas dodas uz priekšu, kad ir savienoti 48 numurēti punkti","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":"Playgrounds"}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Ekstrēmi kalniņu punkti uz punktu — 133 punkti, bezmaksas"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Savienojiet 48 vienkāršus punktus, lai atklātu ātri braucošu auto, kas gatavs drāzties pāri rotaļu laukumam. Šī bezmaksas drukājamā puzle palīdz maziem bērniem praktizēt skaitļu secību, zīmuļa vadīšanu un koncentrēšanos ar jautru transportlīdzekļu tēmu."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Grūtības pakāpe 1 no 3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Pirmais lokveida kalniņš tika atvērts Parīzē 1846. gadā. Braucēji sūdzējās, ka tas sāp viņu kakliem, un inženieriem bija nepieciešami gandrīz 50 gadi, lai izstrādātu loku, kas jutās gludi, nevis sodīgi."]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],"$L10","$L11",["$","$L12",null,{"title":"Rotaļu laukuma kalniņi Punktu savienošana izdrukājama - Bezmaksas PDF","imageUrl":"/images/roller-coaster-playground-puzzle.webp","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/lv/playgrounds/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":"Playgrounds"}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Rotaļu laukuma kalniņi"," ",""]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Drosmīgs auto ir radīts piedzīvojumiem — tuvs zemes virsmai, gatavs braucienam un pilns ar formām, ko jaunie mākslinieki var atpazīt. Šī draudzīgā 48-punktu puzle ir piemērots pirmais transportlīdzekļa izaicinājums bērniem, kas praktizē skaitļu secību un zīmuļa vadību. Atrodi punktu 1, iedomājies, ka dzinējs iedarbas, un zīmē savu ceļu līdz finiša līnijai!"}}],[["$","div","1–22",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–22"," — ","Pacelšanās kalns"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Sāc no 1. punkta un savieno līdz 10. punktam, lai uzzīmētu automašīnas priekšpusi. Bērni praktizē īsas taisnas līnijas un maigas līknes, vienlaikus mācoties skatīties uz priekšu uz nākamo numuru, nevis steidzoties pāri lapai."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Lielākā daļa kalniņu izmanto ķēdes pacelšanu, lai uzvilktu automašīnu augšā pirmajā kalnā — parasti tā ir vienīgā brauciena daļa, ko darbina motors. Viss, kas notiek pēc šī kalna virsotnes, notiek tikai uz gravitātes un impulsu rēķina."]}]]}]]}],["$","div","23–44",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["23–44"," — ","Pirmais kritiens"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Turpiniet no 11. punkta līdz 20. punktam, lai izveidotu vējstiklu un jumtu. Šī daļa vienmērīgi paceļas un nokrīt, veidojot vienu gludu kontūru, kas bērniem sniedz noderīgu vingrinājumu leņķainu līniju savienošanā, bez pārāk bieža zīmuļa pacelšanas."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Pirmais kritiens kalniņos gandrīz vienmēr ir visaugstākais un stāvākais visā braucienā. Kalniņu dizaineri to novieto agrīnā posmā apzināti, jo parasti tieši tur trase sasniedz savu maksimālo ātrumu."]}]]}]]}],["$","div","45–66",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["45–66"," — ","Cilpa"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Izseko punktus no 21. līdz 30. gar auto sānu, lai pabeigtu durvis un galveno korpusu. Garākie savienojumi veicina vienmērīgu roku, bet mainīgie leņķi palīdz bērniem ievērot, kā vienkāršas formas savienojas pazīstamā objektā."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Agrīnie cilpu kalniņi izmantoja perfekti apaļu cilpu, un braucēji bieži sūdzējās par kakla spriedzi no pēkšņas spēka maiņas. Mūsdienu cilpas izmanto asaru formas, kas jūtas daudz maigi uz ķermeņa tajā pašā ātrumā."]}]]}]]}],["$","div","67–88",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["67–88"," — ","Kamieļa muguras kalni"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Savienojiet punktus no 31 līdz 40, lai izveidotu riteņus un riteņu arkām. Noapaļotas riteņu formas ir lieliski vingrinājumi gludai zīmuļa kustībai. Mudiniet bērnus rūpīgi sekot numurētajam kontūram, nevis mēģināt uzzīmēt perfektu apli."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Šie mazākie pacēlumi dažreiz tiek saukti par 'kamieļa muguras' kalniem, jo rinda no tiem izskatās kā kamieļa kuprīši. Braucēji bieži jūt īsu pacelšanos no savām sēdvietām, kad tie pārvar katru no tiem — īsts, ja arī mazs, bezsvara brīdis."]}]]}]]}],["$","div","89–110",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["89–110"," — ","Pēdējais pagrieziens"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Pabeidziet ar punktiem no 41 līdz 48, lai pievienotu apgaismojumu un pārējās detaļas. Atliek tikai astoņi savienojumi, tāpēc šis ir labais brīdis, lai pievērstos un ar precīzu, pārliecinātu pieeju pabeigtu mašīnu."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Kalniņu dizaineri šo posmu sauc par 'atgriešanās skrējienu.' Tas ir būvēts plats un slīps, lai automašīna varētu saglabāt savu ātrumu caur līkumu, nepārtraukti neizmantojot bremzes, atstājot faktisko bremzēšanu pašā beigās."]}]]}]]}],["$","div","111–133",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["111–133"," — ","Stacija un platforma"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Pabeidziet, savienojot punktus no 111 līdz 133, lai uzzīmētu stacijas platformu, kur sākās un beidzās brauciens. Divdesmit trīs punkti līdz finišam — lēna, uzmanīga pabeigšana ir patiesais neatlaidības rādītājs."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Bremzēšanas posms reālu kalniņu beigās ir viens no visvairāk inženierētajiem daļām. Tam jāspēj gludi apturēt automašīnu ar pilnu braucēju skaitu no pilna ātruma līdz pilnīgai apstāšanai, lai neviens netiktu izsists."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Playgrounds"}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","spring-horse-playground-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/lv/playgrounds/spring-horse-playground-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"/images/playgrounds-spring-horse-puzzle-400.webp","srcSet":"/images/playgrounds-spring-horse-puzzle-400.webp 400w, /images/playgrounds-spring-horse-puzzle-600.webp 600w, /images/playgrounds-spring-horse-puzzle-700.webp 700w, /images/playgrounds-spring-horse-puzzle.webp 420w","sizes":"(max-width: 760px) 92vw, 30vw","alt":"Spēļu pavasara zirdziņa braucējs, kas izlec formā no 53 izdr