e:["$","$L15",null,{"formats":"$undefined","locale":"el","messages":{"nav":{"scanMe":"Σάρωση","blog":"Ιστολόγιο","search":"Ερευνα","kids":"Παιδιά - Παζλ","teachers":"Δάσκαλοι","parents":"Γονείς","contact":"Επικοινωνήστε μαζί μας","freePack":"Δωρεάν πακέτο"},"homepageUi":{"title":"Βρες τα τέλεια εκτυπώσιμα παζλ τελεία με τελεία","description":"Εκτύπωσε, ένωσε τις τελείες και ζωντάνεψε καταπληκτικές εικόνες. Δωρεάν και έτοιμο για διασκέδαση!","searchPlaceholder":"Δοκίμασε ωκεανός, δεινόσαυρος ή λουλούδια","filterPuzzles":"Φιλτράρισμα παζλ","age":"Ηλικία","dots":"τελείες","featuredPuzzles":"Επιλεγμένα εκτυπώσιμα παζλ","savePuzzle":"Αποθήκευση {name}","removeSavedPuzzle":"Αφαίρεση {name} από τα αποθηκευμένα παζλ","downloads":"λήψεις","bookTitle":"Τα καλύτερα του 2026 · {count}","bookDescription":"Τα αγαπημένα μας παζλ τελεία με τελεία σε ένα εκτυπώσιμο βιβλίο PDF.","searchUnavailable":"Η αναζήτηση είναι προσωρινά μη διαθέσιμη. Δοκίμασε ξανά.","popularEyebrow":"Δημοφιλή αυτή την εβδομάδα","mostDownloaded":"Τα πιο κατεβασμένα παζλ","downloadCountAria":"{count} ή περισσότερες λήψεις","freshPrintables":"Φρέσκα εκτυπώσιμα","recentlyAdded":"Πρόσφατα προστιθέμενα","browseCategories":"Περιήγηση σε κατηγορίες παζλ","openCategories":"Άνοιγμα μενού κατηγοριών","closeCategories":"Κλείσιμο μενού κατηγοριών","browseByTheme":"Περιήγηση κατά θέμα","quickLinks":"Γρήγοροι σύνδεσμοι","bundlePacks":"Συσκευασίες Πακέτων","parentsTeachers":"Για Γονείς & Δασκάλους","more":"Περισσότερες κατηγορίες","kids":"Παιδιά","categoryNames":{"cute":"Γλυκά Παζλ","flowers":"Λουλούδια"}},"audience":{"kidsTitle":"Για παιδιά","kidsText":"Φιλικά θέματα με ζώα, δεινόσαυρους και οχήματα με ευκρινείς αριθμημένες κουκκίδες. Εύκολες νίκες που χτίζουν πραγματική αυτοπεποίθηση.","parentsTitle":"Για γονείς","parentsText":"Δραστηριότητες για ώρες ησυχίας χωρίς οθόνη για το σπίτι, τα ταξίδια και τα εστιατόρια. Εκτυπώστε από οποιαδήποτε συσκευή σε λιγότερο από ένα λεπτό.","teachersTitle":"Για εκπαιδευτικούς","teachersText":"Συνδέσεις με χαμηλή προετοιμασία για πρωινή εργασία, μαθητές που τελειώνουν νωρίς, αναπληρωματικά και σταθμούς στην τάξη — δεν απαιτείται προετοιμασία."},"categories":{"eyebrow":"Οργανωμένο ανά θέμα και επίπεδο δεξιοτήτων","heading":"Περιηγηθείτε σε παζλ με κουκκίδες ανά κατηγορία","description":"Από απλά σχήματα 10 κουκκίδων για νήπια μέχρι προκλήσεις 200 κουκκίδων για μεγαλύτερα παιδιά — ταξινομημένα ανά κατηγορία, ώστε να βρίσκετε το κατάλληλο δωρεάν εκτυπώσιμο υλικό σε δευτερόλεπτα.","puzzles":"{count, plural, one {# παζλ} other {# παζλ}}","comingSoon":"Σύντομα διαθέσιμο","badges":{"dinosaurs":"Διαθέσιμο τώρα!","ocean":"Διαθέσιμο τώρα!","playgrounds":"Διαθέσιμο τώρα!","garden":"Διαθέσιμο τώρα!","usa250":"Νέος!","uae":"Διαθέσιμο τώρα!","cute":"Νέος!","circus":"Νέο!"},"items":{"dinosaurs":{"name":"Δεινόσαυροι","description":"Βουτήξτε στην προϊστορική διασκέδαση! Τυραννόσαυρος Ρεξ, Τρικεράτοπας, Βελοκιράπτορας και {count} δωρεάν παζλ με κουκκίδες που θα λατρέψουν τα παιδιά σας."},"animals":{"name":"Ζώα","description":"Φιλικά πλάσματα για πρώιμη εξάσκηση αριθμών."},"vehicles":{"name":"Οχήματα","description":"Αυτοκίνητα, φορτηγά, πύραυλοι και μηχανήματα."},"fantasy":{"name":"Φαντασία","description":"Κάστρα, μονόκεροι, δράκοι και ιστορίες."},"seasonal":{"name":"Εποχής","description":"Δραστηριότητες για τις γιορτές και το ημερολόγιο της τάξης."},"ocean":{"name":"Ωκεανός","description":"Σελίδες χρωματισμού με θαλάσσια ζώα και ήρεμες εικόνες."},"playgrounds":{"name":"Παιδικές χαρές","description":"Κούνιες, τσουλήθρες και υπαίθρια διασκέδαση για τους μικρούς λάτρεις της περιπέτειας."},"garden":{"name":"Κήπος","description":"Γάντια, μυστριά και εργαλεία για τους μικρούς βοηθούς στον κήπο."},"usa250":{"name":"Αμερική 250 Χρόνια","description":"Γιορτάστε τα 250ά γενέθλια της Αμερικής με πατριωτικά παζλ με τελείες που τιμούν την αμερικανική ιστορία."},"uae":{"name":"ΗΑΕ","description":"Εξερευνήστε τα Ηνωμένα Αραβικά Εμιράτα! Εμβληματικά αξιοθέατα όπως το Burj Al Arab, έτοιμα να σας συνδέσουν και να χρωματίσουν."},"space":{"name":"Χώρος","description":"Πλανήτες, αστροναύτες και περιπέτειες με πυραύλους."},"worksheets":{"name":"Φύλλα εργασίας","description":"Φύλλα αριθμητικής ακολουθίας έτοιμα για εκπαιδευτικούς."},"bigDotBooks":{"name":"Βιβλία Big Dot","description":"Παζλ μεγάλης διάρκειας για συγκεντρωμένους μεγαλύτερους μαθητές."},"cute":{"name":"Χαριτωμένος","description":"Αξιολάτρευτα κουτάβια, μικρά αυτοκινητάκια και {count} γοητευτικά δωρεάν παζλ με κουκκίδες που θα λατρέψουν τα παιδιά σας."},"circus":{"name":"Τσίρκο","description":"Διευθυντές, μεγάλοι θόλοι και διασκέδαση για νέους μαθητές."}}},"puzzleSection":{"eyebrow":"Δωρεάν εκτυπώσιμα δείγματα — χωρίς εγγραφή","heading":"Δημοφιλή φύλλα με ένθετα για εκτύπωση τώρα","weeklyPack":"Δείτε το εβδομαδιαίο πακέτο →","downloadLink":"Κατεβάστε δωρεάν εκτυπώσιμο","new":"Νέος","imageAlt":"{name} δωρεάν εκτυπώσιμο φύλλο εργασίας με κουκκίδες για {age}","categories":{"Dinosaurs":"Δεινόσαυροι","Ocean":"Ωκεανός","Playgrounds":"Παιδικές χαρές","Garden":"Κήπος","Cute":"Χαριτωμένος","USA 250 Years":"Αμερική 250 Χρόνια","UAE":"ΗΑΕ"},"items":{"trex-61-dot-to-dot-puzzle":{"name":"Πρόκληση T-Rex 61-Dot"},"brontosaurus-dot-to-dot-puzzle":{"name":"Βροντοσαύρος"},"mermaid-dot-to-dot-puzzle":{"name":"Γοργόνα"},"merman-dot-to-dot-puzzle":{"name":"Γοργόνα"},"seahorse-dot-to-dot-puzzle":{"name":"Ιππόκαμπος"},"whale-dot-to-dot-puzzle":{"name":"Φάλαινα"},"swing-playgrounds-dot-to-dot-puzzle":{"name":"Παιδική χαρά με κούνια"},"slide-playgrounds-dot-to-dot-puzzle":{"name":"Παιδική χαρά με τσουλήθρες"},"seesaw-playground-dot-to-dot-puzzle":{"name":"Παιδική χαρά Seesaw"},"roller-coaster-playground-dot-to-dot-puzzle":{"name":"Παιδική χαρά Roller Coaster"},"wheelbarrow-playground-dot-to-dot-puzzle":{"name":"Παιδική χαρά με καρότσι"},"garden-gloves-dot-to-dot-puzzle":{"name":"Γάντια κήπου"},"garden-trowel-dot-to-dot-puzzle":{"name":"Σπάτουλα κήπου"},"gas-balloon-usa-250-dot-to-dot-puzzle":{"name":"Αερόστατο Αέρα 250"},"america-250-birthday-fireworks-dot-to-dot-puzzle":{"name":"Πυροτεχνήματα για τα 250α γενέθλια της Αμερικής"},"america-250-anniversary-liberty-bell-wings-1776-dot-to-dot-puzzle":{"name":"Αμερική 250 Φτερά Καμπάνας της Ελευθερίας"},"usa-250-astronaut-dot-to-dot-puzzle":{"name":"Αστροναύτης America 250"},"usa-250-anniversary-sports-kids-podium-dot-to-dot-puzzle":{"name":"Παιδικό βάθρο για την 250ή επέτειο της Αμερικής"},"usa-250-anniversary-airplane-banner-dot-to-dot-puzzle":{"name":"250ή επέτειος της Αμερικής με αεροπλάνο"},"usa-250-space-shuttle-dot-to-dot-puzzle":{"name":"Διαστημικό Λεωφορείο America 250"},"usa-250-birthday-balloons-stars-dot-to-dot-puzzle":{"name":"Μπαλόνια και αστέρια γενεθλίων America 250"},"usa-250-birthday-cake-dot-to-dot-puzzle":{"name":"Τούρτα γενεθλίων America 250"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"Αμερική 250 Λάβαρο με Αετό"},"burj-al-arab-dot-to-dot-puzzle":{"name":"Μπουρτζ Αλ Αράμπ"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"Καφετιέρα Ντάλα"}}},"benefits":{"eyebrow":"Υποστηρίζεται από εκπαιδευτικούς προσχολικής ηλικίας","heading":"Γιατί τα φύλλα εργασίας με τις τελείες είναι ιδανικά για την ανάπτυξη των παιδιών","description":"Τα εκτυπώσιμα έγγραφα με τη μέθοδο «Σύνδεση των κουκκίδων» είναι κάτι περισσότερο από απλή διασκέδαση — είναι ένα εργαλείο που υποστηρίζεται από έρευνα και χρησιμοποιείται από νηπιαγωγούς και δασκάλους για την ανάπτυξη βασικών δεξιοτήτων πρώιμης μάθησης.","fineMotorTitle":"Χτίζει λεπτές κινητικές δεξιότητες","fineMotorText":"Το σχέδιο γραμμών από κουκκίδα σε κουκκίδα αναπτύσσει τη λαβή του μολυβιού, τον συντονισμό χεριού-ματιού και τον μυϊκό έλεγχο που χρειάζονται τα παιδιά για τη γραφή.","numberTitle":"Ενισχύει την αναγνώριση αριθμών","numberText":"Η ακολουθία των κουκκίδων 1 → 2 → 3 διδάσκει τη σειρά αρίθμησης, την αναγνώριση αριθμών και τις πρώιμες μαθηματικές έννοιες με φυσικό τρόπο μέσω του παιχνιδιού.","focusTitle":"Βελτιώνει την εστίαση και τη συγκέντρωση","focusText":"Η συμπλήρωση ενός παζλ με τις τελείες απαιτεί διαρκή προσοχή — έναν ήρεμο, χωρίς οθόνη τρόπο εξάσκησης της συγκέντρωσης για παιδιά προσχολικής ηλικίας έως και 3ης τάξης.","confidenceTitle":"Άμεση ανταμοιβή και αυτοπεποίθηση","confidenceText":"Όταν εμφανίζεται η κρυμμένη εικόνα, τα παιδιά νιώθουν αμέσως μια αίσθηση επιτυχίας. Αυτή η μικρή νίκη χτίζει μια αγάπη για τη μάθηση και μια νοοτροπία ανάπτυξης."},"howTo":{"eyebrow":"Έτοιμο σε λιγότερο από 60 δευτερόλεπτα","heading":"Πώς να κατεβάσετε και να εκτυπώσετε δωρεάν φύλλα εργασίας με κουκκίδες","step1Title":"Διάλεξε το παζλ σου","step1Text":"Επιλέξτε ένα θέμα (ζώα, δεινόσαυροι, οχήματα, διακοπές) και ένα εύρος κουκκίδων που ταιριάζει με την ηλικία και το επίπεδο δεξιοτήτων του παιδιού σας.","step2Title":"Κατεβάστε το δωρεάν PDF","step2Text":"Κάντε κλικ στην επιλογή \"Λήψη δωρεάν εκτυπώσιμου αρχείου\" — χωρίς λογαριασμό, χωρίς email, χωρίς paywall. Το πρόγραμμα περιήγησής σας κατεβάζει το PDF αμέσως.","step3Title":"Εκτυπώστε και απολαύστε","step3Text":"Εκτυπώστε σε τυπικό χαρτί US Letter (8,5\" × 11\"). Το ασπρόμαυρο λειτουργεί τέλεια. Δώστε το στο παιδί σας και παρακολουθήστε το να συνδέει τις τελείες!"},"trust":{"eyebrow":"Γιατί μας επιλέγουν γονείς και εκπαιδευτικοί","heading":"Δωρεάν, ασφαλές και απίστευτα εύκολο στη χρήση.","noAccountTitle":"Δεν απαιτείται λογαριασμός","noAccountText":"Κάθε εκτυπώσιμο αρχείο από τελεία σε τελεία λαμβάνεται αμέσως — χωρίς εγγραφή, χωρίς email, χωρίς paywall. Απλώς κάντε κλικ και εκτυπώστε.","safeTitle":"Χρηματοκιβώτιο στην τάξη","safeText":"Καθαρές σελίδες παζλ χωρίς διαφημίσεις, σχεδιασμένες για σχολικούς εκτυπωτές. Λειτουργούν για πρωινή εργασία, εργασίες για το σπίτι ή για ώρες ησυχίας.","fastTitle":"Γρήγορο εκ κατασκευής","fastText":"Οι στατικές σελίδες, οι βελτιστοποιημένες εικόνες και οι τοπικές γραμματοσειρές σημαίνουν ότι τα παζλ φορτώνουν γρήγορα σε οποιαδήποτε συσκευή - τηλέφωνο, tablet ή φορητό υπολογιστή."},"faq":{"eyebrow":"Συνήθεις ερωτήσεις","heading":"Συχνές ερωτήσεις","q1":"Είναι όλα τα εκτυπώσιμα έγγραφα από τελεία σε τελεία σε αυτόν τον ιστότοπο εντελώς δωρεάν;","a1":"Ναι — κάθε φύλλο εργασίας \"connect-the-dots\" στο DotToDotFreePrintables.com είναι 100% δωρεάν για λήψη και εκτύπωση. Δεν απαιτείται ποτέ λογαριασμός, συνδρομή ή πιστωτική κάρτα.","q2":"Για ποια ηλικία είναι κατάλληλα τα φύλλα εργασίας με κουκκίδες;","a2":"Τα εκτυπώσιμα υλικά μας καλύπτουν ηλικίες 2–12 ετών. Τα εύκολα φύλλα εργασίας (10–20 κουκκίδες) είναι κατάλληλα για νήπια και παιδιά προσχολικής ηλικίας, τα μεσαίου μεγέθους φύλλα (20–50 κουκκίδες) είναι ιδανικά για το νηπιαγωγείο και την Α' δημοτικού, ενώ τα πιο δύσκολα φύλλα (50–200+ κουκκίδες) είναι κατάλληλα για μαθητές Β' έως ΣΤ' δημοτικού.","q3":"Σε ποια μορφή είναι τα εκτυπώσιμα \"connect-the-dots\";","a3":"Όλα τα φύλλα εργασίας λαμβάνονται ως αρχεία PDF έτοιμα για εκτύπωση, μεγέθους για τυπικό χαρτί US Letter (8,5\" × 11\"). Ανοίξτε τα σε οποιοδήποτε πρόγραμμα περιήγησης ή πρόγραμμα προβολής PDF και εκτυπώστε τα — δεν απαιτείται ειδικό λογισμικό.","q4":"Έχετε φύλλα εργασίας με τελείες για νηπιαγωγείο και νηπιαγωγείο;","a4":"Απολύτως. Τα πιο εύκολα φύλλα εργασίας μας ξεκινούν από 1–10 κουκκίδες (ιδανικά για ηλικίες 2–4 ετών) και περιλαμβάνουν θέματα αναγνώρισης αλφαβήτου και αριθμών σχεδιασμένα για τάξεις προνηπίου και νηπιαγωγείου.","q5":"Μπορούν οι εκπαιδευτικοί να χρησιμοποιήσουν αυτά τα φύλλα εργασίας «ένωσε τις τελείες» στην τάξη;","a5":"Ναι! Τα εκτυπώσιμα υλικά μας είναι δωρεάν για προσωπική χρήση και χρήση στην τάξη. Είναι δημοφιλή για πρωινή εργασία, δραστηριότητες για μαθητές που τελειώνουν νωρίς, σχέδια μαθημάτων υποκατάστασης, κέντρα λεπτής κινητικότητας και πακέτα εργασιών για το σπίτι.","q6":"Βοηθούν τα παζλ κουκκίδες-κουκκίδες στις λεπτές κινητικές δεξιότητες;","a6":"Ναι — η σχεδίαση γραμμών ανάμεσα στις κουκκίδες ενισχύει τη δύναμη λαβής του μολυβιού και τον συντονισμό χεριού-ματιού που υποστηρίζουν την ετοιμότητα για γραφή. Πολλοί εργοθεραπευτές και νηπιαγωγοί προτείνουν δραστηριότητες σύνδεσης των κουκκίδων για αυτόν τον λόγο.","q7":"Έχετε θεματικά εκτυπώσιμα αντικείμενα από τελεία σε τελεία, όπως ζώα ή δεινόσαυρους;","a7":"Έχουμε 11 κατηγορίες, όπως ζώα, δεινόσαυρους, οχήματα, πλάσματα του ωκεανού, παιδικές χαρές, 250 χρόνια Αμερικής, διάστημα, φαντασία, εποχιακά/εορταστικά θέματα, πακέτα φύλλων εργασίας για εκπαιδευτικούς και βιβλία με τις μεγάλες κουκκίδες. Νέα σχέδια προστίθενται εβδομαδιαίως.","q8":"Μπορώ να εκτυπώσω αυτά τα παζλ ασπρόμαυρα;","a8":"Ναι — όλα τα φύλλα εργασίας μας με θέμα «ένωσε τις τελείες» έχουν σχεδιαστεί για ασπρόμαυρη εκτύπωση για εξοικονόμηση μελανιού. Δείχνουν υπέροχα σε οποιονδήποτε εκτυπωτή για το σπίτι ή την τάξη."},"newsletter":{"eyebrow":"Εκτυπώσιμο πακέτο εκκίνησης — εντελώς δωρεάν","heading":"Λάβετε 20 δωρεάν εκτυπώσιμα έγγραφα από τελεία σε τελεία στα εισερχόμενά σας.","description":"Μια συλλογή φιλική προς τους γονείς και τους εκπαιδευτικούς που καλύπτει ζώα, οχήματα, δεινόσαυρους και εποχιακά θέματα — όλα σε μέγεθος για τυπικό χαρτί US Letter και βελτιστοποιημένα για ασπρόμαυρη εκτύπωση."},"blog":{"eyebrow":"Ιδέες για ενήλικες","heading":"Συμβουλές μάθησης για το σπίτι και την τάξη","viewAll":"Δείτε όλα τα άρθρα","read":"Ανάγνωση"},"feedback":{"eyebrow":"Θα θέλαμε πολύ να σας ακούσουμε","heading":"Αποστολή σχολίων","description":"Έχετε κάποια ιδέα για παζλ, εντοπίσατε έναν σπασμένο σύνδεσμο ή απλώς θέλετε να μας πείτε ένα γεια; Αφήστε μας ένα μήνυμα παρακάτω."},"footer":{"description":"Δωρεάν εκτυπώσιμα παζλ και φύλλα εργασίας με θέμα «ένωση των κουκκίδων» για παιδιά, γονείς και εκπαιδευτικούς. Όλα τα παζλ είναι δωρεάν για λήψη, εκτύπωση και κοινή χρήση.","kids":"Μικρόκοσμος","parents":"Γονείς","teachers":"Δάσκαλοι","blog":"Ιστολόγιο","faq":"Συχνές ερωτήσεις","feedback":"Ανατροφοδότηση","about":"Για","contact":"Επαφή","privacy":"Μυστικότητα","terms":"Οροι","sitemap":"Χάρτης ιστότοπου","copyright":"© {year} DotToDotFreePrintables.com · Δωρεάν εκτυπώσιμες δραστηριότητες για παιδιά"},"common":{"home":"Σπίτι","new":"Νέος","comingSoon":"Σύντομα διαθέσιμο","downloadFree":"Κατεβάστε δωρεάν εκτυπώσιμο","viewDownload":"Προβολή & Λήψη","shareTitle":"{name} Σύνδεσμος για Σύνδεση - Δωρεάν PDF","downloadAria":"Κατεβάστε δωρεάν το {name} σύνδεσμο για σύνδεση PDF","bookmarkTitle":"{name} Σύνδεσμος για Σύνδεση – Δωρεάν PDF για Παιδιά","showSlide":"Εμφάνιση διαφάνειας {number}","ageRange":"Ηλικίες {min}-{max}","difficultyLabel":"Δυσκολία {level} από 3","difficulty":{"1":"Εύκολος","2":"Μέσον","3":"Σκληρά"},"dots":"1–{count} τελείες","homeVideoEyebrow":"Βίντεο","homeVideoH2":"Παρακολουθήστε τη διασκέδαση από τελεία σε τελεία εν δράσει","skipToContent":"Παράκαμψη στο κύριο περιεχόμενο","joinTeachers":"Εγγραφείτε σε {count}+ δασκάλους","breadcrumbAria":"Ψίχουλα"},"puzzleSearch":{"placeholder":"Search by name or topic... e.g. ocean, whale, T-Rex","searchAria":"Αναζήτηση παζλ","clearSearch":"Clear search","toggleFilters":"Toggle filters","filters":"Filters","filterOptions":"Filter options","topic":"Topic","numberOfDots":"Number of dots","recentlyAddedOnly":"Recently added only","clearAllFilters":"Clear all filters","clearFilters":"Clear filters","resultsFound":"{count, plural, one {# παζλ που βρέθηκε} other {# παζλ που βρέθηκαν}}","puzzlesAvailable":"{count, plural, one {# puzzle available} other {# puzzles available}}","noMatches":"Δεν βρέθηκαν παζλ που να ταιριάζουν με την αναζήτησή σας.","openPuzzle":"Open {name}","imageAlt":"{name} εκτυπώσιμο από τελεία σε τελεία","viewPuzzle":"View puzzle →","dotRanges":{"under35":"Under 35 dots","35to50":"35-50 dots","51to70":"51-70 dots","over70":"70+ dots"},"categories":{"Dinosaurs":"Dinosaurs","Ocean":"Ocean","Playgrounds":"Playgrounds","Garden":"Garden","Cute":"Cute","USA 250 Years":"America 250 Years","UAE":"UAE"}},"newsletterForm":{"ariaLabel":"Αποκτήστε το δωρεάν πακέτο εκτυπώσιμων εκτυπώσεων από τελεία σε τελεία","emailLabel":"Διεύθυνση ηλεκτρονικού ταχυδρομείου","submit":"Στείλτε δωρεάν πακέτο","honeypot":"Αφήστε αυτό το πεδίο κενό",