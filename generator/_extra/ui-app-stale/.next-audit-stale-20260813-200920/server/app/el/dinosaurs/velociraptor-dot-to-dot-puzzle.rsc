ut us"},"puzzleDetail":{"agesLabel":"Ages:","dotsLabel":"Dots:","freeLabel":"100% Free","difficultyHeading":"Difficulty","difficultyEasy":"Easy","difficultyMedium":"Medium","difficultyHard":"Hard","funFactPrefix":"Fun fact:","funFactLabel":"Fun fact!","noSignUp":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use.","comingSoon":"Download Free PDF – Coming Soon","youMightLike":"You might also like","faqQ1":"What age is the {name} dot to dot puzzle for?","faqA1":"It is designed for ages {age}. With {dots} dots, it suits children who can confidently count to {dots}; younger children can complete it with a little help.","faqQ2":"How do I print the {name} worksheet?","faqA2":"Click the download button to get the free PDF, then print it on regular paper (A4 or US Letter) from any browser or PDF reader. No special software is needed.","faqQ3":"Is the {name} printable really free?","faqA3":"Yes — it is 100% free, with no sign-up, account, or payment required. You may print it for home or classroom use."},"blogPage":{"eyebrow":"Learning resources","h1":"Dot to Dot Ideas for Parents and Teachers","description":"Practical guides for choosing activities, building early learning skills, and using printable worksheets at home or in the classroom.","breadcrumb":"Blog","latestEyebrow":"Latest articles","latestH2":"Helpful ideas you can use today","readArticle":"Read article","by":"By","backToAll":"← Back to all articles","savePinterest":"Save to Pinterest","relatedEyebrow":"Free printables","relatedHeading":"Try these dot to dot collections next"},"downloadButton":{"label":"Download Free Printable PDF","usage":"Free for home and classroom use.","paperNote":"Sized for {size} paper.","paperLetter":"US Letter","paperA4":"A4","alternateLink":"Prefer {size}? Download that version","downloadSize":"Download (Print Size: {size})"},"downloadBadge":{"downloaded":"Downloaded","times":"times","greatChoice":"You’ve made a great choice!"},"bookmarkButton":{"regionLabel":"Bookmark this page","shortcut":"Press <shortcut></shortcut> to bookmark!","dismiss":"Dismiss","shared":"Shared!","buttonAria":"Save or share this puzzle page","buttonTitle":"Save this puzzle","saved":"Saved!","save":"Save"},"languageSwitcher":{"label":"Language","selectLabel":"Select language"},"shareButtons":{"label":"Share","copyLink":"Copy link","copied":"Link copied!","shareMe":"Share me"},"bookmark":{"save":"Bookmark this page","saved":"Saved to bookmarks","labelText":"Bookmark this","hint":"Press Ctrl+D (or ⌘+D on Mac) to bookmark this page"},"purchase":{"premium":{"metaTitle":"Best of 2026 Premium Dot to Dot Puzzle Pack","metaDescription":"A print-ready collection of favorite dot to dot puzzles for kids, bundled into one convenient PDF.","eyebrow":"Premium printable collection","heading":"More puzzles. Less searching. Everything in one convenient PDF.","lede":"The Best of 2026 collection brings our favorite connect-the-dots activities together in one easy-to-print pack for quiet time, rainy days, homeschool, and classrooms.","digitalPdf":"Digital PDF","printAtHome":"Print at home","instantAccess":"Instant access","purchaseAria":"Purchase the Best of 2026 puzzle pack","coverAlt":"Best of 2026 - 25 Dot to Dot Puzzles book cover","oneTime":"one time","buyButton":"Get the puzzle pack","localNote":"On localhost, this opens a safe checkout demo and never charges a card.","detailsEyebrow":"Made for easy print-and-play","detailsHeading":"Everything you need for screen-free fun","detailsText":"Download once, keep it handy, and print the activities you want whenever you need them.","benefits":{"onePdf":"One convenient, print-ready PDF","kidFriendly":"Kid-friendly puzzles with varied difficulty","paperSizes":"Works on US Letter and A4 paper","instantAccess":"Instant access after successful payment","classroomUse":"Use at home or in one classroom"},"guaranteeHeading":"Simple, secure, and ready in minutes","guaranteeText":"After checkout, your private download link appears immediately. No subscription and no surprise renewal."},"checkout":{"consent":"I agree to immediate delivery of this digital PDF and understand that, once access begins, the sale is final and non-refundable except where required by law or if the file is not delivered or is defective.","refundPolicy":"Read the refund policy","opening":"Opening checkout...","secureNote":"Secure checkout powered by Stripe. One-time payment. No subscription.","error":"Something went wrong starting checkout. Please try again."},"success":{"metaTitle":"Thank You for Your Purchase","eyebrow":"Payment confirmed","heading":"Thank you! Your purchase is complete.","lede":"Your payment was successful. It may take a few seconds for your purchase to appear on your account."},"cancelled":{"metaTitle":"Checkout Cancelled","eyebrow":"No payment taken","heading":"Checkout cancelled","lede":"No charge was made. You can try again any time."},"download":{"demoTitle":"Local checkout test passed.","demoText":"The real paid success screen shows the PDF download button here. The local demo does not release the private file.","button":"Download your puzzle pack","expires":"This link expires in 24 hours. Save your download somewhere safe.","failed":"We couldn't confirm your purchase yet. If you were charged, please refresh this page in a minute or contact us for help.","preparing":"Preparing your download..."},"ad":{"advertisementAria":"Advertisement: Best of 2026 dot to dot activity book","viewPackAria":"View the Best of 2026 dot to dot puzzle pack","pdfBook":"ΒΙΒΛΙΟ PDF","bookTitle":"Καλύτερα του 2026","packName":"Πακέτο παζλ Dot-to-Dot","puzzleCount":"25 παζλ από τελεία","viewBook":"Προβολή βιβλίου"},"shared":{"specialSale":"Ειδική πώληση","returnToPack":"Return to the puzzle pack","contactUs":"Contact us"}},"config":{"featured_puzzle_slugs":"[\"trex-61-dot-to-dot-puzzle\",\"mermaid-dot-to-dot-puzzle\",\"jellyfish-dot-to-dot-puzzle\",\"cute-puppy-dot-to-dot-puzzle\