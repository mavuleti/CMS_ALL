2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Σπίτι\",\"item\":\"https://dottodotfreeprintables.com/el/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Dinosaurs\",\"item\":\"https://dottodotfreeprintables.com/el/dinosaurs/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Βελοσιράπτορας\",\"item\":\"https://dottodotfreeprintables.com/el/dinosaurs/velociraptor-dot-to-dot-puzzle/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"Βελοσιράπτορας\",\"description\":\"Αυτός ο Βελοσιράπτορας με 54 κουκκίδες χτίζει δεξιότητες αρίθμησης για παιδιά 5-8 ετών με ένα δωρεάν φύλλο. Ο πραγματικός ραπτόρας ήταν φτερωτός κυνηγός στο μέγεθος γαλοπούλας που έτρεχε με 40 χλμ/ώρα — εκτυπώστε το PDF και σχεδιάστε αυτόν τον έξυπνο θηρευτή. Γρήγορο όνομα, σταθερό μολύβι.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"Ψίχουλα","children":[["$","$Lf",null,{"href":"/el/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Σπίτι"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/el/dinosaurs/","children":"Dinosaurs"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"Βελοσιράπτορας"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"/images/velociraptor-puzzle-400.webp","srcSet":"/images/velociraptor-puzzle-400.webp 400w, /images/velociraptor-puzzle-600.webp 600w, /images/velociraptor-puzzle-700.webp 700w, /images/velociraptor-puzzle.webp 540w","sizes":"(max-width: 640px) 92vw, (max-width: 960px) 600px, 540px","alt":"Φτερωτός Βελοσιράπτορας έτοιμος να ορμήσει, σκιαγραφημένος σε 54 τυπωμένες κουκκίδες","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Σημείο προς Σημείο Βελοσιράπτορα — 54 Γρήγορα Σημεία, Δωρεάν PDF"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Συνδέστε τις τελείες για να αποκαλύψετε τον έξυπνο Βελοκιράπτορα — διάσημο από το Τζουράσικ Παρκ! Στην πραγματική ζωή, οι Βελοκιράπτορες ήταν φτερωτοί κυνηγοί στο μέγεθος περίπου μιας γαλοπούλας. Αυτό το φύλλο εργασίας αναπτύσσει δεξιότητες αριθμητικής αλληλουχίας για παιδιά ηλικίας 5–8 ετών."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Δυσκολία 1 από 3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","«Βελοσιράπτορας» σημαίνει γρήγορος κλέφτης — μπορούσε να φτάσει σε ταχύτητα έως και 40 χλμ/ώρα!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],"$L10","$L11",["$","$L12",null,{"title":"Βελοσιράπτορας Σύνδεσμος για Σύνδεση - Δωρεάν PDF","imageUrl":"/images/velociraptor-puzzle.webp","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/el/dinosaurs/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":"Dinosaurs"}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Βελοσιράπτορας"," ",""]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Όλοι νομίζουν ότι ξέρουν πώς μοιάζει ένας Βελοκιράπτορας — αλλά αυτό το παζλ μπορεί να τους εκπλήξει! Ο πραγματικός Βελοκιράπτορας ήταν φτερωτός, περίπου στο μέγεθος μιας μεγάλης γαλοπούλας, και πολύ πιο έξυπνος από τους περισσότερους δεινόσαυρους ξαδέλφους του. Το Χόλιγουντ τον έκανε μεγαλύτερο, αλλά η φύση τον έκανε πιο έξυπνο. Πάρτε ένα μολύβι και γνωρίστε τον πραγματικό σταρ της Κρητιδικής!"}}],[["$","div","1–8",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–8"," — ","Το κεφάλι και οι γνάθοι"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Ξεκινήστε από την κουκκίδα 1 και συνδέστε την με την κουκκίδα 8 για να εντοπίσετε το μακρύ, στενό κρανίο και τις ελαφρώς καμπύλες σιαγόνες. Ο Βελοκιράπτορας είχε ένα ιδιαίτερα λεπτό κεφάλι σε σύγκριση με το σώμα του — τα παιδιά μαθαίνουν να ακολουθούν ένα πιο επίμηκες σχήμα εδώ, το οποίο αποτελεί μια χρήσιμη μετατόπιση από τα στρογγυλά κεφάλια δεινοσαύρων. Η αργή και σταθερή κίνηση κερδίζει σε αυτό το σενάριο."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Ο Βελοκιράπτορας είχε περίπου 80 μικρά, οδοντωτά δόντια σχεδιασμένα για να πιάνουν και όχι να σκίζουν. Μελέτες στην εγκεφαλική του κοιλότητα δείχνουν ότι είχε εξαιρετική όραση και οξεία αίσθηση όσφρησης — κυνηγούσε με την όραση, την όσφρηση και πιθανώς την ακοή, καθιστώντας τον ένα αξιοσημείωτα καλά εξοπλισμένο μικρό αρπακτικό."]}]]}]]}],["$","div","9–20",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["9–20"," — ","Ο Λαιμός και το Φτερωτό Σώμα"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Συνεχίστε από την κουκκίδα 9 έως την κουκκίδα 20 για να χτίσετε τον καμπυλωτό λαιμό και το συμπαγές σώμα. Εδώ είναι που τα παιδιά συχνά αρχίζουν να βλέπουν την πτηνομορφία του Βελοκιράπτορα, κάτι που αποτελεί μια υπέροχη συζήτηση στην τάξη. Οι κουκκίδες καμπυλώνονται ομαλά — ένα καλό σημείο για την εξάσκηση στη συνεπή πίεση του μολυβιού."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Οι παλαιοντολόγοι έχουν βρει εξογκώματα σε σχήμα πτέρνας στα οστά των βραχιόνων του Βελοκιράπτορα — τα ίδια εξογκώματα που βλέπετε στα σύγχρονα φτερά των πτηνών όπου αγκυροβολούν τα φτερά. Ο Βελοκιράπτορας ήταν σχεδόν βέβαιο ότι ήταν καλυμμένος με φτερά, αν και δεν μπορούσε να πετάξει. Είναι ουσιαστικά ένα μικρό, πτηνό που κυνηγάει και δεν πετάει."]}]]}]]}],["$","div","21–32",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["21–32"," — ","Τα χέρια και τα νύχια των χεριών"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Σχεδιάστε τις κουκκίδες 21 έως 32 για τα σχετικά μακριά χέρια και τα χέρια με τρία δάχτυλα. Σε αντίθεση με τα μικροσκοπικά χέρια του Τυραννόσαυρου Ρεξ, ο Βελοκιράπτορας είχε χέρια που μπορούσε πραγματικά να χρησιμοποιήσει — για να κρατιέται και να κινείται στο περιβάλλον του. Τα παιδιά εξασκούνται σε πιο έντονες γωνίες σε αυτό το τμήμα, μιμούμενα το γωνιώδες σχήμα των μπροστινών άκρων που μοιάζει με φτερό πουλιού."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Τα νύχια των χεριών του Βελοκιράπτορα ήταν δυνατά και καμπυλωτά — πολύ χρήσιμα για σφίξιμο και κράτημα. Πρόσφατη έρευνα υποδηλώνει ότι μπορεί να χρησιμοποιούσε τα χέρια του με παρόμοιο τρόπο που τα γεράκια και οι αετοί κάθονται στα κλαδιά σήμερα, πιέζοντας προς τα κάτω με το βάρος του σώματός του."]}]]}]]}],["$","div","33–44",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["33–44"," — ","Τα πόδια και το ειδικό νύχι"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Συνδέστε τις κουκκίδες 33 με 44 για να σχεδιάσετε τα δυνατά πίσω πόδια και το διάσημο δρεπανοειδές νύχι στο δεύτερο δάχτυλο του ποδιού. Τα παιδιά συχνά αναγνωρίζουν αυτό το νύχι από τις ταινίες, γεγονός που το καθιστά ένα ενδιαφέρον τμήμα. Οι κουκκίδες βρίσκονται κοντά η μία στην άλλη εδώ, ενθαρρύνοντας την ακρίβεια και την προσεκτική αναγνώριση αριθμών."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Το εμβληματικό καμπυλωτό νύχι σε κάθε πόδι συγκρατούνταν από το έδαφος όταν ο Βελοκιράπτορας περπατούσε για να το διατηρεί ωραίο και κοφτερό — σαν μια γάτα που κρατάει τα νύχια της τακτοποιημένα! Οι επιστήμονες πιστεύουν τώρα ότι χρησιμοποιούνταν κυρίως για να πιάνει και να κρατάει τα νύχια του και όχι για οτιδήποτε άλλο."]}]]}]]}],["$","div","45–54",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["45–54"," — ","Η άκαμπτη ουρά"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Ολοκληρώστε συνδέοντας τις κουκκίδες 45 έως 54 για να προσθέσετε τη μακριά, άκαμπτη ουρά. Σε αντίθεση με τις εύκαμπτες ουρές των σαυρών, η ουρά του Βελοκιράπτορα κρατιόταν ευθεία προς τα πίσω, λειτουργώντας ως αντίβαρο όταν έτρεχε και στρίβε με ταχύτητα. Ένα σίγουρο, ευθεία φινίρισμα σε ένα δυναμικό παζλ."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Ο Βελοκιράπτορας μπορούσε να φτάσει ταχύτητες περίπου 42 χιλιομέτρων την ώρα — γρήγορη για ένα μικρό αρπακτικό, αν και πιο αργή από την έκδοση του Jurassic Park. Η ουρά του σκληραίνει φυσικά μέσω οστεοποιημένων τενόντων, επιτρέποντάς του να κάνει απότομες στροφές χωρίς να ανατραπεί, σχεδόν σαν ενσωματωμένος σταθεροποιητής."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","trex-61-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/el/dinosaurs/trex-61-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"/images/trex-61-puzzle-400.webp","srcSet":"/images/trex-61-puzzle-400.webp 400w, /images/trex-61-puzzle-600.webp 600w, /images/trex-61-puzzle-700.webp 700w, /images/trex-61-puzzle.webp 420w","sizes":"(max-width: 760px) 92vw, 30vw","alt":"Πανίσχυρος Τυραννόσαυρος Ρεξ που βαδίζει μέσα από 61 αριθμημένες κουκκίδες, δω