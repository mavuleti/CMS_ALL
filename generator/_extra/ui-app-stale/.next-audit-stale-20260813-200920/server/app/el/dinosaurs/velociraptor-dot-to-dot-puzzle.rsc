ος"}],["$","div",null,{"className":"puzzle-meta","children":[["$","span",null,{"children":""}],["$","span",null,{"children":"1–0 τελείες"}]]}],["$","$Lf",null,{"href":"/el/dinosaurs/brontosaurus-dot-to-dot-puzzle/","className":"download-link","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":15,"height":15,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true","children":[["$","path","r04s7s",{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"}],"$undefined"]}]," ","Προβολή & Λήψη"]}]]}]]}]]}]]}],["$","section",null,{"className":"section","style":{"paddingTop":0,"maxWidth":800},"children":["$","p",null,{"dangerouslySetInnerHTML":{"__html":"Φανταστική δουλειά! Ζωγράφισες έναν από τους πιο παρεξηγημένους δεινόσαυρους στην ιστορία. Γιατί να μην ψάξεις πώς έμοιαζε στην πραγματικότητα ο Βελοκιράπτορας σε σύγκριση με την κινηματογραφική εκδοχή; Είναι ένα λαμπρό μάθημα ότι η πραγματική ζωή είναι συχνά πιο ενδιαφέρουσα από τη μυθοπλασία! Γνώρισε περισσότερους προϊστορικούς φίλους στη συλλογή μας <a href=\"/el/dinosaurs/\">εκτυπώσιμες εικόνες δεινοσαύρων από τελεία σε τελεία</a>."}}]}],["$","section",null,{"id":"coloring-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":18},"children":"Βελοσιράπτορας"}],[["$","article","Βελοσιράπτορας: Κλασικά αληθινά χρώματα",{"style":{"marginBottom":28,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--pink-light, #f6a5c0)