2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ContactPage\",\"name\":\"Contact DotToDotFreePrintables\",\"url\":\"https://dottodotfreeprintables.com/es/contact/\",\"mainEntity\":{\"@type\":\"Organization\",\"name\":\"DotToDotFreePrintables\",\"url\":\"https://dottodotfreeprintables.com\",\"email\":\"hellokidsbookworld@gmail.com\"}}"}}],["$","main",null,{"children":["$","section",null,{"className":"section","style":{"maxWidth":"72ch","margin":"0 auto"},"children":[["$","h1",null,{"children":"Contáctanos"}],[["$","p",null,{"children":"La forma más rápida de contactarnos es por correo electrónico: hellokidsbookworld@gmail.com"}],["$","h2",null,{"children":"Lo que nos alegra saber"}],["$","p",null,{"children":[["$","strong",null,{"children":"Peticiones de rompecabezas."}]," ","Cuéntanos qué tema le encanta a tu hijo o a tu clase y el rango de edad aproximado; tus sugerencias influyen mucho en lo que publicamos a continuación."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Correcciones."}]," ","Un punto mal numerado, un problema de impresión o una traducción que se lea de forma extraña: infórmenos y corregiremos la página."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Preguntas sobre el aula y las licencias."}]," ","La impresión para uso personal y en el aula ya es gratuita. Para cualquier otro uso —como republicar, agrupar o utilizar con fines comerciales—, solicite permiso previamente."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Comentario."}]," ","Qué funciona, qué no funciona, qué te gustaría que hubiera más."]}],["$","h2",null,{"children":"Tiempo de respuesta"}],["$","p",null,{"children":"Se trata de una operación pequeña, por lo que las respuestas pueden tardar algunos días. Los informes de corrección tienen prioridad."}],["$","p",null,{"children":"Más información sobre el sitio y quién lo crea: Sobre nosotros."}]]]}]}]]
6:[["$","$L9",null,{"locale":"es"}],false,["$","$a",null,{"fallback":null,"children":["$","$Lb",null,{}]}],"$Lc",["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n(function () {\n  var locales = [\"ar\",\"az\",\"cs\",\"da\",\"de\",\"el\",\"en\",\"es\",\"fa\",\"fi\",\"fr\",\"hr\",\"hu\",\"id\",\"it\",\"ja\",\"ko\",\"lt\",\"lv\",\"nl\",\"no\",\"pl\",\"pt\",\"pt-BR\",\"ro\",\"ru\",\"sk\",\"sl\",\"sv\",\"th\",\"tr\",\"uk\",\"vi\"];\n\n  function switchLocale(nextLocale) {\n    if (!nextLocale || locales.indexOf(nextLocale) === -1) return;\n\n    var parts = window.location.pathname.split('/');\n    if (locales.indexOf(parts[1]) !== -1) {\n      parts[1] = nextLocale;\n    } else {\n      parts.splice(1, 0, nextLocale);\n    }\n\n    window.location.assign(parts.join('/') + window.location.search + window.location.hash);\n  }\n\n  document.addEventListener('change', function (event) {\n    var target = event.target;\n    if (target && target.matches && target.matches('[data-language-select]')) {\n      switchLocale(target.value);\n    }\n  });\n})();\n"}}],false]
