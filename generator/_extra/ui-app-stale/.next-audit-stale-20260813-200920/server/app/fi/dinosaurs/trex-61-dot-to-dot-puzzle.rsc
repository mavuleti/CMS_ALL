2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Kotiin\",\"item\":\"https://dottodotfreeprintables.com/fi/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Dinosaurs\",\"item\":\"https://dottodotfreeprintables.com/fi/dinosaurs/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"T-Rex 61-pistehaaste\",\"item\":\"https://dottodotfreeprintables.com/fi/dinosaurs/trex-61-dot-to-dot-puzzle/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"T-Rex 61-pistehaaste\",\"description\":\"Tämä 61 pisteen T-Rex tarjoaa varmoille laskijoille 6–9-vuotiaille pidemmän yhdistä pisteet -haasteen. T-Rexille kasvoi uusia hampaita koko elämän ajan — tulosta ilmainen PDF, suomalaisten dinosaurusfanien suosikki vuonna 2026. Se, jota kaikki pyytävät.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"Leipäpolku","children":[["$","$Lf",null,{"href":"/fi/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Kotiin"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/fi/dinosaurs/","children":"Dinosaurs"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"T-Rex 61-pistehaaste"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"/images/trex-61-puzzle-400.webp","srcSet":"/images/trex-61-puzzle-400.webp 400w, /images/trex-61-puzzle-600.webp 600w, /images/trex-61-puzzle-700.webp 700w, /images/trex-61-puzzle.webp 540w","sizes":"(max-width: 640px) 92vw, (max-width: 960px) 600px, 540px","alt":"Vahva Tyrannosaurus Rex astumassa ulos 61 numeroidusta pisteestä, ilmainen dinosaurussivu","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"T-Rex Yhdistä Pisteet — 61 Pistettä Esihistoriallista Hauskuutta"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Yhdistä 61 pistettä paljastaaksesi mahtavan Tyrannosaurus Rexin. Tämä tulostettava dinosaurustehtävä antaa itsevarmoille nuorille laskupelaajille pidemmän numerosarjahaasteen samalla kehittäen kynänhallintaa, keskittymistä ja hienomotoriikkaa."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Vaikeusaste 1/3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","T-Rex pystyi korvaamaan hampaitaan koko elämänsä ajan ja kasvattamaan uusia, kun vanhat hampaat katkesivat tai putosivat pois!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],"$L10","$L11",["$","$L12",null,{"title":"T-Rex 61-pistehaaste Yhdistä pisteet - Tulostettava - Ilmainen PDF","imageUrl":"/images/trex-61-puzzle.webp","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/fi/dinosaurs/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":"Dinosaurs"}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["T-Rex 61-pistehaaste"," ",""]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Kuusikymmentäyksi pistettä. Se on todellinen haaste – ja sopiva sellainen, koska Tyrannosaurus Rex oli todellinen jättiläinen. Tämän palapelin ratkaiseminen vie kauemmin kuin useimmat <a href=\"/fi/\">ilmaiset pisteestä pisteeseen -tulostettavat tehtävämme</a>, joten se sopii lapsille, jotka ovat jo oppineet laskemaan yli 50:een ja haluavat jotain isompaa. Etsi piste 1 aivan leuan kärjestä, hengitä syvään ja herätetään dinosaurusten kuningas."}}],[["$","div","1–11",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–11"," — ","Massiivinen pää ja kuono"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Aloita pisteestä 1 hampaallisen leuan kärjessä ja etene ylös ja pään yli pisteeseen 11 niskan tyvessä. Vedot ovat tässä lyhyitä ja kaarevia, mikä tekee tästä lempeän lämmittelyn ennen pitkiä viivoja. Kysy lapseltasi, mitä hän huomaa päässä – se on valtava kaikkeen muuhun verrattuna, eikä se ole sattumaa."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Täysikasvuisen T-Rexin kallo oli noin 1,5 metriä pitkä – useimpien kahdeksanvuotiaiden pidempi. Tutkijat uskovat, että sen purema oli voimakkain kaikista koskaan eläneistä maaeläimistä, niin voimakas, että se pystyi murskaamaan luun."]}]]}]]}],["$","div","12–26",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["12–26"," — ","Selkää pitkin hännänpäähän"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Pisteestä 12 viiva kulkee palapelin takaosaa pitkin ja aina häntää pitkin pisteeseen 26 asti, joka on aivan kärjessä. Tämä on palapelin pisin ja tasaisin osuus. Kannusta yhtä sulavaa liikettä lukuisten pysähdysten ja lähtöjen sijaan – se on erinomaista harjoitusta jatkuvalle kynänkäytön hallinnalle, jota lapset tarvitsevat aloittaessaan yhtenäisen kirjoittamisen."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Häntä muodosti lähes puolet T-Rexin kokonaispituudesta ja siinä oli yli 40 luuta. Se toimi kuin nuorallakävelijän seipä tasapainottaen valtavaa päätä, jotta dinosaurus ei kallistunut eteenpäin kasvoilleen."]}]]}]]}],["$","div","27–35",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["27–35"," — ","Hännän alta lantioon"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Nyt käänny kaksinkerroin taaksepäin. Pisteet 27–35 kulkevat hännän ali lantiota kohti ja jäljittävät tuon mahtavan tasapainopalkin paksua alapintaa. Lasten on laskettava tässä huolellisesti, koska pisteet ovat lähellä toisiaan – nyt on hyvä hetki hidastaa ja tarkistaa jokainen numero ennen piirtämistä."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Lonkasta seisten T-Rex oli noin 3,6 metriä korkea. Sen koko ruumis saattoi venyä jopa 12 metrin pituiseksi kuonosta pyrstön kärkeen – suunnilleen koulubussin pituiseksi."]}]]}]]}],["$","div","36–48",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["36–48"," — ","Voimakkaat jalat ja jalkaterät"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Pisteet 36–48 muodostavat takajalat ja molemmat kynnelliset tassut. Nämä olivat koko eläimen moottori, ja osio palkitsee rohkeita ja itsevarmoja vetoja. Varpaiden välissä on hieman siksak-liikettä, joten se tuo mukanaan myös hienomotorisia harjoituksia juuri silloin, kun lapset luulevat piirtävänsä vain dinosauruksen jalkoja."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Yksi T-Rexin jalanjälki voi olla yli metrin pituinen. Vuosien ajan ihmiset väittelivät siitä, kuinka nopeasti se voi liikkua – nykytutkimukset viittaavat noin 5 km/h kävelyvauhtiin ja lyhyisiin, lähempänä 20 km/h liikkumisnopeuteen. Riittävän nopea."]}]]}]]}],["$","div","49–58",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["49–58"," — ","Vatsa ja nuo pienet käsivarret"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Yhdistä pisteet 49–58 piirtääksesi vatsan, rintakehän ja tunnetusti pienet käsivarret. Jokainen lapsi nauraa näille käsivarsille, ja juuri siksi tämän osan piirtäminen on hauskaa. Viivat vaihtavat suuntaa usein, joten se on palapelin hankalin osa – täydellinen itsevarmoille laskijoille, tämä 61 pisteen sivu on tehty."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Nuo pienet käsivarret olivat vain noin metrin pituisia, mutta silti jokainen niistä pystyi nostamaan noin 180 kiloa. Pieniä kyllä – mutta kukaan ei kutsuisi niitä heikoiksi."]}]]}]]}],["$","div","59–61",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["59–61"," — ","Leuan sulkeminen"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Vain kolme pistettä jäljellä. Yhdistä 59, 60 ja 61 viimeistelläksesi alaleuan ja täydentääksesi mahtavan ääriviivan. Viimeinen viiva laskeutuu aivan pisteen 1 lähelle – tyydyttävä täysi ympyrä, joka osoittaa lapsille, että koko kuva oli yksi jatkuva matka."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"T-Rexin hampaat eivät koskaan loppuneet kesken. Kun yksi katkesi tai kului loppuun, tilalle kasvoi uusi – elinikäinen varasto tikarinteräviä korvaavia hampaita, joista osa on jopa 30 senttimetriä pitkiä juurineen."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","ostriches-dinosaur-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/fi/dinosaurs/ostriches-dinosaur-dot-to-dot-puzzle/","className":"puzzle-image