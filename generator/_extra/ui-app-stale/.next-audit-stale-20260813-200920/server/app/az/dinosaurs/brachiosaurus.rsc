2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Ev\",\"item\":\"https://dottodotfreeprintables.com/az/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Dinosaurs\",\"item\":\"https://dottodotfreeprintables.com/az/dinosaurs/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Braxiozavr\",\"item\":\"https://dottodotfreeprintables.com/az/dinosaurs/brachiosaurus/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"Braxiozavr\",\"description\":\"Braxiozavr kiçik başını hündür boynunun üstündə gəzdirirdi. 5-9 yaşlı uşaqlar üçün hazırlanmış tapmacada bu Yura nəhəngini aşkar etmək üçün 38 nöqtəni birləşdirin.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"Çörək qırıntısı","children":[["$","$Lf",null,{"href":"/az/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Ev"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/az/dinosaurs/","children":"Dinosaurs"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"Braxiozavr"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"38 çap edilə bilən nöqtədə ağacın zirvəsinə çatan qülləli Braxiozavr","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Brachiosaurus Nöqtədən Nöqtəyə — 38-Nöqtəli Yura Nəhəngi"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Yura dövrünün ən hündür, ən dinc dinozavrını çəkmək üçün nöqtələri birləşdirin. Brachiosaurusun zürafə kimi uzun boynu və ön ayaqları əksər evlərdən daha uzun idi. Böyük, mehriban dinozavrları sevən uşaqlar üçün mükəmməl bir nöqtədən nöqtəyə iş vərəqi."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Çətinlik 1 3-dən","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Braxiozavrın çəkisi 60 tona çata bilər - 10 fil qədər!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],["$","p",null,{"className":"asset-note","children":"Download Free PDF – Coming Soon"}],"$L10",["$","$L11",null,{"title":"Braxiozavr Nöqtədən Nöqtəyə Çap Olunan - Pulsuz PDF","imageUrl":"","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/az/dinosaurs/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":"Dinosaurs"}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Braxiozavr"," ",""]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Ön ayaqları iki mərtəbəli binadan hündür olan bir məxluq təsəvvür edin. Bu Brachiosaurus - indiyə qədər mövcud olan ən uzun heyvanlardan biridir. Əksər dinozavrlardan fərqli olaraq, onun ön ayaqları arxa ayaqlarından daha uzun idi və ona qədim ağacların lap zirvələrinə çatmaq üçün mükəmməl, fərqli, zürafəyə bənzəyən bir duruş verirdi. Nöqtələri birləşdirək və bu yüksək incə nəhənglə görüşək!"}}],[["$","div","1–6",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–6"," — ","Kiçik Baş"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Nöqtə 1-dən başlayın və 6-cı nöqtəyə birləşdirin ki, bu fövqəladə boynun ən yuxarı hissəsində yerləşən kiçik, qutu başını izləyin. Brontosaurus kimi, Brachiosaurus da bədən ölçüsünə görə nisbətən kiçik bir başı var idi. Uşaqlar burada yığcam, bir-birinə yaxın nöqtələrlə məşq edirlər - böyük tapmaca üçün dəqiq başlanğıcdır."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Brachiosaurus burun dəlikləri başının üstündə, gözlərinin yaxınlığında yerləşirdi. Elm adamları bir dəfə bunun onun su altında begemot kimi yaşadığını, dərinliklərdən şnorkellə üzdüyünü düşünmüşdülər. İndi biz onun tamamilə quru heyvanı olduğunu bilirik - bu yüksək burun dəlikləri sadəcə kəllə formasının qəribəliyi idi."]}]]}]]}],["$","div","7–18",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["7–18"," — ","Uca Boyun"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Uzun boynu dik bir açı ilə yuxarıya doğru süpürmək üçün 7-ci nöqtədən 18-ci nöqtəyə qədər davam edin. Bu, tapmacanın ən dramatik hissəsidir - Brontosaurusun daha üfüqi boyundan fərqli olaraq boyun kəskin şəkildə yüksəlir. Uşaqlar karandaşlarını cəsarətlə yuxarıya doğru çevirməyi öyrənirlər ki, bu da əsl inam tələb edir."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Brachiosaurus 40 fut hündürlüyə çata bilər - dördüncü mərtəbənin pəncərəsinə baxacaq qədər hündür! Qanın bu boyuna qədər pompalanması böyük bir ürək tələb edirdi. Elm adamları onun ürəyinin təxminən 400 funt ağırlığında olduğunu təxmin edirlər - böyük bir motosiklet mühərriki qədər ağırdır."]}]]}]]}],["$","div","19–30",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["19–30"," — ","Bədən"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Böyük, barel formalı gövdəni doldurmaq üçün 19-dan 30-a qədər nöqtələri çəkin. Diqqət yetirin ki, arxa hündür ön çiyinlərdən qısa ombalara qədər aşağıya doğru necə enir - əksər sauropodların əksinə. Bu maili arxa Brachiosaurusun ən fərqli xüsusiyyətlərindən biridir və onu aşkar etmək əla bir müşahidə məşqidir."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Brachiosaurusun çəkisi 60 tona qədər - on Afrika fili qədər ağır ola bilər. Bu qeyri-adi kütləni doldurmaq üçün hər gün 880 funt-a qədər bitki yeməli idi. Bu, təxminən 1760 kisə salat yeməyə bərabərdir. Hər. Subay. gün."]}]]}]]}],["$","div","31–38",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["31–38"," — ","Dörd Qüdrətli Ayaq"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Bütün dörd ayağı çəkmək üçün 31-dən 38-ə qədər nöqtələri birləşdirərək bitirin. Ön ayaqlar arxa ayaqlardan nəzərəçarpacaq dərəcədə uzun və dikdir - diqqətlə baxan uşaqlar bu yamacı görəcəklər. Səkkiz nöqtə, tapmacanın son hissəsində təfərrüata diqqəti cəlb edən, diqqəti cəlb edən, təltifedici bir bitirmədir."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Hər bir Brachiosaurus ayağının beş barmağı var idi, hər bir ön ayağın daxili barmağında bir böyük pəncəsi var idi. Ayaqları geniş və yuvarlaq idi, altında qalın ətli yastıq var idi - fil ayağı kimi - heyvanın böyük çəkisini yumşaq Yura torpağına yaymaq üçün hazırlanmışdır."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Dinosaurs"}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","trex-61-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/az/dinosaurs/trex-61-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"/images/trex-61-puzzle-400.webp","srcSet":"/images/trex-61-puzzle-400.webp 400w, /images/trex-61-puzzle-600.webp 600w, /images/trex-61-puzzle-700.webp 700w, /images/trex-61-puzzle.webp 420w","sizes":"(max-width: 760px) 92vw, 30vw","alt":"Qüdrətli Tirannozavr Reks 61 nömrəli nöqtənin arasından tapdalanır, pulsuz dinozavr vərəqi","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","children":[["$","p",null,{"className":"puzzle-category","children"