0,0.18)","verticalAlign":"middle","marginInlineEnd":6}}],"クレヨラ ダンデライオン"," — 多くのジャスミンの花は、それぞれの星の中心に小さく明るい黄色の喉部分を見せています。"]}],["$","li","定番の白い星形ジャスミン-20–39-星形の花びら",{"children":[["$","strong",null,{"children":["20–39"," (星形の花びら)",":"]}]," ",["$","span",null,{"aria-hidden":"true","style":{"display":"inline-block","width":34,"height":14,"borderRadius":7,"background":"#CDC5C2","border":"1px solid rgba(0,0,0,0.18)","verticalAlign":"middle","marginInlineEnd":6}}],"白のまま残し、クレヨラ シルバーで輪郭を描く"," — オオバナソケイはくっきりとした白い星形の花を咲かせます。"]}],["$","li","定番の白い星形ジャスミン-40–58-満開の花",{"children":[["$","strong",null,{"children":["40–58"," (満開の花)",":"]}]," ",["$","span",null,{"aria-hidden":"true","style":{"display":"inline-block","width":34,"height":14,"borderRadius":7,"background":"#CDC5C2","border":"1px solid rgba(0,0,0,0.18)","verticalAlign":"middle","marginInlineEnd":6}}],"白のまま残し、クレヨラ シルバーで輪郭を描く"," — 白い花が満開に集まった様子が、一般的にイメージされるジャスミンの姿です。"]}],["$","li","定番の白い星形ジャスミン-59–78-つる状の茎",{"children":[["$","strong",null,{"children":["59–78"," (つる状の茎)",":"]}]," ",["$","span",null,{"aria-hidden":"true","style":{"display":"inline-block","width":34,"height":14,"borderRadius":7,"background":"#5FA777","border":"1px solid rgba(0,0,0,0.18)","verticalAlign":"middle","marginInlineEnd":6}}],"クレヨラ フォレストグリーン"," — ジャスミンはつる性植物で、緑色の茎を支えに絡みつきながら伸びます。"]}],["$","li","定番の白い星形ジャスミン-79–97-残りの葉と仕上げ",{"children":[["$","strong",null,{"children":["79–97"," (残りの葉と仕上げ)",":"]}]," ",["$","span",null,{"aria-hidden":"true","style":{"display":"inline-block","width":34,"height":14,"borderRadius":7,"background":"#1CAC78","border":"1px solid rgba(0,0,0,0.18)","verticalAlign":"middle","marginInlineEnd":6}}],"クレヨラ グリーン"," — つやのある緑の葉が、つるに沿って小さな集まりで育ちます。"]}]]}]]}],["$","article","ピンクジャスミン",{"style":{"marginBottom":28,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--pink-light, #f6a5c0)"},"children":[["$","h3",null,{"style":{"fontSize":"1.05rem","fontWeight":800,"marginBottom":6},"children":"ピンクジャスミン"}],["$","p",null,{"style":{"color":"v