e:["$","$L15",null,{"formats":"$undefined","locale":"ko","messages":{"nav":{"scanMe":"스캔해 주세요","blog":"블로그","search":"찾다","kids":"어린이용 퍼즐","teachers":"선생님들","parents":"부모","contact":"저희에게 연락하세요","freePack":"무료 패키지"},"homepageUi":{"title":"완벽한 점 잇기 프린트물을 찾아보세요","description":"인쇄하고 점을 이어 멋진 그림을 완성하세요. 무료로 바로 즐길 수 있어요!","searchPlaceholder":"바다, 공룡, 꽃 등을 검색해보세요","filterPuzzles":"퍼즐 필터링","age":"연령","dots":"점","featuredPuzzles":"추천 인쇄용 퍼즐","savePuzzle":"{name} 저장","removeSavedPuzzle":"{name}을(를) 저장 목록에서 삭제","downloads":"다운로드","bookTitle":"2026 베스트 · {count}","bookDescription":"가장 인기 있는 점 잇기 퍼즐을 하나의 인쇄용 PDF 책으로 모았어요.","searchUnavailable":"검색을 일시적으로 사용할 수 없습니다. 다시 시도해 주세요.","popularEyebrow":"이번 주 인기","mostDownloaded":"가장 많이 다운로드된 퍼즐","downloadCountAria":"{count}회 이상 다운로드","freshPrintables":"신선한 인쇄물","recentlyAdded":"최근 추가됨","browseCategories":"퍼즐 카테고리 탐색","openCategories":"카테고리 메뉴 열기","closeCategories":"카테고리 메뉴 닫기","browseByTheme":"테마별 탐색","quickLinks":"빠른 링크","bundlePacks":"번들 팩","parentsTeachers":"부모 및 교사를 위한","more":"더 많은 카테고리","kids":"어린이","categoryNames":{"cute":"귀여운 퍼즐","flowers":"꽃"}},"audience":{"kidsTitle":"어린이들을 위해","kidsText":"귀여운 동물, 공룡, 탈것 테마에 숫자가 적힌 점들이 있어 쉽게 승리하며 자신감을 키울 수 있습니다.","parentsTitle":"부모님들을 위해","parentsText":"집, 여행, 식당에서 화면 없이 조용히 시간을 보낼 수 있는 활동들. 어떤 기기에서든 1분 안에 인쇄 가능.","teachersTitle":"교사들을 위한 자료","teachersText":"아침 활동, 조기 학습자, 대리 교사, 교실 활동 등에 활용하기 좋은 간편한 점 잇기 활동지입니다. 별도의 준비가 필요 없습니다."},"categories":{"eyebrow":"주제별 및 난이도별로 정리되어 있습니다.","heading":"카테고리별 점 잇기 퍼즐을 찾아보세요","description":"유아를 위한 간단한 10점 도형부터 좀 더 큰 아이들을 위한 200점 챌린지까지, 소근육 발달에 좋은 학습지 무료 자료를 카테고리별로 분류해두어 원하는 점잇기 도안을 몇 초 만에 찾을 수 있습니다.","puzzles":"{count, plural, one {# 퍼즐} other {# 퍼즐}}","comingSoon":"곧 출시 예정","badges":{"dinosaurs":"지금 바로 구매 가능!","ocean":"지금 바로 구매 가능!","playgrounds":"지금 바로 구매 가능!","garden":"지금 바로 구매 가능!","usa250":"새로운!","uae":"지금 바로 구매 가능!","cute":"새로운!","circus":"새로운!"},"items":{"dinosaurs":{"name":"공룡","description":"선사시대의 재미 속으로 뛰어들어 보세요! 티라노사우루스, 트리케라톱스, 벨로시랩터, 그리고 {count}까지, 아이들이 정말 좋아할 무료 점 잇기 퍼즐을 즐겨보세요."},"animals":{"name":"동물","description":"숫자 학습에 도움이 되는 친근한 동물 캐릭터들."},"vehicles":{"name":"차량","description":"자동차, 트럭, 로켓, 그리고 기계들."},"fantasy":{"name":"공상","description":"성, 유니콘, 용, 그리고 이야기 소재들."},"seasonal":{"name":"계절별","description":"휴일 및 학급 활동 달력."},"ocean":{"name":"대양","description":"바다 동물과 평온함을 담은 색칠 페이지."},"playgrounds":{"name":"놀이터","description":"꼬마 모험가들을 위한 그네, 미끄럼틀, 그리고 야외 놀이 시설."},"garden":{"name":"정원","description":"정원 가꾸기를 좋아하는 어린이들을 위한 장갑, 흙손, 그리고 각종 도구들."},"usa250":{"name":"미국 250년","description":"미국의 250주년 생일을 기념하여 미국 역사를 기리는 애국적인 점 잇기 퍼즐을 즐겨보세요."},"uae":{"name":"아랍에미리트","description":"아랍에미리트를 탐험해 보세요! 부르즈 알 아랍과 같은 상징적인 랜드마크를 만나고 색칠하며 즐거운 시간을 보내세요."},"space":{"name":"공간","description":"행성, 우주비행사, 그리고 로켓 모험."},"worksheets":{"name":"워크시트","description":"교사가 바로 사용할 수 있는 숫자 순서 배열 활동지입니다."},"bigDotBooks":{"name":"빅닷북스","description":"집중력이 뛰어난 고학년 학습자를 위한 장문형 퍼즐."},"cute":{"name":"귀여운","description":"사랑스러운 강아지, 귀여운 자동차, 그리고 아이들이 좋아할 만한 매력적인 무료 점 잇기 퍼즐 {count} ."},"circus":{"name":"서커스","description":"링마스터, 대형 천막, 어린 학습자를 위한 쇼타임 재미."}}},"puzzleSection":{"eyebrow":"무료로 인쇄 가능한 샘플 - 가입 필요 없음","heading":"지금 바로 인쇄할 수 있는 인기 점 잇기 활동지","weeklyPack":"주간 패키지 보기 →","downloadLink":"무료 인쇄용 파일을 다운로드하세요","new":"새로운","imageAlt":"{name} 점 잇기 무료 인쇄용 워크시트 ({age}용)","categories":{"Dinosaurs":"공룡","Ocean":"대양","Playgrounds":"놀이터","Garden":"정원","Cute":"귀여운","USA 250 Years":"미국 250년","UAE":"아랍에미리트"},"items":{"trex-61-dot-to-dot-puzzle":{"name":"티라노사우루스 61점 챌린지"},"brontosaurus-dot-to-dot-puzzle":{"name":"브론토사우루스"},"mermaid-dot-to-dot-puzzle":{"name":"인어"},"merman-dot-to-dot-puzzle":{"name":"인어"},"seahorse-dot-to-dot-puzzle":{"name":"해마"},"whale-dot-to-dot-puzzle":{"name":"고래"},"swing-playgrounds-dot-to-dot-puzzle":{"name":"그네 놀이터"},"slide-playgrounds-dot-to-dot-puzzle":{"name":"미끄럼틀 놀이터"},"seesaw-playground-dot-to-dot-puzzle":{"name":"시소 놀이터"},"roller-coaster-playground-dot-to-dot-puzzle":{"name":"롤러코스터 놀이터"},"wheelbarrow-playground-dot-to-dot-puzzle":{"name":"손수레 놀이터"},"garden-gloves-dot-to-dot-puzzle":{"name":"정원용 장갑"},"garden-trowel-dot-to-dot-puzzle":{"name":"정원용 흙손"},"gas-balloon-usa-250-dot-to-dot-puzzle":{"name":"가스 벌룬 아메리카 250"},"america-250-birthday-fireworks-dot-to-dot-puzzle":{"name":"미국 건국 250주년 기념 불꽃놀이"},"america-250-anniversary-liberty-bell-wings-1776-dot-to-dot-puzzle":{"name":"미국 250 자유의 종 날개"},"usa-250-astronaut-dot-to-dot-puzzle":{"name":"미국 우주비행사 250인"},"usa-250-anniversary-sports-kids-podium-dot-to-dot-puzzle":{"name":"미국 건국 250주년 기념 스포츠 키즈 포디움"},"usa-250-anniversary-airplane-banner-dot-to-dot-puzzle":{"name":"미국 건국 250주년 기념 비행기 배너"},"usa-250-space-shuttle-dot-to-dot-puzzle":{"name":"미국 250 우주 셔틀"},"usa-250-birthday-balloons-stars-dot-to-dot-puzzle":{"name":"미국 건국 250주년 기념 풍선과 별 장식"},"usa-250-birthday-cake-dot-to-dot-puzzle":{"name":"미국 건국 250주년 기념 케이크"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"아메리카 250 이글 배너"},"burj-al-arab-dot-to-dot-puzzle":{"name":"부르즈 알 아랍"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"달라 커피포트"}}},"benefits":{"eyebrow":"유아교육 전문가들의 지지를 받습니다","heading":"점 잇기 활동지가 아동 발달에 좋은 이유","description":"점 잇기 활동지는 단순한 재미를 넘어, 유아원과 유치원 교사들이 핵심적인 조기 학습 능력을 키우는 데 사용하는 연구 기반 도구입니다.","fineMotorTitle":"소근육 발달에 도움을 줍니다.","fineMotorText":"점선 잇기 그림 그리기는 연필 잡는 자세, 손과 눈의 협응력, 그리고 글쓰기에 필요한 근육 조절 능력을 발달시키는 데 도움이 됩니다.","numberTitle":"숫자 인식 능력을 강화합니다","numberText":"점 1 → 2 → 3을 순서대로 따라가면 놀이를 통해 자연스럽게 숫자 세기, 숫자 인식 및 기초 수학 개념을 배울 수 있습니다.","focusTitle":"집중력과 주의력을 향상시켜줍니다.","focusText":"점 잇기 퍼즐을 완성하려면 지속적인 집중력이 필요합니다. 이는 유치원부터 초등학교 3학년까지 아이들이 차분하고 화면 없이 집중력을 연습할 수 있는 좋은 방법입니다.","confidenceTitle":"즉각적인 보상과 자신감","confidenceText":"숨겨진 그림이 나타나면 아이들은 즉각적인 성취감을 느낍니다. 완성한 그림에 색칠공부까지 이어가면 성취감이 배가되며, 이러한 작은 성공은 학습에 대한 애정과 성장 마인드를 키워줍니다."},"howTo":{"eyebrow":"60초 안에 준비 완료","heading":"무료 점 잇기 워크시트를 다운로드하고 인쇄하는 방법","step1Title":"퍼즐을 선택하세요","step1Text":"테마(동물, 공룡, 탈것, 명절 등)를 선택하고 자녀의 나이와 실력에 맞는 점의 개수 범위를 고르세요.","step2Title":"무료 PDF 파일을 다운로드하세요","step2Text":"\"무료 인쇄용 파일 다운로드\"를 클릭하세요. 계정 등록, 이메일 입력, 결제 없이 바로 PDF 파일을 다운로드할 수 있습니다.","step3Title":"인쇄해서 즐기세요","step3Text":"미국 표준 레터 용지(8.5\" × 11\")에 인쇄하세요. 흑백으로 인쇄하면 가장 좋습니다. 아이에게 주고 점들을 연결하는 모습을 지켜보세요!"},"trust":{"eyebrow":"학부모와 교사가 저희를 선택하는 이유","heading":"무료이고 안전하며 사용하기가 매우 쉽습니다.","noAccountTitle":"계정 필요 없음","noAccountText":"모든 점 잇기 인쇄물은 즉시 다운로드됩니다. 회원가입, 이메일 입력, 결제 없이 바로 다운로드할 수 있습니다. 클릭 한 번으로 인쇄하세요.","safeTitle":"교실 금고","safeText":"학교 프린터용으로 디자인된 깔끔하고 광고 없는 퍼즐 페이지입니다. 아침 활동, 숙제 또는 자율 학습 시간에 활용하기 좋습니다.","fastTitle":"빠른 속도를 목표로 설계됨","fastText":"정적 페이지, 최적화된 이미지 및 로컬 글꼴 덕분에 퍼즐은 휴대폰, 태블릿 또는 노트북 등 모든 기기에서 빠르게 로드됩니다."},"faq":{"eyebrow":"자주 묻는 질문","heading":"자주 묻는 질문","q1":"이 사이트에 있는 점 잇기 그림 자료는 모두 완전히 무료인가요?","a1":"네, DotToDotFreePrintables.com의 모든 점 잇기 워크시트는 100% 무료로 다운로드하고 인쇄할 수 있습니다. 계정, 구독 또는 신용 카드 정보는 전혀 필요하지 않습니다.","q2":"점 잇기 활동지는 몇 살 아이들에게 적합할까요?","a2":"저희 학습 자료는 2세부터 12세까지 다양한 연령대를 위한 것입니다. 쉬운 문제지(점 10~20개)는 유아와 미취학 아동에게 적합하고, 중간 난이도 문제지(점 20~50개)는 유치원생과 초등학교 1학년에게, 어려운 문제지(점 50~200개 이상)는 초등학교 2학년부터 6학년 학생들에게 도전 과제가 될 수 있습니다.","q3":"점 잇기 활동지는 어떤 형식으로 되어 있나요?","a3":"모든 학습지는 표준 미국 레터 용지(8.5\" × 11\") 크기의 인쇄용 PDF 파일로 다운로드됩니다. 어떤 웹 브라우저나 PDF 뷰어에서든 열어서 바로 인쇄할 수 있으며, 특별한 소프트웨어는 필요하지 않습니다.","q4":"미취학 아동 및 유치원생을 위한 점 잇기 활동지가 있나요?","a4":"물론입니다. 저희의 가장 쉬운 학습지는 1~10개의 점으로 구성되어 있어 (2~4세 아동에게 적합) 유아원 및 유치원 교실에 맞춰 알파벳과 숫자 인식을 주제로 하고 있습니다.","q5":"선생님들이 수업 시간에 이 점 잇기 활동지를 사용할 수 있을까요?","a5":"네! 저희 인쇄용 자료는 개인 및 교실에서 무료로 사용하실 수 있습니다. 아침 활동, 조기 학습자 활동, 대리 교사 수업 계획, 소근육 발달 센터, 숙제 등으로 많이 활용되고 있습니다.","q6":"점 잇기 퍼즐은 소근육 발달에 도움이 될까요?","a6":"네, 점들을 연결하는 활동은 연필 잡는 힘과 손과 눈의 협응력을 길러주어 글쓰기 준비에 도움이 됩니다. 많은 작업 치료사와 유치원 교사들이 이러한 이유로 점 잇기 활동을 권장합니다.","q7":"동물이나 공룡처럼 특정 주제를 다룬 점 잇기 그림 자료가 있나요?","a7":"동물, 공룡, 탈것, 해양 생물, 놀이터, 미국 250주년, 우주, 판타지, 계절/휴일 테마, 교사용 워크시트 팩, 빅 도트 북 등 11가지 카테고리가 있습니다. 새로운 디자인은 매주 추가됩니다.","q8":"이 퍼즐들을 흑백으로 인쇄할 수 있을까요?","a8":"네, 저희 점 잇기 활동지는 모두 잉크 절약을 위해 흑백 인쇄용으로 제작되었습니다. 가정이나 교실 프린터 어디에서든 깔끔하게 인쇄됩니다."},"newsletter":{"eyebrow":"인쇄 가능한 스타터 팩 - 완전 무료","heading":"엄마표 홈스쿨링을 위한 점 잇기 도안 20개를 무료로 이메일로 받아보세요.","description":"동물, 탈것, 공룡, 계절 테마 등 다양한 주제를 다룬 이 컬렉션은 점 잇기와 색칠공부를 한 번에 즐길 수 있어 학부모와 교사 모두에게 유용하며, 모든 디자인은 표준 미국 레터 용지 크기에 맞춰 제작되었고 흑백 인쇄에 최적화되어 있습니다."},"blog":{"eyebrow":"어른들을 위한 아이디어","heading":"가정 및 교실 학습 팁","viewAll":"모든 기사 보기","read":"읽다"},"feedback":{"eyebrow":"여러분의 의견을 기다립니다.","heading":"피드백 보내기","description":"퍼즐 아이디어가 있거나, 깨진 링크를 발견했거나, 아니면 그냥 인사하고 싶으신가요? 아래에 메시지를 남겨주세요."},"footer":{"description":"어린이, 학부모, 선생님을 위한 무료 점 잇기 프린트와 점 잇기 색칠공부 워크시트입니다. 엄마표 홈스쿨링부터 유치원·초등학교 수업까지, 모든 퍼즐은 무료로 다운로드, 인쇄, 공유할 수 있습니다.","kids":"어린이","parents":"부모","teachers":"선생님들","blog":"블로그","faq":"자주 묻는 질문","feedback":"피드백","about":"에 대한","contact":"연락하다","privacy":"은둔","terms":"자귀","sitemap":"사이트맵","copyright":"© {year} DotToDotFreePrintables.com · 어린이를 위한 무료 인쇄용 활동지"},"common":{"home":"집","new":"새로운","comingSoon":"곧 출시 예정","downloadFree":"무료 인쇄용 파일을 다운로드하세요","viewDownload":"보기 및 다운로드","shareTitle":"{name} 점선 연결 인쇄물 - 무료 PDF","downloadAria":"무료 {name} 점선 연결 인쇄물 PDF 다운로드","bookmarkTitle":"{name} 점선 연결 인쇄물 – 어린이를 위한 무료 PDF","showSlide":"슬라이드 {number} 보여주기","ageRange":"{min}-{max} 연령","difficultyLabel":"난이도 {level} (3점 만점)","difficulty":{"1":"쉬운","2":"중간","3":"딱딱한"},"dots":"1–{count} 점","homeVideoEyebrow":"동영상","homeVideoH2":"점 잇기 놀이의 재미를 영상으로 확인하세요","skipToContent":"주 콘텐츠로 건너뛰기","joinTeachers":"{count}+ 교사 참여하기","breadcrumbAria":"빵 부스러기"},"puzzleSearch":{"placeholder":"Search by name or topic... e.g. ocean, whale, T-Rex","searchAria":"퍼즐 찾기","clearSearch":"Clear search","toggleFilters":"Toggle filters","filters":"Filters","filterOptions":"Filter options","topic":"Topic","numberOfDots":"Number of dots","recentlyAddedOnly":"Recently added only","clearAllFilters":"Clear all filters","clearFilters":"Clear filters","resultsFound":"{count, plural, one {# 퍼즐을 찾았습니다} other {# 퍼즐 발견}}","puzzlesAvailable":"{count, plural, one {# puzzle available} other {# puzzles available}}","noMatches":"검색 조건과 일치하는 퍼즐이 없습니다.","openPuzzle":"Open {name}","imageAlt":"{name} 점 잇기 인쇄 가능","viewPuzzle":"View puzzle →","dotRanges":{"under35":"Under 35 dots","35to50":"35-50 dots","51to70":"51-70 dots","over70":"70+ dots"},"categories":{"Dinosaurs":"Dinosaurs","Ocean":"Ocean","Playgrounds":"Playgrounds","Garden":"Garden","Cute":"Cute","USA 250 Years":"America 250 Years","UAE":"UAE"}},"newsletterForm":{"ariaLabel":"무료 점 잇기 프린트물 팩을 받으세요","emailLabel":"이메일 주소","submit":"무료 패키지 보내기","honeypot":"이 필드를 비워 두세요","privacy":"스팸 메일은 절대 보내지 않습니다. 언제든지 구독을 취소할 수 있습니다.","error":"이 양식을 제출할 수 없습니다.","notConnected":"무료 패키지 가입은 아직 연결되지 않았습니다."},"feedbackForm":{"ariaLabel":"피드백 보내기","notConnected":"이 피드백 양식은 아직 연결되지 않았습니다.","typeLabel":"어떤 종류의 피드백인가요?","selectTopic":"주제를 선택하세요...","types":{"general":"일반적인 피드백","requestTheme":"퍼즐 테마를 요청하세요","brokenLink":"깨진 링크를 신고하세요","improvement":"개선 사항을 제안해 주세요","other":"다른"},"messageLabel":"귀하의 메시지","messagePlaceholder":"여러분의 생각을 말씀해 주세요...","emailLabel":"이메일","emailOptional":"(선택 사항 - 답변을 원하시는 경우에만 작성해 주세요)","submit":"피드백 보내기","success":"감사합니다. 고객님의 의견이 전달되었습니다.","disclaimer":"민감한 개인 정보는 포함하지 마십시오. 이메일 주소는 선택 사항이며, 답변이 필요한 경우에만 사용됩니다.","iframeTitle":"피드백 제출"},"contactPage":{"title":"Contact Us","intro":"The fastest way to reach us is email:","topicsTitle":"What we're happy to hear about","requestsTitle":"Puzzle requests.","requests":"Tell us a theme your child or class loves and the rough age range — requests genuinely shape what we publish next.","correctionsTitle":"Corrections.","corrections":"A misnumbered dot, a printing problem, a translation that reads oddly — report it and we will fix the page.","licensingTitle":"Classroom and licensing questions.","licensing":"Personal and classroom printing is already free. For anything beyond that — republishing, bundling, or commercial use — ask first.","licensingNote":"(see our <link>terms of use</link>).","feedbackTitle":"Feedback.","feedback":"What works, what doesn't, what you would like more of.","responseTitle":"Response time","response":"This is a small operation, so replies can take a few days. Correction reports get priority.","aboutPrefix":"More about the site and who makes it:","aboutLink":"about us"},"puzzleDetail":{"agesLabel":"Ages:","dotsLabel":"Dots:","freeLabel":"100% Free","difficultyHeading":"Difficulty","difficultyEasy":"Easy","difficultyMedium":"Medium","difficultyHard":"Hard","funFactPrefix":"Fun fact:","funFactLabel":"Fun fact!","noSignUp":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use.","comingSoon":"Download Free PDF – Coming Soon","youMightLike":"You might also like","faqQ1":"What age is the {name} dot to dot puzzle for?","faqA1":"It is designed for ages {age}. With {dots} dots, it suits children who can confidently count to {dots}; younger children can complete it with a little help.","faqQ2":"How do I print the {name} worksheet?","faqA2":"Click the download button to get the free PDF, then print it on regular paper (A4 or US Letter) from any browser or PDF reader. No special software is needed.","faqQ3":"Is the {name} printable really free?","faqA3":"Yes — it is 100% free, with no sign-up, account, or payment required. You may print it for home or classroom use."},"blogPage":{"eyebrow":"Learning resources","h1":"Dot to Dot Ideas for Parents and Teachers","description":"Practical guides for choosing activities, building early learning skills, and using printable worksheets at home or in the classroom.","breadcrumb":"Blog","latestEyebrow":"Latest articles","latestH2":"Helpful ideas you can use today","readArticle":"Read article","by":"By","backToAll":"← Back to all articles","savePinterest":"Save to Pinterest","relatedEyebrow":"Free printables","relatedHeading":"Try these dot to dot collections next"},"downloadButton":{"label":"Download Free Printable PDF","usage":"Free for home and classroom use.","paperNote":"Sized for {size} paper.","paperLetter":"US Letter","paperA4":"A4","alternateLink":"Prefer {size}? Download that version","downloadSize":"Download (Print Size: {size})"},"downloadBadge":{