점 만점)","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","세계에서 가장 높은 고정식 놀이터 미끄럼틀은 길이가 30미터가 넘는데, 이는 10층 건물 높이와 거의 같습니다!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],"$L10","$L11",["$","$L12",null,{"title":"미끄럼틀 놀이터 점선 연결 인쇄물 - 무료 PDF","imageUrl":"/images/playgrounds-playhouse-slide-puzzle.webp","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/ko/playgrounds/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":"Playgrounds"}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["미끄럼틀 놀이터"," ",""]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"놀이터에서 그네가 최고라면 미끄럼틀은 그에 못지않게 인기 만점입니다. 미끄럼틀에 올라가 앉아서 중력에 몸을 맡기는 그 매력은 이루 말할 수 없죠. 이 102개의 점으로 이루어진 퍼즐은 뒤쪽 사다리에서 앞쪽 곡선 경사로까지 이어지는 높고 고전적인 놀이터 미끄럼틀을 표현합니다. 가장 쉬운 놀이터 퍼즐보다 점이 더 많으니, 조금 더 인내심을 발휘해 보세요. 첫 번째 점을 찾아서, 이제 올라가고 싶은 미끄럼틀을 만들어 봅시다!"}}],[["$","div","1–14",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–14"," — ","사다리"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"1번 점부터 시작하여 20번 점까지 연결하여 미끄럼틀 플랫폼으로 이어지는 높은 사다리를 그리세요. 이 부분은 대부분 직선으로 이루어져 있고 간격도 일정하므로, 앞으로 나올 곡선을 그리기 전에 안정적이고 정확한 연필 획 연습을 하기에 좋습니다."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"놀이터 사다리는 어린아이의 발이 안전하게 다음 발판에 닿을 수 있도록 발판 간격이 충분히 좁게 만들어져 있습니다. 보통 30cm 정도 간격으로 되어 있어 가정용 사다리보다 훨씬 좁습니다."]}]]}]]}],["$","div","15–28",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["15–28"," — ","플랫폼"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"21번 점부터 40번 점까지 이어서 꼭대기에 평평한 플랫폼을 그려주세요. 이곳은 등반가들이 미끄럼틀을 타고 내려가기 전에 잠시 쉬는 곳입니다. 아이들은 이 부분을 통해 수평선과 수직선을 깔끔한 직각으로 연결하는 연습을 할 수 있습니다. 이는 구조와 비례 감각을 기르는 데 좋은 연습이 됩니다."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"대부분의 놀이터 플랫폼은 최소 3면에 안전 난간이 설치되어 있고 미끄럼틀 입구만 개방되어 있습니다. 이러한 설계 특징 하나만으로도 놀이터 안전 지침의 표준이 된 이후 플랫폼 추락 사고가 크게 줄어든 것으로 평가받고 있습니다."]}]]}]]}],["$","div","29–41",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["29–41"," — ","미끄럼틀 꼭대기"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"41번부터 60번까지의 점을 따라가면서 미끄럼틀과 플랫폼이 만나는 곡선 부분을 만들어 보세요. 바로 이 부분이 재미가 시작되는 지점입니다. 보기보다 곡선이 가파르므로 빠르게 쓱쓱 그리기보다는 천천히 신중하게 그려주세요."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"미끄럼틀 맨 위쪽의 첫 번째 곡선 부분을 '스타터 커브'라고 하는데, 이 부분은 탑승자가 직선으로 떨어지는 것이 아니라 속도를 조절하여 미끄러져 내려가는 속도를 제어하기 위해 특별히 각도를 조정한 것입니다."]}]]}]]}],["$","div","42–55",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["42–55"," — ","롱 슈트"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"61번부터 85번까지의 점들을 연결하여 길고 완만한 미끄럼틀을 그려보세요. 이 부분이 퍼즐에서 가장 크고 만족스러운 부분입니다. 여러 개의 짧은 선보다는 하나의 부드럽고 끊김 없는 선으로 그리는 것이 미끄럼틀에 속도감을 더해줍니다."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"현대 놀이터 미끄럼틀은 금속보다는 회전 성형 플라스틱으로 만들어지는 경우가 거의 대부분입니다. 금속 미끄럼틀은 여름철 직사광선에 노출되면 위험할 정도로 뜨거워질 수 있는데, 이것이 1980년대와 90년대부터 놀이터의 재질이 크게 바뀐 주요 이유 중 하나입니다."]}]]}]]}],["$","div","56–68",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["56–68"," — ","기지 및 착륙"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"86번부터 102번까지의 점을 연결하여 미끄럼틀의 바닥과 착지 지점을 그리면 완성입니다. 이제 17개의 점만 남았습니다. 자신감 있고 안정적인 마무리로 전체 구조물을 완성해 보세요."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"그네와 마찬가지로 미끄럼틀은 특수 설계된 안전 바닥재(일반적으로 고무, 모래 또는 나무 조각) 위에 설치되어 있으며, 이는 일반 잔디나 콘크리트보다 착지 충격을 훨씬 잘 흡수하도록 설계되었습니다."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Playgrounds"}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","spring-horse-playground-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/ko/playgrounds/spring-horse-playground-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"/images/playgrounds-spring-horse-puzzle-400.webp","srcSet":"/images/playgrounds-spring-horse-puzzle-400.webp 400w, /images/playgrounds-spring-horse-puzzle-600.webp 600w, /images/playgrounds-spring-horse-puzzle-700.webp 700w, /images/playgrounds-spring-horse-puzzle.webp 420w","sizes":"(max-width: 760px) 92vw, 30vw","alt":"42개의 쉬운 점으로 매달려 완성되는 놀이터 그네, 무료 입문용 도안","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","children":[["$","p",null,{"className":"puzzle-category","children":"Playgrounds"}],["$","h3",null,{"children":"그네 놀이터"}],["$","div",null,{"className":"puzzle-meta","children":[["$","span",null,{"children":""}],["$","span",null,{"children":"1–0 점"}]]}],["$","$Lf",null,{"href":"/ko/playgrounds/spring-horse-playground-dot-to-dot-puzzle/","className":"download-link","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":15,"height":15,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","st