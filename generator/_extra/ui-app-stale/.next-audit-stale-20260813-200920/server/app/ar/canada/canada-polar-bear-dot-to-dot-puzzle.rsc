neStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–15"," — ","الأنف والرأس"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"ابدأ من النقطة 1 وتواصل عبر النقطة 15 لتشكيل الأنف والخطم والرأس المستدير. حافظ على الخطوط لطيفة حول الوجه بحيث يبدو المظهر الجانبي للدب أملسًا."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"تمتّع الدب القطبي بحاسة شم ممتازة تساعده على العثور على الفقمات، وهي فريسته الرئيسية، عبر الجليد."]}]]}]]}],["$","div","16–30",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["16–30"," — ","الظهر والأكتاف"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"استمر من النقطة 16 إلى النقطة 30 على طول الأكتاف القوية والظهر المنحني. حاول رسم هذا الخط الطويل بضربات ثابتة بدلاً من العديد من العلامات الصغيرة."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"تُعد الدببة القطبية أكبر آكلات اللحوم البرية في كندا. ويمكن أن يصل وزن الذكور البالغة إلى عدة مئات من الكيلوغرامات."]}]]}]]}],["$","div","31–45",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["31–45"," — ","الأرجل الخلفية"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"ارسم النقاط من 31 إلى 45 لرسم الأرجل الخلفية والكفوف. تحقق من كل رقم بعناية حيث يتغير اتجاه المخطط بالقرب من الأقدام."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"توزع أقدام الدب القطبي العريضة وزنه على الثلج، وتعمل كالمجاديف أثناء السباحة."]}]]}]]}],["$","div","46–60",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["46–60"," — ","البطن والأقدام الأمامية"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"صل بين النقاط من 46 إلى 60 أسفل الجسم وحول الكفوف الأمامية. ستساعدك الخطوط القصيرة والمنضبطة على اتباع المنحنيات الأكثر انحناءً."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"تمتلك الدببة القطبية جلدًا أسود تحت فراء يبدو أبيض اللون. ويساعدهم فرائهم على الاندماج في المناظر الطبيعية الثلجية للقطب الشمالي."]}]]}]]}],["$","div","61–74",{"style":{"marginBottom":24,"paddingInlineStart":16,"borderInlineStart":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["61–74"," — ","الصدر والإنهاء"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"أنهِ بالنقاط من 61 إلى 74، متحركًا لأعلى الصدر وعائدًا نحو الرأس. توقف عند النقطة الأخيرة وتأكد من عدم تخطي أي رقم."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null