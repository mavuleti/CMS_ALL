e:["$","$L15",null,{"formats":"$undefined","locale":"ar","messages":{"nav":{"scanMe":"امسحني","blog":"المدونة","search":"بحث","kids":"الأطفال","teachers":"المعلمون","parents":"أولياء الأمور","contact":"تواصل معنا","freePack":"الحزمة المجانية"},"homepageUi":{"title":"اعثر على أوراق توصيل النقاط المثالية للطباعة","description":"اطبع، وصّل النقاط، واجعل الصور المدهشة تنبض بالحياة. مجانًا وجاهزة للمرح!","searchPlaceholder":"جرّب البحث عن المحيط أو الديناصورات أو الزهور","filterPuzzles":"تصفية الألغاز","age":"العمر","dots":"نقطة","featuredPuzzles":"ألغاز مميزة قابلة للطباعة","savePuzzle":"حفظ {name}","removeSavedPuzzle":"إزالة {name} من الألغاز المحفوظة","downloads":"تنزيل","bookTitle":"أفضل ألغاز 2026 · {count}","bookDescription":"ألغازنا المفضلة في كتاب PDF واحد قابل للطباعة.","searchUnavailable":"البحث غير متاح مؤقتًا. يُرجى المحاولة مرة أخرى.","popularEyebrow":"الأكثر رواجًا هذا الأسبوع","mostDownloaded":"الألغاز الأكثر تنزيلًا","downloadCountAria":"{count} عملية تنزيل أو أكثر","freshPrintables":"مطبوعات جديدة","recentlyAdded":"المضاف حديثًا","browseCategories":"تصفح فئات الألغاز","openCategories":"فتح قائمة الفئات","closeCategories":"إغلاق قائمة الفئات","browseByTheme":"تصفح حسب الموضوع","quickLinks":"روابط سريعة","bundlePacks":"حزم الألغاز","parentsTeachers":"لأولياء الأمور والمعلمين","more":"المزيد","kids":"الأطفال","categoryNames":{"cute":"ألغاز لطيفة","flowers":"الزهور"}},"audience":{"kidsTitle":"للأطفال","kidsText":"موضوعات حيوانات وديناصورات ومركبات محببة، بنقاط مرقّمة وواضحة. نجاحات سهلة تبني ثقة حقيقية.","parentsTitle":"لأولياء الأمور","parentsText":"أنشطة هادئة بعيدًا عن الشاشات في المنزل والسفر والمطاعم. اطبع من أي جهاز في أقل من دقيقة.","teachersTitle":"للمعلمين","teachersText":"أوراق توصيل نقاط سهلة التحضير لنشاط الصباح، والطلاب المنتهين مبكرًا، والمعلمين البدلاء، ومحطات الصف — بلا تحضير يُذكر."},"categories":{"eyebrow":"مرتبة حسب الموضوع ومستوى المهارة","heading":"تصفح ألغاز توصيل النقاط حسب الفئة","description":"من أشكال بسيطة بـ10 نقاط للصغار إلى تحديات بـ200 نقطة للأطفال الأكبر سنًا — كل ألعاب توصيل النقاط مرتبة حسب الفئة لتجد الورقة المجانية المناسبة خلال ثوانٍ.","puzzles":"{count, plural, zero {لا ألغاز} one {لغز} two {لغزان} few {# ألغاز} many {# لغزًا} other {ألغاز}}","comingSoon":"قريبًا","badges":{"dinosaurs":"متاح الآن!","ocean":"متاح الآن!","playgrounds":"متاح الآن!","garden":"متاح الآن!","usa250":"جديد!","uae":"متاح الآن!","cute":"جديد!","circus":"جديد!"},"items":{"dinosaurs":{"name":"الديناصورات","description":"اهدر مع المرح في عصور ما قبل التاريخ! تي ركس، ترايسيراتوبس، فيلوسيرابتور و{count} لغز مجاني لتوصيل النقاط سيحبها أطفالك."},"animals":{"name":"الحيوانات","description":"ألغاز توصيل نقاط حيوانات لطيفة لتمرين الأرقام المبكر."},"vehicles":{"name":"المركبات","description":"سيارات وشاحنات وصواريخ وآلات."},"fantasy":{"name":"الخيال","description":"قلاع ووحيدو قرن وتنانين وقصص ملهمة."},"seasonal":{"name":"المواسم","description":"أنشطة الأعياد والتقويم الدراسي."},"ocean":{"name":"المحيط","description":"توصيل نقاط حيوانات بحرية وصفحات رسم وتلوين هادئة."},"playgrounds":{"name":"الملاعب","description":"أراجيح وزحاليق ومرح في الهواء الطلق للمغامرين الصغار."},"garden":{"name":"الحديقة","description":"قفازات ومجارف وأدوات لصغار مساعدي الحديقة."},"usa250":{"name":"الولايات المتحدة 250 عامًا","description":"احتفل بالذكرى الـ250 لأمريكا مع ألغاز توصيل نقاط وطنية تكرّم التاريخ الأمريكي."},"uae":{"name":"الإمارات","description":"اكتشف دولة الإمارات العربية المتحدة! معالم شهيرة مثل برج العرب، جاهزة للتوصيل والتلوين."},"space":{"name":"الفضاء","description":"كواكب ورواد فضاء ومغامرات صاروخية."},"worksheets":{"name":"أوراق العمل","description":"أوراق تسلسل أرقام جاهزة للمعلمين."},"bigDotBooks":{"name":"كتب النقاط الكبيرة","description":"ألغاز طويلة للمتعلمين الأكبر سنًا ذوي التركيز العالي."},"cute":{"name":"لطيف","description":"جراء لطيفة وسيارات صغيرة و{count} من ألغاز توصيل النقاط المجانية الساحرة التي سيحبها أطفالكم."},"circus":{"name":"السيرك","description":"مديرو الحلبة والخيام الكبيرة ومتعة السيرك للصغار."}}},"puzzleSection":{"eyebrow":"نماذج مجانية للطباعة — بلا تسجيل","heading":"أوراق توصيل نقاط شائعة للطباعة الآن","weeklyPack":"شاهد الحزمة الأسبوعية ←","downloadLink":"حمّل النسخة المجانية للطباعة","new":"جديد","imageAlt":"ورقة {name} المجانية لتوصيل النقاط لعمر {age}","categories":{"Dinosaurs":"الديناصورات","Ocean":"المحيط","Playgrounds":"الملاعب","Garden":"الحديقة","Cute":"لطيف","USA 250 Years":"الولايات المتحدة 250 عامًا","UAE":"الإمارات"},"items":{"trex-61-dot-to-dot-puzzle":{"name":"تحدي تي ركس 61 نقطة"},"brontosaurus-dot-to-dot-puzzle":{"name":"برونتوصورس"},"mermaid-dot-to-dot-puzzle":{"name":"حورية البحر"},"merman-dot-to-dot-puzzle":{"name":"رجل البحر"},"seahorse-dot-to-dot-puzzle":{"name":"حصان البحر"},"whale-dot-to-dot-puzzle":{"name":"الحوت"},"swing-playgrounds-dot-to-dot-puzzle":{"name":"أرجوحة الملعب"},"slide-playgrounds-dot-to-dot-puzzle":{"name":"زحليقة الملعب"},"seesaw-playground-dot-to-dot-puzzle":{"name":"أرجوحة الميزان"},"roller-coaster-playground-dot-to-dot-puzzle":{"name":"ملعب الأفعوانية"},"wheelbarrow-playground-dot-to-dot-puzzle":{"name":"ملعب عربة اليد"},"garden-gloves-dot-to-dot-puzzle":{"name":"قفازات البستنة"},"garden-trowel-dot-to-dot-puzzle":{"name":"مجرفة البستنة"},"gas-balloon-usa-250-dot-to-dot-puzzle":{"name":"منطاد الغاز - الولايات المتحدة 250"},"america-250-birthday-fireworks-dot-to-dot-puzzle":{"name":"ألعاب نارية بذكرى أمريكا 250"},"america-250-anniversary-liberty-bell-wings-1776-dot-to-dot-puzzle":{"name":"أجنحة جرس الحرية - أمريكا 250"},"usa-250-astronaut-dot-to-dot-puzzle":{"name":"رائد فضاء - الولايات المتحدة 250"},"usa-250-anniversary-sports-kids-podium-dot-to-dot-puzzle":{"name":"منصة تتويج رياضية للأطفال - الولايات المتحدة 250"},"usa-250-anniversary-airplane-banner-dot-to-dot-puzzle":{"name":"طائرة ببانر - الولايات المتحدة 250"},"usa-250-space-shuttle-dot-to-dot-puzzle":{"name":"مكوك الفضاء - الولايات المتحدة 250"},"usa-250-birthday-balloons-stars-dot-to-dot-puzzle":{"name":"بالونات ونجوم الذكرى - الولايات المتحدة 250"},"usa-250-birthday-cake-dot-to-dot-puzzle":{"name":"كعكة عيد ميلاد - الولايات المتحدة 250"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"بانر النسر - أمريكا 250"},"burj-al-arab-dot-to-dot-puzzle":{"name":"برج العرب"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"دلة القهوة العربية"}}},"benefits":{"eyebrow":"بدعم من متخصصي الطفولة المبكرة","heading":"لماذا تُعد أوراق توصيل النقاط رائعة لنمو الطفل","description":"أوراق توصيل النقاط ليست مجرد مرح — إنها أداة مدعومة بالأبحاث يستخدمها معلمو ما قبل المدرسة والروضة لبناء مهارات التعلم المبكر الأساسية.","fineMotorTitle":"يبني المهارات الحركية الدقيقة","fineMotorText":"رسم خطوط توصيل النقاط يطوّر قبضة القلم، والتناسق بين اليد والعين، والتحكم العضلي الذي يحتاجه الأطفال للكتابة.","numberTitle":"يعزز التعرف على الأرقام","numberText":"تتبع الأرقام من 1 ← 2 ← 3 بالترتيب يعلّم ترتيب العد، والتعرف على الأرقام، ومفاهيم الرياضيات المبكرة بشكل طبيعي من خلال اللعب.","focusTitle":"يحسّن التركيز والانتباه","focusText":"إكمال لغز توصيل النقاط يتطلب انتباهًا مستمرًا — طريقة هادئة وبعيدة عن الشاشات لممارسة التركيز من مرحلة ما قبل المدرسة حتى الصف الثالث.","confidenceTitle":"مكافأة فورية وثقة بالنفس","confidenceText":"عندما تظهر الصورة المخفية، يشعر الأطفال بإنجاز فوري. هذا الفوز الصغير يبني حب التعلم وعقلية النمو."},"howTo":{"eyebrow":"جاهز في أقل من 60 ثانية","heading":"كيفية تحميل وطباعة أوراق توصيل النقاط المجانية","step1Title":"اختر لغزك","step1Text":"اختر موضوعًا (حيوانات، ديناصورات، مركبات، مناسبات) ومدى نقاط يناسب عمر طفلك ومستوى مهارته.","step2Title":"حمّل ملف PDF المجاني","step2Text":"انقر على \"حمّل النسخة المجانية للطباعة\" — بلا حساب، بلا بريد إلكتروني، بلا رسوم. سيقوم متصفحك بتحميل ملف PDF فورًا.","step3Title":"اطبع واستمتع","step3Text":"اطبع على ورق A4 القياسي، أو US Letter (8.5 × 11 بوصة) إذا كنت تطبع من الولايات المتحدة. الطباعة بالأبيض والأسود تعمل بشكل ممتاز. أعطها لطفلك وشاهده يوصّل النقاط!"},"trust":{"eyebrow":"لماذا يختارنا أولياء الأمور والمعلمون","heading":"مجاني، آمن، وسهل الاستخدام بشكل مذهل.","noAccountTitle":"بلا حاجة لحساب","noAccountText":"كل ورقة توصيل نقاط تُحمَّل فورًا — بلا تسجيل، بلا بريد إلكتروني، بلا رسوم. فقط انقر واطبع.","safeTitle":"آمن للصف الدراسي","safeText":"صفحات ألغاز نظيفة وخالية من الإعلانات مصممة لطابعات المدارس. مناسبة لنشاط الصباح أو الواجبات أو وقت الهدوء.","fastTitle":"سريع بالتصميم","fastText":"صفحات ثابتة وصور محسّنة وخطوط محلية تعني تحميل الألغاز بسرعة على أي جهاز — هاتف أو جهاز لوحي أو حاسوب محمول."},"faq":{"eyebrow":"الأسئلة الشائعة","heading":"الأسئلة المتكررة","q1":"هل جميع أوراق توصيل النقاط على هذا الموقع مجانية بالكامل؟","a1":"نعم — كل ورقة توصيل نقاط على DotToDotFreePrintables.com مجانية 100% للتحميل والطباعة. لا حاجة أبدًا لحساب أو اشتراك أو بطاقة ائتمان.","q2":"لأي عمر تناسب أوراق توصيل النقاط؟","a2":"أوراقنا تغطي أعمار 2 إلى 12 سنة. الأوراق السهلة (10-20 نقطة) تناسب الصغار وأطفال ما قبل المدرسة، والأوراق المتوسطة (20-50 نقطة) رائعة للروضة والصف الأول، والأوراق الأصعب (50-200+ نقطة) تتحدى أطفال الصف الثاني حتى السادس.","q3":"ما هي صيغة أوراق توصيل النقاط؟","a3":"جميع الأوراق تُحمَّل كملفات PDF جاهزة للطباعة، بمقاس A4 أو US Letter (8.5 × 11 بوصة). افتحها في أي متصفح أو عارض PDF واطبع — بلا حاجة لبرامج خاصة.","q4":"هل لديكم أوراق توصيل نقاط لمرحلة ما قبل المدرسة والروضة؟","a4":"بالتأكيد. أسهل أوراقنا تبدأ بـ1-10 نقاط وتناسب أطفالًا في عمر 3 سنوات و4 سنوات (2-4 سنوات تقريبًا)، وتتضمن موضوعات تعزز التعرف على الأرقام مصممة لصفوف ما قبل الروضة والروضة.","q5":"هل يمكن للمعلمين استخدام أوراق توصيل النقاط هذه في الصف؟","a5":"نعم! أوراقنا مجانية للاستخدام الشخصي والصفي. وهي شائعة لنشاط الصباح، وأنشطة الطلاب المنتهين مبكرًا، وخطط المعلمين البدلاء، ومحطات المهارات الحركية الدقيقة، وحزم الواجبات.","q6":"هل تساعد ألغاز توصيل النقاط في المهارات الحركية الدقيقة؟","a6":"نعم — رسم الخطوط بين النقاط يبني قوة قبضة القلم والتناسق بين اليد والعين اللذين يدعمان الاستعداد للكتابة. يوصي كثير من أخصائيي العلاج الوظيفي ومعلمي الروضة بأنشطة توصيل النقاط لهذا السبب.","q7":"هل لديكم أوراق توصيل نقاط بموضوعات مثل الحيوانات أو الديناصورات؟","a7":"لدينا 11 فئة تشمل الحيوانات والديناصورات والمركبات والمخلوقات البحرية والملاعب والولايات المتحدة 250 عامًا والفضاء والخيال ومواضيع المواسم والأعياد، وحزم أوراق المعلمين، وكتب النقاط الكبيرة. تُضاف تصاميم جديدة أسبوعيًا.","q8":"هل يمكنني طباعة هذه الألغاز بالأبيض والأسود؟","a8":"نعم — جميع أوراق توصيل النقاط لدينا مصممة للطباعة بالأبيض والأسود لتوفير الحبر. تبدو رائعة على أي طابعة منزلية أو مدرسية."},"newsletter":{"eyebrow":"حزمة البداية للطباعة — مجانية تمامًا","heading":"احصل على 20 ورقة توصيل نقاط مجانية في بريدك الإلكتروني.","description":"مجموعة مناسبة لأولياء الأمور والمعلمين تغطي الحيوانات والمركبات والديناصورات والمواضيع الموسمية — جميعها متوفرة بمقاس A4 أو US Letter ومحسّنة للطباعة بالأبيض والأسود."},"blog":{"eyebrow":"أفكار للكبار","heading":"نصائح تعليمية للمنزل والصف الدراسي","viewAll":"عرض كل المقالات","read":"قراءة"},"feedback":{"eyebrow":"يسعدنا سماع رأيك","heading":"أرسل ملاحظاتك","description":"لديك فكرة لغز، أو وجدت رابطًا معطلاً، أو تريد فقط أن تقول مرحبًا؟ اترك لنا رسالة أدناه."},"footer":{"description":"أوراق توصيل نقاط مجانية للأطفال وأولياء الأمور والمعلمين. جميع الألغاز مجانية للتحميل والطباعة والمشاركة.","kids":"الأطفال","parents":"أولياء الأمور","teachers":"المعلمون","blog":"المدونة","faq":"الأسئلة الشائعة","feedback":"الملاحظات","about":"من نحن","contact":"اتصل بنا","privacy":"سياسة الخصوصية","terms":"شروط الاستخدام","sitemap":"خريطة الموقع","copyright":"© {year} DotToDotFreePrintables.com · أنشطة مجانية للطباعة للأطفال"},"common":{"home":"الرئيسية","new":"جديد","comingSoon":"قريبًا","downloadFree":"حمّل النسخة المجانية للطباعة","viewDownload":"عرض وتحميل","shareTitle":"{name} ورقة توصيل نقاط - PDF مجاني","downloadAria":"تنزيل مجاني لورقة توصيل النقاط {name} بصيغة PDF","bookmarkTitle":"{name} ورقة توصيل نقاط - PDF مجاني للأطفال","showSlide":"عرض الشريحة {number}","ageRange":"الأعمار {min}-{max}","difficultyLabel":"الصعوبة {level} من 3","difficulty":{"1":"سهل","2":"متوسط","3":"صعب"},"dots":"1–{count} نقطة","homeVideoEyebrow":"فيديو","homeVideoH2":"