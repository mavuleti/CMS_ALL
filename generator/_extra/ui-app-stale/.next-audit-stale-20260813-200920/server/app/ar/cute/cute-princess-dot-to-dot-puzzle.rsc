50-birthday-cake-dot-to-dot-puzzle":{"name":"كعكة عيد ميلاد - الولايات المتحدة 250"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"بانر النسر - أمريكا 250"},"burj-al-arab-dot-to-dot-puzzle":{"name":"برج العرب"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"دلة القهوة العربية"}}},"benefits":{"eyebrow":"بدعم من متخصصي الطفولة المبكرة","heading":"لماذا تُعد أوراق توصيل النقاط رائعة لنمو الطفل","description":"أوراق توصيل النقاط ليست مجرد مرح — إنها أداة مدعومة بالأبحاث يستخدمها معلمو ما قبل المدرسة والروضة لبناء مهارات التعلم المبكر الأساسية.","fineMotorTitle":"يبني المهارات الحركية الدقيقة","fineMotorText":"رسم خطوط توصيل النقاط يطوّر قبضة القلم، والتناسق بين اليد والعين، والتحكم العضلي الذي يحتاجه الأطفال للكتابة.","numberTitle":"يعزز التعرف على الأرقام","numberText":"تتبع الأرقام من 1 ← 2 ← 3 بالترتيب يعلّم ترتيب العد، والتعرف على الأرقام، ومفاهيم الرياضيات المبكرة بشكل طبيعي من خلال اللعب.","focusTitle":"يحسّن التركيز والانتباه","focusText":"إكمال لغز توصيل النقاط يتطلب انتباهًا مستمرًا — طريقة هادئة وبعيدة عن الشاشات لممارسة التركيز من مرحلة ما قبل المدرسة حتى الصف الثالث.","confidenceTitle":"مكافأة فورية وثقة بالنفس","confidenceText":"عندما تظهر الصورة المخفية، يشعر الأطفال بإنجاز فوري. هذا الفوز الصغير يبني حب التعلم وعقلية النمو."},"howTo":{"eyebrow":"جاهز في أقل من 60 ثانية","heading":"كيفية تحميل وطباعة أوراق توصيل النقاط المجانية","step1Title":"اختر لغزك","step1Text":"اختر موضوعًا (حيوانات، ديناصورات، مركبات، مناسبات) ومدى نقاط يناسب عمر طفلك ومستوى مهارته.","step2Title":"حمّل ملف PDF المجاني","step2Text":"انقر على \"حمّل النسخة المجانية للطباعة\" — بلا حساب، بلا بريد إلكتروني، بلا رسوم. سيقوم متصفحك بتحميل ملف PDF فورًا.","step3Title":"اطبع واستمتع","step3Text":"اطبع على ورق A4 القياسي، أو US Letter (8.5 × 11 بوصة) إذا كنت تطبع من الولايات المتحدة. الطباعة بالأبيض والأسود تعمل بشكل ممتاز. أعطها لطفلك وشاهده يوصّل النقاط!"},"trust":{"eyebrow":"لماذا يختارنا أولياء الأمور والمعلمون","heading":"مجاني، آمن، وسهل الاستخدام بشكل مذهل.","noAccountTitle":"بلا حاجة لحساب","noAccountText":"كل ورقة توصيل نقاط تُحمَّل فورًا — بلا تسجيل، بلا بريد إلكتروني، بلا رسوم. فقط انقر واطبع.","safeTitle":"آمن للصف الدراسي","safeText":"صفحات ألغاز نظيفة وخالية من الإعلانات مصممة لطابعات المدارس. مناسبة لنشاط الصباح أو الواجبات أو وقت الهدوء.","fastTitle":"سريع بالتصميم","fastText":"صفحات ثابتة وصور محسّنة وخطوط محلية تعني تحميل الألغاز بسرعة على أي جهاز — هاتف أو جهاز لوحي أو حاسوب محمول."},"faq":{"eyebrow":"الأسئلة الشائعة","heading":"الأسئلة المتكررة","q1":"هل جميع أوراق توصيل النقاط على هذا الموقع مجانية بالكامل؟","a1":"نعم — كل ورقة توصيل نقاط على DotToDotFreePrintables.com مجانية 100% للتحميل والطباعة. لا حاجة أبدًا لحساب أو اشتراك أو بطاقة ائتمان.","q2":"لأي عمر تناسب أوراق توصيل النقاط؟","a2":"أوراقنا تغطي أعمار 2 إلى 12 سنة. الأوراق السهلة (10-20 نقطة) تناسب الصغار وأطفال ما قبل المدرسة، والأوراق المتوسطة (20-50 نقطة) رائعة للروضة والصف الأول، والأوراق الأصعب (50-200+ نقطة) تتحدى أطفال الصف الثاني حتى السادس.","q3":"ما هي صيغة أوراق توصيل النقاط؟","a3":"جميع الأوراق تُحمَّل كملفات PDF جاهزة للطباعة، بمقاس A4 أو US Letter (8.5 × 11 بوصة). افتحها في أي متصفح أو عارض PDF واطبع — بلا حاجة لبرامج خاصة.","q4":"هل لديكم أوراق توصيل نقاط لمرحلة ما قبل المدرسة والروضة؟","a4":"بالتأكيد. أسهل أوراقنا تبدأ بـ1-10 نقاط وتناسب أطفالًا في عمر 3 سنوات و4 سنوات (2-4 سنوات تقريبًا)، وتتضمن موضوعات تعزز التعرف على الأرقام مصممة لصفوف ما قبل الروضة والروضة.","q5":"هل يمكن للمعلمين استخدام أوراق توصيل النقاط هذه في الصف؟","a5":"نعم! أوراقنا مجانية للاستخدام الشخصي والصفي. وهي شائعة لنشاط الصباح، وأنشطة الطلاب المنتهين مبكرًا، وخطط المعلمين البدلاء، ومحطات المهارات الحركية الدقيقة، وحزم الواجبات.","q6":"هل تساعد ألغاز توصيل النقاط في المهارات الحركية الدقيقة؟","a6":"نعم — رسم الخطوط بين النقاط يبني قوة قبضة القلم والتناسق بين اليد والعين اللذين يدعمان الاستعداد للكتابة. يوصي كثير من أخصائيي العلاج الوظيفي ومعلمي الروضة بأنشطة توصيل النقاط لهذا السبب.","q7":"هل لديكم أوراق توصيل نقاط بموضوعات مثل الحيوانات أو الديناصورات؟","a7":"لدينا 11 فئة تشمل الحيوانات والديناصورات والمركبات والمخلوقات البحرية والملاعب والولايات المتحدة 250 عامًا والفضاء والخيال ومواضيع المواسم والأعياد، وحزم أوراق المعلمين، وكتب النقاط الكبيرة. تُضاف تصاميم جديدة أسبوعيًا.","q8":"هل يمكنني طباعة هذه الألغاز بالأبيض والأسود؟","a8":"نعم — جميع أوراق توصيل النقاط لدينا مصممة للطباعة بالأبيض والأسود لتوفير الحبر. تبدو رائعة على أي طابعة منزلية أو مدرسية."},"newsletter":{"eyebrow":"حزمة البداية للطباعة — مجانية تمامًا","heading":"احصل على 20 ورقة توصيل نقاط مجانية في بريدك الإلكتروني.","description":"مجموعة مناسبة لأولياء الأمور والمعلمين تغطي الحيوانات والمركبات والديناصورات والمواضيع الموسمية — جميعها متوفرة بمقاس A4 أو US Letter ومحسّنة للطباعة بالأبيض والأسود."},"blog":{"eyebrow":"أفكار للكبار","heading":"نصائح تعليمية للمنزل والصف الدراسي","viewAll":"عرض كل المقالات","read":"قراءة"},"feedback":{"eyebrow":"يسعدنا سماع رأيك","heading":"أرسل ملاحظاتك","description":"لديك فكرة لغز، أو وجدت رابطًا معطلاً، أو تريد فقط أن تقول مرحبًا؟ اترك لنا رسالة أدناه."},"footer":{"description":"أوراق توصيل نقاط مجانية للأطفال وأولياء الأمور والمعلمين. جميع الألغاز مجانية للتحميل والطباعة والمشاركة.","kids":"الأطفال","parents":"أولياء الأمور","teachers":"المعلمون","blog":"المدونة","faq":"الأسئلة الشائعة","feedback":"الملاحظات","about":"من نحن","contact":"اتصل بنا","privacy":"سياسة الخصوصية","terms":"شروط الاستخدام","sitemap":"خريطة الموقع","copyright":"© {year} DotToDotFreePrintables.com · أنشطة مجانية للطباعة للأطفال"},"common":{"home":"الرئيسية","new":"جديد","comingSoon":"قريبًا","downloadFree":"حمّل النسخة المجانية للطباعة","viewDownload":"عرض وتحميل","shareTitle":"{name} ورقة توصيل نقاط - PDF مجاني","downloadAria":"تنزيل مجاني لورقة توصيل النقاط {name} بصيغة PDF","bookmarkTitle":"{name} ورقة توصيل نقاط - PDF مجاني للأطفال","showSlide":"عرض الشريحة {number}","ageRange":"الأعمار {min}-{max}","difficultyLabel":"الصعوبة {level} من 3","difficulty":{"1":"سهل","2":"متوسط","3":"صعب"},"dots":"1–{count} نقطة","homeVideoEyebrow":"فيديو","homeVideoH2":"