ات بـ200 نقطة للأطفال الأكبر سنًا — كل ألعاب توصيل النقاط مرتبة حسب الفئة لتجد الورقة المجانية المناسبة خلال ثوانٍ.","puzzles":"{count, plural, zero {لا ألغاز} one {لغز} two {لغزان} few {# ألغاز} many {# لغزًا} other {ألغاز}}","comingSoon":"قريبًا","badges":{"dinosaurs":"متاح الآن!","ocean":"متاح الآن!","playgrounds":"متاح الآن!","garden":"متاح الآن!","usa250":"جديد!","uae":"متاح الآن!","cute":"جديد!","circus":"جديد!"},"items":{"dinosaurs":{"name":"الديناصورات","description":"اهدر مع المرح في عصور ما قبل التاريخ! تي ركس، ترايسيراتوبس، فيلوسيرابتور و{count} لغز مجاني لتوصيل النقاط سيحبها أطفالك."},"animals":{"name":"الحيوانات","description":"ألغاز توصيل نقاط حيوانات لطيفة لتمرين الأرقام المبكر."},"vehicles":{"name":"المركبات","description":"سيارات وشاحنات وصواريخ وآلات."},"fantasy":{"name":"الخيال","description":"قلاع ووحيدو قرن وتنانين وقصص ملهمة."},"seasonal":{"name":"المواسم","description":"أنشطة الأعياد والتقويم الدراسي."},"ocean":{"name":"المحيط","description":"توصيل نقاط حيوانات بحرية وصفحات رسم وتلوين هادئة."},"playgrounds":{"name":"الملاعب","description":"أراجيح وزحاليق ومرح في الهواء الطلق للمغامرين الصغار."},"garden":{"name":"الحديقة","description":"قفازات ومجارف وأدوات لصغار مساعدي الحديقة."},"usa250":{"name":"الولايات المتحدة 250 عامًا","description":"احتفل بالذكرى الـ250 لأمريكا مع ألغاز توصيل نقاط وطنية تكرّم التاريخ الأمريكي."},"uae":{"name":"الإمارات","description":"اكتشف دولة الإمارات العربية المتحدة! معالم شهيرة مثل برج العرب، جاهزة للتوصيل والتلوين."},"space":{"name":"الفضاء","description":"كواكب ورواد فضاء ومغامرات صاروخية."},"worksheets":{"name":"أوراق العمل","description":"أوراق تسلسل أرقام جاهزة للمعلمين."},"bigDotBooks":{"name":"كتب النقاط الكبيرة","description":"ألغاز طويلة للمتعلمين الأكبر سنًا ذوي التركيز العالي."},"cute":{"name":"لطيف","description":"جراء لطيفة وسيارات صغيرة و{count} من ألغاز توصيل النقاط المجانية الساحرة التي سيحبها أطفالكم."},"circus":{"name":"السيرك","description":"مديرو الحلبة والخيام الكبيرة ومتعة السيرك للصغار."}}},"