":"Digital PDF","printAtHome":"Print at home","instantAccess":"Instant access","purchaseAria":"Purchase the Best of 2026 puzzle pack","coverAlt":"Best of 2026 - 25 Dot to Dot Puzzles book cover","oneTime":"one time","buyButton":"Get the puzzle pack","localNote":"On localhost, this opens a safe checkout demo and never charges a card.","detailsEyebrow":"Made for easy print-and-play","detailsHeading":"Everything you need for screen-free fun","detailsText":"Download once, keep it handy, and print the activities you want whenever you need them.","benefits":{"onePdf":"One convenient, print-ready PDF","kidFriendly":"Kid-friendly puzzles with varied difficulty","paperSizes":"Works on US Letter and A4 paper","instantAccess":"Instant access after successful payment","classroomUse":"Use at home or in one classroom"},"guaranteeHeading":"Simple, secure, and ready in minutes","guaranteeText":"After checkout, your private download link appears immediately. No subscription and no surprise renewal."},"checkout":{"consent":"I agree to immediate delivery of this digital PDF and understand that, once access begins, the sale is final and non-refundable except where required by law or if the file is not delivered or is defective.","refundPolicy":"Read the refund policy","opening":"Opening checkout...","secureNote":"Secure checkout powered by Stripe. One-time payment. No subscription.","error":"Something went wrong starting checkout. Please try again."},"success":{"metaTitle":"Thank You for Your Purchase","eyebrow":"Payment confirmed","heading":"Thank you! Your purchase is complete.","lede":"Your payment was successful. It may take a few seconds for your purchase to appear on your account."},"cancelled":{"metaTitle":"Checkout Cancelled","eyebrow":"No payment taken","heading":"Checkout cancelled","lede":"No charge was made. You can try again any time."},"download":{"demoTitle":"Local checkout test passed.","demoText":"The real paid success screen shows the PDF download button here. The local demo does not release the private file.","button":"Download your puzzle pack","expires":"This link expires in 24 hours. Save your download somewhere safe.","failed":"We couldn't confirm your purchase yet. If you were charged, please refresh this page in a minute or contact us for help.","preparing":"Preparing your download..."},"ad":{"advertisementAria":"Advertisement: Best of 2026 dot to dot activity book","viewPackAria":"View the Best of 2026 dot to dot puzzle pack","pdfBook":"PDF BOOK","bookTitle":"Best of 2026","packName":"Dot to Dot Puzzle Pack","puzzleCount":"25 Dot to Dot Puzzles","viewBook":"View book"},"shared":{"specialSale":"Special sale","returnToPack":"Return to the puzzle pack","contactUs":"Contact us"}}},"now":"$undefined","timeZone":"America/New_York","children":[["$","$L10",null,{}],"$L11",["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}],["$","$L12",null,{"locale":"hr","children":"$L13"}],["$","$L14",null,{}],"$L15"]}]
