c:["$","$Ld",null,{"formats":"$undefined","locale":"sv","messages":{"nav":{"scanMe":"Skanna mig","blog":"Blogg","search":"Söka","kids":"Barn - Pussel","teachers":"Lärare","parents":"Föräldrar","contact":"Kontakta oss","freePack":"Gratispaket"},"homepageUi":{"title":"Hitta de perfekta prick-till-prick-utskrifterna","description":"Skriv ut, koppla prickarna och väck fantastiska bilder till liv. Gratis och redo för skoj!","searchPlaceholder":"Prova hav, dinosaurie eller blommor","filterPuzzles":"Filtrera pussel","age":"Ålder","dots":"prickar","featuredPuzzles":"Utvalda utskrivbara pussel","savePuzzle":"Spara {name}","removeSavedPuzzle":"Ta bort {name} från sparade","downloads":"nedladdningar","bookTitle":"Bästa av 2026 · {count}","bookDescription":"Våra favoritprick-till-prick-pussel i en utskrivbar PDF-bok.","searchUnavailable":"Sökningen är tillfälligt otillgänglig. Försök igen.","popularEyebrow":"Populärt denna vecka","mostDownloaded":"Mest nedladdade pussel","downloadCountAria":"{count} eller fler nedladdningar","freshPrintables":"Nya utskrifter","recentlyAdded":"Nyligen tillagda","browseCategories":"Bläddra i pusselkategorier","openCategories":"Öppna kategorimeny","closeCategories":"Stäng kategorimeny","browseByTheme":"Bläddra efter tema","quickLinks":"Snabblänkar","bundlePacks":"Paket med bundlar","parentsTeachers":"För föräldrar och lärare","more":"Fler kategorier","kids":"Barn","categoryNames":{"cute":"Söta pussel","flowers":"Blommor"}},"audience":{"kidsTitle":"För barn","kidsText":"Vänliga djur-, dinosaurie- och fordonsteman med tydliga numrerade prickar. Enkla vinster som bygger upp riktigt självförtroende.","parentsTitle":"För föräldrar","parentsText":"Skärmfria aktiviteter för lugn och ro hemma, på resor och restauranger. Skriv ut från vilken enhet som helst på under en minut.","teachersTitle":"För lärare","teachersText":"Lättförberedande kopplingar till morgonarbete, tidiga slutföranden, avbyten och klassrumsstationer – ingen förberedelse krävs."},"categories":{"eyebrow":"Organiserad efter tema och färdighetsnivå","heading":"Bläddra bland prick-till-prick-pussel efter kategori","description":"Från enkla 10-punktsformer för småbarn till 200-punktsutmaningar för äldre barn – sorterade efter kategori så att du hittar rätt gratis utskrivbara material på några sekunder.","puzzles":"{count, plural, one {# pussel} other {# pussel}}","comingSoon":"Kommer snart","badges":{"dinosaurs":"Tillgänglig nu!","ocean":"Tillgänglig nu!","playgrounds":"Tillgänglig nu!","garden":"Tillgänglig nu!","usa250":"Ny!","uae":"Tillgänglig nu!","cute":"Ny!","circus":"Ny!"},"items":{"dinosaurs":{"name":"Dinosaurier","description":"Ryt in i förhistoriskt skoj! T-Rex, Triceratops, Velociraptor och {count} gratis prick-till-prick-pussel som dina barn kommer att älska."},"animals":{"name":"Djur","description":"Vänliga varelser för tidig sifferövning."},"vehicles":{"name":"Fordon","description":"Bilar, lastbilar, raketer och maskiner."},"fantasy":{"name":"Fantasi","description":"Slott, enhörningar, drakar och berättelser."},"seasonal":{"name":"Säsong","description":"Aktiviteter i klassrummet och under helgdagar."},"ocean":{"name":"Hav","description":"Havsdjur och lugna målarbilder."},"playgrounds":{"name":"Lekplatser","description":"Gungor, rutschkanor och utomhuskul för små äventyrare."},"garden":{"name":"Trädgård","description":"Handskar, murslev och verktyg för små trädgårdshjälpare."},"usa250":{"name":"Amerika 250 år","description":"Fira Amerikas 250-årsdag med patriotiska prick-till-prick-pussel som hyllar amerikansk historia."},"uae":{"name":"Förenade Arabemiraten","description":"Utforska Förenade Arabemiraten! Ikoniska landmärken som Burj Al Arab, redo att skapas och färgläggas."},"space":{"name":"Utrymme","description":"Planeter, astronauter och raketäventyr."},"worksheets":{"name":"Arbetsblad","description":"Lärarfärdiga blad för nummersekvensering."},"bigDotBooks":{"name":"Stora prickböcker","description":"Långa pussel för fokuserade äldre elever."},"cute":{"name":"Söt","description":"Bedårande valpar, små bilar och {count} charmiga gratis prick-till-prick-pussel som dina barn kommer att älska."},"circus":{"name":"Cirkus","description":"Ringmaster, stora tält och underhållning för unga lärande."}}},"puzzleSection":{"eyebrow":"Gratis utskrivbara prover – ingen registrering","heading":"Populära sammanbindningsark att skriva ut nu","weeklyPack":"Se veckopaket →","downloadLink":"Ladda ner gratis utskrivbar","new":"Ny","imageAlt":"{name} gratis utskrivbara prick-till-prick-arbetsblad för {age}","categories":{"Dinosaurs":"Dinosaurier","Ocean":"Hav","Playgrounds":"Lekplatser","Garden":"Trädgård","Cute":"Söt","USA 250 Years":"Amerika 250 år","UAE":"Förenade Arabemiraten"},"items":{"trex-61-dot-to-dot-puzzle":{"name":"T-Rex 61-punktsutmaning"},"brontosaurus-dot-to-dot-puzzle":{"name":"Brontosaurus"},"mermaid-dot-to-dot-puzzle":{"name":"Sjöjungfru"},"merman-dot-to-dot-puzzle":{"name":"Sjöman"},"seahorse-dot-to-dot-puzzle":{"name":"Sjöhäst"},"whale-dot-to-dot-puzzle":{"name":"Val"},"swing-playgrounds-dot-to-dot-puzzle":{"name":"Gunglekplats"},"slide-playgrounds-dot-to-dot-puzzle":{"name":"Rutschkana"},"seesaw-playground-dot-to-dot-puzzle":{"name":"Gungbräda Lekplats"},"roller-coaster-playground-dot-to-dot-puzzle":{"name":"Berg-och-dalbana lekplats"},"wheelbarrow-playground-dot-to-dot-puzzle":{"name":"Skottkärra Lekplats"},"garden-gloves-dot-to-dot-puzzle":{"name":"Trädgårdshandskar"},"garden-trowel-dot-to-dot-puzzle":{"name":"Trädgårdsslev"},"gas-balloon-usa-250-dot-to-dot-puzzle":{"name":"Gasballong America 250"},"america-250-birthday-fireworks-dot-to-dot-puzzle":{"name":"Amerikas 250-årsdagsfyrverkerier"},"america-250-anniversary-liberty-bell-wings-1776-dot-to-dot-puzzle":{"name":"Amerika 250 Frihetsklockans vingar"},"usa-250-astronaut-dot-to-dot-puzzle":{"name":"Amerika 250 Astronaut"},"usa-250-anniversary-sports-kids-podium-dot-to-dot-puzzle":{"name":"America 250-årsjubileumsidrott för barn"},"usa-250-anniversary-airplane-banner-dot-to-dot-puzzle":{"name":"Amerikas 250-årsjubileumsflygplansbanner"},"usa-250-space-shuttle-dot-to-dot-puzzle":{"name":"Rymdfärjan America 250"},"usa-250-birthday-balloons-stars-dot-to-dot-puzzle":{"name":"Amerikas 250-årsdagsballonger och stjärnor"},"usa-250-birthday-cake-dot-to-dot-puzzle":{"name":"Amerikas 250-årsdagstårta"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"Amerika 250 Örnbanderoll"},"burj-al-arab-dot-to-dot-puzzle":{"name":"Burdj Al Arab"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"Dallah Kaffekanna"}}},"benefits":{"eyebrow":"Stöds av förskollärare","heading":"Varför prick-till-prick-arbetsblad är bra för barns utveckling","description":"Utskrivbara \"connect-the-pricks\"-bilder är mer än bara roliga – de är ett forskningsbaserat verktyg som används av förskollärare och dagislärare för att bygga upp grundläggande färdigheter i tidig inlärning.","fineMotorTitle":"Bygger upp finmotorik","fineMotorText":"Att rita prick-till-prick-linjer utvecklar penngrepp, hand-öga-koordination och den muskelkontroll som barn behöver för handstil.","numberTitle":"Förstärker nummerigenkänning","numberText":"Att följa punkterna 1 → 2 → 3 i följd lär barnen räkneordning, taligenkänning och tidiga matematiska begrepp på ett naturligt sätt genom lek.","focusTitle":"Förbättrar fokus och koncentration","focusText":"Att lägga ett pussel med prickar kräver ihållande uppmärksamhet – ett lugnt, skärmfritt sätt att öva fokus för förskola till årskurs 3.","confidenceTitle":"Omedelbar belöning och självförtroende","confidenceText":"När den dolda bilden dyker upp känner barnen en omedelbar känsla av prestation. Den lilla vinsten bygger upp en kärlek till lärande och ett utvecklingsinriktat tankesätt."},"howTo":{"eyebrow":"Klar på under 60 sekunder","heading":"Hur du laddar ner och skriver ut dina gratis prick-till-prick-arbetsblad","step1Title":"Välj ditt pussel","step1Text":"Välj ett tema (djur, dinosaurier, fordon, högtid) och ett prickintervall som matchar ditt barns ålder och färdighetsnivå.","step2Title":"Ladda ner den kostnadsfria PDF-filen","step2Text":"Klicka på \"Ladda ner gratis utskrivbar fil\" — inget konto, ingen e-postadress, ingen betalvägg. Din webbläsare laddar ner PDF-filen direkt.","step3Title":"Skriv ut och njut","step3Text":"Skriv ut på vanligt US Letter-papper (8,5 × 11 tum). Svartvitt fungerar perfekt. Ge det till ditt barn och se dem koppla ihop prickarna!"},"trust":{"eyebrow":"Varför föräldrar och lärare väljer oss","heading":"Gratis, säkert och otroligt enkelt att använda.","noAccountTitle":"Inget konto krävs","noAccountText":"Alla utskrivbara prick-till-prick-bilder laddas ner direkt – ingen registrering, ingen e-post, ingen betalvägg. Bara klicka och skriv ut.","safeTitle":"Klassrumssäkert","safeText":"Rena, reklamfria pusselsidor utformade för skolskrivare. Fungerar för morgonarbete, läxor eller lugn stund.","fastTitle":"Snabb genom design","fastText":"Statiska sidor, optimerade bilder och lokala teckensnitt gör att pussel laddas snabbt på alla enheter – telefon, surfplatta eller bärbar dator."},"faq":{"eyebrow":"Vanliga frågor","heading":"Vanliga frågor","q1":"Är alla prick-till-prick-utskrivbara bilder på den här webbplatsen helt gratis?","a1":"Ja — alla arbetsblad med prickförbindelser på DotToDotFreePrintables.com är 100 % gratis att ladda ner och skriva ut. Inget konto, prenumeration eller kreditkort krävs någonsin.","q2":"För vilken ålder passar prick-till-prick-arbetsblad?","a2":"Våra utskrivbara ark täcker åldrarna 2–12. Enkla arbetsblad (10–20 prickar) passar småbarn och förskolebarn, mellanstora ark (20–50 prickar) är utmärkta för dagis och årskurs 1, och svårare ark (50–200+ prickar) utmanar andra till sjätte klass.","q3":"Vilket format har de utskrivbara \"connect the dots\"-bilderna?","a3":"Alla arbetsblad laddas ner som utskriftsklara PDF-filer i storlek för standardpapper i USA, Letter (8,5 × 11 tum). Öppna i valfri webbläsare eller PDF-läsare och skriv ut – ingen särskild programvara behövs.","q4":"Har ni prick-till-prick-arbetsblad för förskola och dagis?","a4":"Absolut. Våra enklaste arbetsblad börjar på 1–10 punkter (perfekt för åldrarna 2–4) och innehåller teman om alfabets- och sifferigenkänning utformade för förskoleklass och dagisklassrum.","q5":"Kan lärare använda dessa arbetsblad med prickar i klassrummet?","a5":"Ja! Våra utskrivbara material är gratis för personligt bruk och klassrumsbruk. De är populära för morgonarbete, aktiviteter för tidig avslutning, vikarieplaneringar, finmotorikcenter och läxpaket.","q6":"Hjälper prick-till-prick-pussel med finmotoriken?","a6":"Ja – att rita linjer mellan prickar stärker penngreppsstyrkan och hand-öga-koordinationen som stöder handstilsberedskap. Många arbetsterapeuter och förskolelärare rekommenderar prickförbindande aktiviteter av denna anledning.","q7":"Har ni temainriktade prick-till-prick-utskrivbara saker som djur eller dinosaurier?","a7":"Vi har 11 kategorier inklusive djur, dinosaurier, fordon, havsdjur, lekplatser, Amerika 250 år, rymden, fantasy, säsongs-/högtidsteman, arbetsblad för lärare och böcker med stora prickar. Nya designer läggs till varje vecka.","q8":"Kan jag skriva ut dessa pussel i svartvitt?","a8":"Ja – alla våra arbetsblad med punktförbindelser är utformade för svartvit utskrift för att spara bläck. De ser bra ut på vilken skrivare som helst, både hemma och i klassrummet."},"newsletter":{"eyebrow":"Utskrivbart startpaket – helt gratis","heading":"Få 20 gratis prick-till-prick-utskrivbara bilder levererade till din inkorg.","description":"En föräldra- och lärarvänlig samling som täcker djur, fordon, dinosaurier och säsongsteman – alla i storlek för standard US Letter-papper och optimerade för svartvit utskrift."},"blog":{"eyebrow":"Idéer för vuxna","heading":"Lärandetips för hemmet och klassrummet","viewAll":"Visa alla artiklar","read":"Läsa"},"feedback":{"eyebrow":"Vi vill gärna höra från dig","heading":"Skicka feedback","description":"Har du en idé om ett pussel, upptäckt en trasig länk eller bara vill säga hej? Skriv ett meddelande nedan."},"footer":{"description":"Gratis utskrivbara prick-till-prick-pussel och prickförbindelse-arbetsblad för barn, föräldrar och lärare. Alla pussel är gratis att ladda ner, skriva ut och dela.","kids":"Barn","parents":"Föräldrar","teachers":"Lärare","blog":"Blogg","faq":"Vanliga frågor","feedback":"Feed-back","about":"Om","contact":"Kontakta","privacy":"Privatliv","terms":"Villkor","sitemap":"Webbplatskarta","copyright":"© {year} DotToDotFreePrintables.com · Gratis utskrivbara aktiviteter för barn"},"common":{"home":"Hem","new":"Ny","comingSoon":"Kommer snart","downloadFree":"Ladda ner gratis utskrivbar","viewDownload":"Visa och ladda ner","shareTitle":"{name} Prick-och-drag Utskrivbar - Gratis PDF","downloadAria":"Ladda ner gratis {name} prick-och-drag utskrivbar PDF","bookmarkTitle":"{name} Prick-och-drag Utskrivbar – Gratis PDF för barn","showSlide":"Visa bildspel {number}","ageRange":"Ålder {min}-{max}","difficultyLabel":"Svårighetsgrad {level} av 3","difficulty":{"1":"Lätt","2":"Medium","3":"Hård"},"dots":"1–{count} prickar","homeVideoEyebrow":"Video","homeVideoH2":"Se prick-till-prick-leken i aktion","skipToContent":"Hoppa till huvudinnhold","joinTeachers":"Gå med {count}+ lärare","breadcrumbAria":"Brödsmulor"},"puzzleSearch":{"placeholder":"Search by name or topic... e.g. ocean, whale, T-Rex","searchAria":"Sök pussel","clearSearch":"Clear search","toggleFilters":"Toggle filters","filters":"Filters","filterOptions":"Filter options","topic":"Topic","numberOfDots":"Number of dots","recentlyAddedOnly":"Recently added only","clearAllFilters":"Clear all filters","clearFilters":"Clear filters","resultsFound":"{count, plural, one {# pussel hittades} other {# pussel hittades}}","puzzlesAvailable":"{count, plural, one {# puzzle available} other {# puzzles available}}","noMatches":"Inga pussel matchade din sökning.","openPuzzle":"Open {name}","imageAlt":"{name} punkt-til