:[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Мастерок — это небольшой ручной инструмент, используемый для посадки рассады, выкапывания небольших ямок и перемещения почвы."]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],["$","p",null,{"className":"asset-note","children":"Printable PDF path is not present in the export JSON."}],"$L10",["$","$L11",null,{"title":"Садовая лопатка Распечатка по точкам - Бесплатный PDF","imageUrl":"","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/ru/garden/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}]," Back to all ","Garden"," puzzles"]}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Садовая лопатка"," Dot-to-Dot Puzzle Guide"]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Садовая лопатка — один из самых простых инструментов в сарае, и эта головоломка из 39 точек так же проста — три коротких участка и форма, которую дети сразу узнают. Начните с загнутого лезвия, затем перейдите к шейке, соединяющей его с ручкой, а затем к самой ручке. Найдите точку 1 на кончике лезвия, и начнём копать."}}],[["$","div","1–13",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–13"," — ","Клинок"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Начните с точки 1 и проведите линию до точки 13, чтобы нарисовать заостренное лезвие мастерка. Изгиб вдоль одного края — самая сложная часть, поэтому лучше работать медленно, а не быстро и прямо."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Лезвие мастерка имеет изогнутую, а не плоскую форму, что позволяет выгребать грунт из ямы одним движением, в отличие от плоского инструмента, требующего нескольких отдельных движений по копанию и подъему грунта."]}]]}]]}],["$","div","14–26",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["14–26"," — ","Шея"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Продолжайте от точки 14 до точки 26, чтобы нарисовать узкую шейку, где лезвие соединяется с рукояткой. Это самая тонкая часть всего инструмента, поэтому ведите линии близко друг к другу и контролируйте их."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Шейка мастерка обычно является самой прочной частью всего инструмента, поскольку вся сила, возникающая при копании и толкании, проходит именно через этот узкий участок."]}]]}]]}],["$","div","27–39",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["27–39"," — ","Рукоятка"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Завершите, соединив точки с 27 по 39, чтобы нарисовать закругленную рукоятку, за которую держится садовник при копании. Осталось всего тринадцать точек — уверенная и твердая завершающая линия здесь завершит изображение инструмента."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Рукоятки садовых лопаток часто имеют немного более широкую форму на конце, чтобы инструмент не выскальзывал из рук садовника, особенно когда ладони становятся влажными от работы во влажной почве."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["More free ","Garden"," printables"]}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","garden-gloves-dot-to-dot-puzzle",{"className":"puzzle-card