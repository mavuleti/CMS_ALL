e:["$","$L12",null,{"formats":"$undefined","locale":"uk","messages":{"nav":{"scanMe":"Скануйте мене","blog":"Блог","search":"Пошук","kids":"Діти - Пазли","teachers":"Вчителі","parents":"Батьки","contact":"Зв'яжіться з нами","freePack":"Безкоштовний пакет"},"homepageUi":{"title":"Знайдіть ідеальні друковані картинки «з'єднай крапки»","description":"Роздрукуйте, з'єднайте крапки та оживіть дивовижні малюнки. Безкоштовно і готово до розваг!","searchPlaceholder":"Спробуйте океан, динозавра або квіти","filterPuzzles":"Фільтр головоломок","age":"Вік","dots":"крапок","featuredPuzzles":"Популярні головоломки для друку","savePuzzle":"Зберегти {name}","removeSavedPuzzle":"Видалити {name} із збережених","downloads":"завантажень","bookTitle":"Найкраще за 2026 · {count}","bookDescription":"Наші улюблені головоломки «точка за точкою» в одній PDF-книзі для друку.","searchUnavailable":"Пошук тимчасово недоступний. Спробуйте ще раз.","popularEyebrow":"Популярне цього тижня","mostDownloaded":"Найбільш завантажувані головоломки","downloadCountAria":"{count} або більше завантажень","freshPrintables":"Свіжі роздруківки","recentlyAdded":"Нещодавно додано","browseCategories":"Переглянути категорії головоломок","openCategories":"Відкрити меню категорій","closeCategories":"Закрити меню категорій","browseByTheme":"Перегляд за темою","quickLinks":"Швидкі посилання","bundlePacks":"Пакети з набором","parentsTeachers":"Для батьків та вчителів","more":"Більше категорій","kids":"Діти","categoryNames":{"cute":"Милий пазл","flowers":"Квіти"}},"audience":{"kidsTitle":"Для дітей","kidsText":"Дружні теми тварин, динозаврів і транспортних засобів із чіткими пронумерованими крапками. Легкі перемоги, які формують справжню впевненість.","parentsTitle":"Для батьків","parentsText":"Розваги вдома, у подорожах і ресторанах без екрану. Друкуйте з будь-якого пристрою менш ніж за хвилину.","teachersTitle":"Для вчителів","teachersText":"Невелика підготовка для ранкової роботи, тих, хто рано закінчує роботу, заміни та робочих місць у класі — підготовка не потрібна."},"categories":{"eyebrow":"Упорядковано за темою та рівнем навичок","heading":"Переглядайте головоломки від точки до точки за категоріями","description":"Від простих форм із 10 крапок для малюків до задач із 200 крапок для дітей старшого віку — упорядковані за категоріями, тож ви за лічені секунди знайдете потрібну безкоштовну роздруківку.","puzzles":"{count, plural, one {# головоломка} other {# головоломок}}","comingSoon":"Скоро буде","badges":{"dinosaurs":"У наявності зараз!","ocean":"У наявності зараз!","playgrounds":"У наявності зараз!","garden":"У наявності зараз!","usa250":"Новинка!","uae":"У наявності зараз!","cute":"Нове!","circus":"Новий!"},"items":{"dinosaurs":{"name":"Динозаври","description":"Ревіть у доісторичну розвагу! Т-рекс, трицератопс, велоцираптор і {count} безкоштовні крапково-крапкові пазли, які сподобаються вашим дітям."},"animals":{"name":"Тварини","description":"Дружелюбні істоти для раннього вправляння в лічбі."},"vehicles":{"name":"Транспортні засоби","description":"Автомобілі, вантажівки, ракети та машини."},"fantasy":{"name":"Фантазія","description":"Замки, єдинороги, дракони та сюжетні підказки."},"seasonal":{"name":"Сезонний","description":"Святкові та класні календарні заходи."},"ocean":{"name":"океан","description":"Морські тварини і спокійні розмальовки."},"playgrounds":{"name":"Ігрові майданчики","description":"Гойдалки, гірки та розваги на природі для маленьких шукачів пригод."},"garden":{"name":"Сад","description":"Рукавиці, кельми та інструменти для маленьких помічників у саду."},"usa250":{"name":"Америці 250 років","description":"Відсвяткуйте 250-річчя Америки за допомогою патріотичних головоломок від крапки до крапки, присвячених історії Америки."},"uae":{"name":"ОАЕ","description":"Відкрийте для себе Об'єднані Арабські Емірати! Знакові пам’ятки, як-от Бурдж-ель-Араб, готові об’єднати та розфарбувати."},"space":{"name":"космос","description":"Планети, астронавти та ракетні пригоди."},"worksheets":{"name":"Робочі аркуші","description":"Листи з послідовністю чисел, готові вчителем."},"bigDotBooks":{"name":"Книги Big Dot","description":"Довгі головоломки для зосереджених старших учнів."},"cute":{"name":"Милий","description":"Чарівні цуценята, маленькі машинки та {count} чарівних безкоштовних головоломок «крапка в крапку», які сподобаються вашим дітям."},"circus":{"name":"Цирк","description":"Ведучі, великі намети та розважальні шоу для молодих учнів."}}},"puzzleSection":{"eyebrow":"Безкоштовні зразки для друку — без реєстрації","heading":"Популярні аркуші зі з’єднанням точок для друку","weeklyPack":"Перегляньте тижневий пакет →","downloadLink":"Завантажити безкоштовно для друку","new":"новий","imageAlt":"{name} безкоштовний робочий аркуш для друку від точки до точки для {age}","categories":{"Dinosaurs":"Динозаври","Ocean":"океан","Playgrounds":"Ігрові майданчики","Garden":"Сад","Cute":"Милий","USA 250 Years":"Америці 250 років","UAE":"ОАЕ"},"items":{"trex-61-dot-to-dot-puzzle":{"name":"Виклик 61 точки тиранозавра"},"brontosaurus-dot-to-dot-puzzle":{"name":"бронтозавр"},"mermaid-dot-to-dot-puzzle":{"name":"Русалка"},"merman-dot-to-dot-puzzle":{"name":"Мерман"},"seahorse-dot-to-dot-puzzle":{"name":"Морський коник"},"whale-dot-to-dot-puzzle":{"name":"кит"},"swing-playgrounds-dot-to-dot-puzzle":{"name":"Дитячий майданчик для гойдалок"},"slide-playgrounds-dot-to-dot-puzzle":{"name":"Ігровий майданчик для гірки"},"seesaw-playground-dot-to-dot-puzzle":{"name":"Дитячий майданчик для гойдалок"},"roller-coaster-playground-dot-to-dot-puzzle":{"name":"Дитячий майданчик для американських гірок"},"wheelbarrow-playground-dot-to-dot-puzzle":{"name":"Дитячий майданчик Тачка"},"garden-gloves-dot-to-dot-puzzle":{"name":"Садові рукавички"},"garden-trowel-dot-to-dot-puzzle":{"name":"Садова кельма"},"gas-balloon-usa-250-dot-to-dot-puzzle":{"name":"Газова куля Америка 250"},"america-250-birthday-fireworks-dot-to-dot-puzzle":{"name":"Феєрверк до дня народження Америки 250 років"},"america-250-anniversary-liberty-bell-wings-1776-dot-to-dot-puzzle":{"name":"Америка 250 крил Liberty Bell Wings"},"usa-250-astronaut-dot-to-dot-puzzle":{"name":"Америка 250 астронавт"},"usa-250-anniversary-sports-kids-podium-dot-to-dot-puzzle":{"name":"Дитячий спортивний подіум до 250-ї річниці Америки"},"usa-250-anniversary-airplane-banner-dot-to-dot-puzzle":{"name":"Банер з нагоди 250-річчя Америки"},"usa-250-space-shuttle-dot-to-dot-puzzle":{"name":"Космічний човник America 250"},"usa-250-birthday-balloons-stars-dot-to-dot-puzzle":{"name":"Америка 250 повітряних куль і зірок на день народження"},"usa-250-birthday-cake-dot-to-dot-puzzle":{"name":"Торт до дня народження America 250"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"Америка 250 Eagle Banner"},"burj-al-arab-dot-to-dot-puzzle":{"name":"Бурдж Аль-Араб"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"Кавоварка Dallah"}}},"benefits":{"eyebrow":"За підтримки вихователів раннього віку","heading":"Чому крапково-крапкові аркуші чудово підходять для розвитку дитини","description":"Роздруковані файли «З’єднай точки» — це більше, ніж просто розвага — це науково-дослідний інструмент, який використовують вихователі дошкільних закладів і дитячих садків для розвитку основних навичок раннього навчання.","fineMotorTitle":"Розвиває дрібну моторику","fineMotorText":"Малювання пунктирних ліній розвиває ручку олівця, координацію рук і очей і контроль м’язів, необхідний дітям для рукописного тексту.","numberTitle":"Посилює розпізнавання чисел","numberText":"Послідовність крапок 1 → 2 → 3 навчає порядку підрахунку, розпізнавання чисел і ранніх математичних концепцій природним шляхом через гру.","focusTitle":"Покращує фокус і концентрацію","focusText":"Розгадування головоломки «З’єднай точки» вимагає постійної уваги — спокійний спосіб зосередитися без екрану для дошкільнят до 3 класу.","confidenceTitle":"Миттєва винагорода та впевненість","confidenceText":"Коли з’являється прихована картинка, діти одразу відчувають досягнення. Ця маленька перемога формує любов до навчання та мислення для зростання."},"howTo":{"eyebrow":"Готовий менш ніж за 60 секунд","heading":"Як завантажити та роздрукувати безкоштовні робочі таблиці крапка за точкою","step1Title":"Виберіть свою головоломку","step1Text":"Виберіть тему (тварини, динозаври, транспортні засоби, свята) і діапазон крапок відповідно до віку та рівня навичок вашої дитини.","step2Title":"Завантажте безкоштовний PDF","step2Text":"Натисніть «Завантажити безкоштовно для друку» — без облікового запису, електронної пошти та платного доступу. Ваш браузер миттєво завантажує PDF-файл.","step3Title":"Роздрукуйте та насолоджуйтесь","step3Text":"Друкуйте на стандартному папері US Letter (8,5 × 11 дюймів). Чорно-біле працює ідеально. Дайте його своїй дитині та спостерігайте, як вони з’єднують крапки!"},"trust":{"eyebrow":"Чому батьки та вчителі обирають нас","heading":"Безкоштовний, безпечний і неймовірно простий у використанні.","noAccountTitle":"Обліковий запис не потрібен","noAccountText":"Every dot-to-dot printable downloads immediately — no sign-up, no email, no paywall. Просто натисніть і роздрукуйте.","safeTitle":"Сейф для класу","safeText":"Чисті сторінки головоломок без реклами, призначені для шкільних друкарень. Працює для ранкової роботи, домашнього завдання або тихого часу.","fastTitle":"Швидкий за дизайном","fastText":"Статичні сторінки, оптимізовані зображення та локальні шрифти означають, що головоломки швидко завантажуються на будь-якому пристрої — телефоні, планшеті чи ноутбуці."},"faq":{"eyebrow":"Загальні запитання","heading":"Часті запитання","q1":"Чи всі файли для точкового друку на цьому сайті абсолютно безкоштовні?","a1":"Так — кожен робочий аркуш зі з’єднанням точок на DotToDotFreePrintables.com на 100% безкоштовний для завантаження та друку. Обліковий запис, підписка чи кредитна картка ніколи не потрібні.","q2":"Для якого віку підходять таблиці з крапкою?","a2":"Наші роздруковані матеріали охоплюють вік від 2 до 12 років. Легкі робочі аркуші (10–20 крапок) підходять малюкам і дошкільникам, середні аркуші (20–50 крапок) чудово підходять для дитячого садка та 1-го класу, а жорсткіші аркуші (50–200+ крапок) — завдання для учнів 2-6 класів.","q3":"У якому форматі є файли для друку «З’єднай точки»?","a3":"Усі аркуші завантажуються як готові для друку PDF-файли розміром для стандартного паперу US Letter (8,5 дюйма × 11 дюймів). Відкрийте в будь-якому браузері або засобі перегляду PDF-файлів і роздрукуйте — не потрібне спеціальне програмне забезпечення.","q4":"Чи є у вас робочі аркуші для дошкільного та дитячого садка?","a4":"Абсолютно. Наші найпростіші робочі аркуші починаються з 1–10 крапок (ідеально підходять для дітей віком 2–4 роки) і включають алфавіт і теми для розпізнавання цифр, розроблені для дошкільних класів і класів дитячих садків.","q5":"Чи можуть вчителі використовувати ці робочі аркуші зі з’єднанням точок у класі?","a5":"так! Наші роздруковані матеріали безкоштовні для особистого використання та використання в класі. Вони популярні для ранкової роботи, занять для раннього закінчення, планів уроків на заміну, центрів дрібної моторики та пакетів домашніх завдань.","q6":"Чи допомагають головоломки по крапках розвивати дрібну моторику?","a6":"Так — малювання ліній між крапками підвищує міцність рукописного захоплення та координацію рук і очей, які підтримують готовність рукописного тексту. З цієї причини багато ерготерапевтів і вихователів дитячих садків рекомендують комплексні вправи.","q7":"У вас є тематичні крапково-крапкові малюнки для друку, як-от тварини чи динозаври?","a7":"У нас є 11 категорій, зокрема тварини, динозаври, транспортні засоби, океанські створіння, ігрові майданчики, Америка 250 років, космос, фентезі, сезонні/святкові теми, набори аркушів для вчителя та книги з великою крапкою. Нові дизайни додаються щотижня.","q8":"Чи можу я роздрукувати ці головоломки чорно-білими?","a8":"Так — усі наші робочі аркуші типу «з’єднай точки» призначені для чорно-білого друку, щоб заощадити чорнило. Вони чудово виглядають на будь-якому домашньому чи аудиторному принтері."},"newsletter":{"eyebrow":"Стартовий пакет для друку — абсолютно безкоштовно","heading":"Отримайте 20 безкоштовних точкових роздруківок на вашу поштову скриньку.","description":"Зручна для батьків і вчителів колекція, яка охоплює тварин, транспортні засоби, динозаврів і сезонні теми — усі розміри підходять для стандартного паперу US Letter і оптимізовані для чорно-білого друку."},"blog":{"eyebrow":"Ідеї ​​для дорослих","heading":"Поради щодо навчання вдома та в класі","viewAll":"Переглянути всі статті","read":"Прочитайте"},"feedback":{"eyebrow":"Ми будемо раді почути від вас","heading":"Надіслати відгук","description":"Маєте ідею головоломки, помітили несправне посилання чи просто хочете привітатися? Напишіть нам повідомлення нижче."},"footer":{"description":"Безкоштовні крапково-крапкові роздруківки та робочі аркуші зі з’єднанням крапок для дітей, батьків і вчителів. Усі головоломки можна безкоштовно завантажити, роздрукувати та поділитися.","kids":"діти","parents":"Батьки","teachers":"Вчителі","blog":"Блог","faq":"Найчастіші запитання","feedback":"Зворотній зв'язок","about":"Про нас","contact":"Контакти","privacy":"Конфіденційність","terms":"Умови","sitemap":"Карта сайту","copyright":"© {year} DotToDotFreePrintables.com · Безкоштовні роздруковані завдання для дітей"},"common":{"home":"додому","new":"новий","comingSoon":"Скоро буде","downloadFree":"Завантажити безкоштовно для друку","viewDownload":"Переглянути та завантажити","shareTitle":"{name} Роздруковка з точками - Безкоштовний PDF","downloadAria":"Завантажте безкоштовний PDF з роздруківкою {name} з точками","bookmarkTitle":"{name} Роздруковка з точками – Безкоштовний PDF для дітей","showSlide":"Показати слайд {number}","ageRange":"Вік {min}-{max}","difficultyLabel":"Складність {level} з 3","difficulty":{"1":"легко","2":"Середній","3":"важко"},"dots":"1–{count} крапок","homeVideoEyebrow":"відео","homeVideoH2":"Дивіться розваги від точки до точки в дії","skipToContent":"Перейти до основного контенту","joinTeachers":"Приєднайтеся до {count}+ вчителів","breadcrumbAria":"Хлібні крихти"},"puzzleSearch":{"placeholder":"Search by name or topic... e.g. ocean, whale, T-Rex","searchAria":"Пошукові головоломки","clearSearch":"Clear search","toggleFilters":"Toggle filters","filters":"Filters","filterOptions":"Filter options","topic":"Topic","numberOfDots":"Number of dots","recentlyAddedOnly":"Recently added only","clearAllFilters":"Clear all filters","clearFilters":"Clear filters","resultsFound":"{count, plural, one {# знайдена головоломка} other {# знайдених головоломок}}","puzzlesAvailable":"{count, plural, one {# puzzle available} other {# puzzles available}}","noMatches":"Жодна головоломка не відповідає вашому запиту.","openPuzzle":"Open {name}","imageAlt":"{name} для точкового друку","viewPuzzle":"View puzzle →","dotRanges":{"under35":"Under 35 dots","35to50":"35-50 dots","51to70":"51-70 dots","over70":"70+ dots"},"categories":{"Dinosaurs":"Dinosaurs","Ocean":"Ocean","Playgrounds":"Playgrounds","Garden":"Garden","Cute":"Cute","USA 250 Years":"America 250 Years","UAE":"UAE"}},"newsletterForm":{"ariaLabel":"Отримайте безкоштовний комплект для друку крапкою","emailLabel":"Адреса електронної пошти","submit":"Надішліть безкоштовний пакет","honeypot":"Залиште це поле порожнім","privacy":"Жодного спаму. Скасуйте підписку в будь-який час.","error":"Неможливо надіслати цю форму.","notConnected":"Реєстрація на безкоштовний пакет ще не підключена."},"feedbackForm":{"ariaLabel":"Надіслати відгук","notConnected":"Ця форма зворотного зв'язку ще не підключена.","typeLabel":"Який зворотній зв'язок?","selectTopic":"Виберіть тему...","types":{"general":"Загальний відгук","requestTheme":"Запитайте тему головоломки","brokenLink":"Повідомте про несправне посилання","improvement":"Запропонуйте покращення","other":"інше"},"messageLabel":"Ваше повідомлення","messagePlaceholde