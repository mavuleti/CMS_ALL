2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://dottodotfreeprintables.com/tr/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ocean\",\"item\":\"https://dottodotfreeprintables.com/tr/ocean/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Denizkızı\",\"item\":\"https://dottodotfreeprintables.com/tr/ocean/mermaid-dot-to-dot-puzzle/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"Denizkızı\",\"description\":\"Deniz kızı hikayeleri 3,000 yıldan fazla bir geçmişe sahiptir. 5-8 yaş arası çocuklar için bu ücretsiz yazdırılabilir PDF ile 54 noktada büyülü bir yüzücüyü ortaya çıkarın.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"İz","children":[["$","$Lf",null,{"href":"/tr/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Ev"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/tr/ocean/","children":"Ocean"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"Denizkızı"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Suyun altında süzülen denizkızı, kuyruğu 54 yazdırılabilir noktayla şekillenmiş","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":["Free ","Ocean"," Printable"]}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Denizkızı Dot-to-Dot Printable"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Noktaları birleştirerek okyanusta süzülen güzel bir deniz kızını ortaya çıkarın. Bu kolay 54 noktalı bulmaca, genç öğrenicilerin sayı sıralama pratiği yaparken su altı büyüsünün tadını çıkarması için mükemmeldir."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Zorluk seviyesi 1 (3 üzerinden)","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Deniz kızları, 3000 yıldan daha eski Asur folklorunda yer almaktadır!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],["$","p",null,{"className":"asset-note","children":"Printable PDF path is not present in the export JSON."}],"$L10",["$","$L11",null,{"title":"Denizkızı Bağlantı Noktası Yazdırılabilir - Ücretsiz PDF","imageUrl":"","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/tr/ocean/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}]," Back to all ","Ocean"," puzzles"]}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Denizkızı"," Dot-to-Dot Puzzle Guide"]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Deniz kızları, Asur'un kadim denizlerinden Hans Christian Andersen'in masallarına kadar binlerce yıldır çocukların hayal gücünü cezbetmiştir. Bu güzel 54 noktalı yapboz, derinliklerde süzülen zarif bir deniz kızının silüetini çiziyor. Sakin ve odaklanmış zamanlar için harika bir yapboz; yağmurlu bir öğleden sonra veya <a href=\"/tr/playgrounds/\">çocuklar için sakin bir sınıf etkinliği</a> için mükemmel. 1. noktayı bulun ve sihir başlasın!"}}],[["$","div","1–9",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–9"," — ","Yüz ve Saç"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"1. noktadan başlayıp 9. noktaya kadar ilerleyerek deniz kızının yüzünü ve saçlarının akıcı çizgilerini çizin. Yüzler, yumuşak, yuvarlak hatlar içerir; bu, ilerideki daha büyük şekillerden önce kalem kullanma konusunda özgüven kazandıran güzel bir ısınma egzersizidir. Çocukları bileklerini hafifçe kaldırmaya ve kalemin kaymasına izin vermeye teşvik edin."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Deniz kızı efsaneleri, Batı Afrika su ruhlarından Japon Ningyo'ya ve antik Yunan deniz perisi Nereidlere kadar dünyanın dört bir yanındaki kültürlerde birbirinden bağımsız olarak ortaya çıkmıştır. Yarı insan, yarı balık varlıklar fikri, okyanus ne olursa olsun, insan hayal gücünün sürekli olarak vardığı bir şey gibi görünüyor."]}]]}]]}],["$","div","10–22",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["10–22"," — ","Kollar ve Üst Vücut"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"10. noktadan 22. noktaya kadar devam ederek kolları ve gövdeyi çizin. Çocuklar burada simetriyi ve insan figürünün doğal kıvrımlarını öğrenirler; bu bölüm, vücut oranlarını eğlenceli ve rahat bir şekilde tartışmak için özellikle uygundur. Hafif ve akıcı bir dokunuş en zarif sonucu verir."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"İngilizce konuşulan kültürdeki en ünlü denizkızı öyküsü olan Küçük Denizkızı, Hans Christian Andersen tarafından 1837'de yazılmıştır. Orijinal öykü, animasyon filminden oldukça farklıdır: çok daha buruk bir tat bırakır ve fedakarlık, özlem ve ruha sahip olmanın ne anlama geldiği üzerine düşünmeyi amaçlar."]}]]}]]}],["$","div","23–36",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["23–36"," — ","Bel ve Terazi"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"23 ile 36 arasındaki noktaları takip ederek, insan figürünün balık kuyruğuna dönüştüğü orta bölümü çizin; bu bölüm, çizimin en belirgin denizkızı kısmını oluşturur. Çocuklar, daralan ve sonra tekrar genişleyen bir şekli takip etmeyi öğrenirler. Bu orta bölüm, sabrı ve dikkatli nokta bulmayı ödüllendirir."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Bilim insanları, deniz kızı efsanesinin kısmen denizcilerin denizde manati veya dugong görmelerinden kaynaklanmış olabileceğine inanıyor. Uzaktan bakıldığında, yuvarlak gövdesi ve kürek benzeri kuyruğuyla nefes almak için su yüzüne çıkan bir manati şaşırtıcı derecede insana benzeyebilir. Bu cömert bir yorum olsa da, yalnızlık ve mesafe hayal gücü üzerinde olağanüstü etkiler yaratır."]}]]}]]}],["$","div","37–46",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["37–46"," — ","Balık Kuyruğu"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"37 ile 46 arasındaki noktaları birleştirerek uzun, zarif balık kuyruğunu aşağı doğru çizin. Bu, bulmacanın en tatmin edici bölümüdür; çocuklar deniz kızının son, tanınabilir şeklini aldığını hissederler. Uzun, akıcı çizgiler burada harika sonuç verir. Çocukları sadece bilekten değil, omuzdan da çizim yapmaya teşvik edin."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Denizkızlarıyla ilgili çoğu folklorik anlatıda, kuyruk yanardöner olarak tanımlanır; tıpkı güneş ışığında bir sabun köpüğü veya balık pulu gibi birçok renkle parıldar. Bu yapbozu renklendirmeye gelince, yanlış cevap yoktur: gümüş, okyanus mavisi, zümrüt yeşili veya üçü birden aynı anda, hepsi eşit derecede geçerlidir!"]}]]}]]}],["$","div","47–54",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["47–54"," — ","Kuyruk Kanatları"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Deniz kızının silüetini tamamlayan geniş, kıvrımlı kuyruk yüzgeçlerini eklemek için 47 ile 54 arasındaki noktaları birleştirerek bitirin. Bitirme çizgisine sadece sekiz nokta kaldı — çocukları her bir noktayı değerlendirmeye ve kendinden emin, zarif bir şekilde bitirmeye teşvik edin. Kuyruk yüzgeci deniz kızının son noktasıdır!"}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Balık kuyrukları yanlara doğru hareket ederken, balina ve yunus kuyrukları (yüzgeç adı verilen) yukarı ve aşağı hareket eder. Gerçek hayatta bir deniz kızı var olsaydı, bilim insanları insan şeklindeki üst vücut için hangi kuyruk stilinin daha mantıklı olacağı konusunda tartışıyorlar. İnsan kalçalarının hareket şekline dayanarak, cevabın muhtemelen yukarı ve aşağı hareket eden yunus stili olacağı düşünülüyor."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["More free ","Ocean"," printables"]}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","merman-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/tr/ocean/merman-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Dalgalardan yükselen deniz adamı, 44 kolay noktayla anaokulu seviyesinde çizilmiş","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","children":[["$","p",null,{"className":"puzzle-category","children":"Ocean"}],["$","h3",null,{"children":"Deniz adamı"}],["$","div",null,{"className":"puzzle-meta","children":[["$","span",null,{"