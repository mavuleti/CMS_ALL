e:["$","$L12",null,{"formats":"$undefined","locale":"id","messages":{"nav":{"scanMe":"Pindai saya","blog":"Blog","search":"Mencari","kids":"Anak-anak - Teka-teki","teachers":"Guru","parents":"Orang tua","contact":"Hubungi kami","freePack":"Paket gratis"},"homepageUi":{"title":"Temukan lembar cetak titik-ke-titik yang sempurna","description":"Cetak, hubungkan titik-titiknya, dan hidupkan gambar-gambar menakjubkan. Gratis dan siap untuk keseruan!","searchPlaceholder":"Coba laut, dinosaurus, atau bunga","filterPuzzles":"Filter teka-teki","age":"Usia","dots":"titik","featuredPuzzles":"Teka-teki cetak unggulan","savePuzzle":"Simpan {name}","removeSavedPuzzle":"Hapus {name} dari yang tersimpan","downloads":"unduhan","bookTitle":"Terbaik 2026 · {count}","bookDescription":"Teka-teki titik-ke-titik favorit kami dalam satu buku PDF siap cetak.","searchUnavailable":"Pencarian sementara tidak tersedia. Silakan coba lagi.","popularEyebrow":"Populer minggu ini","mostDownloaded":"Teka-teki yang paling banyak diunduh","downloadCountAria":"{count} atau lebih unduhan","freshPrintables":"Cetakan baru","recentlyAdded":"Baru ditambahkan","browseCategories":"Jelajahi kategori teka-teki","openCategories":"Buka menu kategori","closeCategories":"Tutup menu kategori","browseByTheme":"Jelajahi berdasarkan tema","quickLinks":"Tautan cepat","bundlePacks":"Paket Bundel","parentsTeachers":"Untuk Orang Tua & Guru","more":"Lebih banyak kategori","kids":"Anak-anak","categoryNames":{"cute":"Teka-teki Lucu","flowers":"Bunga"}},"audience":{"kidsTitle":"Untuk anak-anak","kidsText":"Tema hewan ramah, dinosaurus, dan kendaraan dengan titik-titik bernomor yang jelas. Kemenangan mudah yang membangun kepercayaan diri nyata.","parentsTitle":"Untuk orang tua","parentsText":"Aktivitas tenang tanpa layar untuk di rumah, saat bepergian, dan di restoran. Cetak dari perangkat apa pun dalam waktu kurang dari satu menit.","teachersTitle":"Untuk guru","teachersText":"Permainan menghubungkan titik-titik yang mudah disiapkan untuk kegiatan pagi, siswa yang menyelesaikan tugas lebih cepat, guru pengganti, dan stasiun kelas — tidak memerlukan persiapan apa pun."},"categories":{"eyebrow":"Disusun berdasarkan tema dan tingkat keahlian.","heading":"Telusuri teka-teki menghubungkan titik berdasarkan kategori","description":"Mulai dari bentuk 10 titik sederhana untuk balita hingga tantangan 200 titik untuk anak yang lebih besar — ​​diurutkan berdasarkan kategori sehingga Anda dapat menemukan lembar kerja gratis yang tepat dalam hitungan detik.","puzzles":"{count, plural, one {# teka-teki} other {# teka-teki}}","comingSoon":"Segera hadir","badges":{"dinosaurs":"Tersedia sekarang!","ocean":"Tersedia sekarang!","playgrounds":"Tersedia sekarang!","garden":"Tersedia sekarang!","usa250":"Baru!","uae":"Tersedia sekarang!","cute":"Baru!","circus":"Baru!"},"items":{"dinosaurs":{"name":"Dinosaurus","description":"Ayo berpetualang ke dunia prasejarah! Teka-teki menghubungkan titik-titik gratis bergambar T-Rex, Triceratops, Velociraptor, dan {count} yang pasti disukai anak-anak Anda."},"animals":{"name":"Hewan","description":"Makhluk ramah untuk latihan berhitung dasar."},"vehicles":{"name":"Kendaraan","description":"Mobil, truk, roket, dan mesin."},"fantasy":{"name":"Fantasi","description":"Kastil, unicorn, naga, dan ide cerita."},"seasonal":{"name":"Musiman","description":"Kegiatan kalender liburan dan kelas."},"ocean":{"name":"Laut","description":"Halaman mewarnai bertema hewan laut dan suasana tenang."},"playgrounds":{"name":"Taman bermain","description":"Ayunan, perosotan, dan keseruan luar ruangan untuk petualang kecil."},"garden":{"name":"Kebun","description":"Sarung tangan, sekop kecil, dan peralatan untuk para pembantu kecil di kebun."},"usa250":{"name":"Amerika 250 Tahun","description":"Rayakan ulang tahun Amerika yang ke-250 dengan teka-teki menghubungkan titik-titik bertema patriotik yang menghormati sejarah Amerika."},"uae":{"name":"UEA","description":"Jelajahi Uni Emirat Arab! Landmark ikonik seperti Burj Al Arab, siap untuk Anda kunjungi dan warnai."},"space":{"name":"Ruang angkasa","description":"Planet, astronot, dan petualangan roket."},"worksheets":{"name":"Lembar Kerja","description":"Lembar kerja pengurutan angka yang siap digunakan guru."},"bigDotBooks":{"name":"Buku Titik Besar","description":"Teka-teki panjang untuk pelajar usia lanjut yang fokus."},"cute":{"name":"Imut-imut","description":"Anak anjing yang menggemaskan, mobil-mobilan kecil, dan {count} teka-teki menghubungkan titik yang menawan dan gratis yang akan disukai anak-anak Anda."},"circus":{"name":"Sirkus","description":"Pengatur ring, tenda besar, dan kesenangan waktu pertunjukan untuk pembelajar muda."}}},"puzzleSection":{"eyebrow":"Contoh yang dapat dicetak gratis — tanpa perlu mendaftar","heading":"Lembar menghubungkan titik-titik populer yang dapat dicetak sekarang","weeklyPack":"Lihat paket mingguan →","downloadLink":"Unduh lembaran cetak gratis","new":"Baru","imageAlt":"Lembar kerja menghubungkan titik-titik gratis untuk {name} dan {age}.","categories":{"Dinosaurs":"Dinosaurus","Ocean":"Laut","Playgrounds":"Taman bermain","Garden":"Kebun","Cute":"Imut-imut","USA 250 Years":"Amerika 250 Tahun","UAE":"UEA"},"items":{"trex-61-dot-to-dot-puzzle":{"name":"Tantangan 61 Titik T-Rex"},"brontosaurus-dot-to-dot-puzzle":{"name":"Brontosaurus"},"mermaid-dot-to-dot-puzzle":{"name":"Putri Duyung"},"merman-dot-to-dot-puzzle":{"name":"Ikan duyung jantan"},"seahorse-dot-to-dot-puzzle":{"name":"Kuda laut"},"whale-dot-to-dot-puzzle":{"name":"Paus"},"swing-playgrounds-dot-to-dot-puzzle":{"name":"Taman Bermain Ayunan"},"slide-playgrounds-dot-to-dot-puzzle":{"name":"Taman Bermain Seluncuran"},"seesaw-playground-dot-to-dot-puzzle":{"name":"Taman Bermain Jungkat-jungkit"},"roller-coaster-playground-dot-to-dot-puzzle":{"name":"Taman Bermain Roller Coaster"},"wheelbarrow-playground-dot-to-dot-puzzle":{"name":"Taman Bermain Gerobak Dorong"},"garden-gloves-dot-to-dot-puzzle":{"name":"Sarung Tangan Berkebun"},"garden-trowel-dot-to-dot-puzzle":{"name":"Sekop Kebun"},"gas-balloon-usa-250-dot-to-dot-puzzle":{"name":"Balon Gas Amerika 250"},"america-250-birthday-fireworks-dot-to-dot-puzzle":{"name":"Kembang Api Ulang Tahun Amerika ke-250"},"america-250-anniversary-liberty-bell-wings-1776-dot-to-dot-puzzle":{"name":"Amerika 250 Sayap Lonceng Kemerdekaan"},"usa-250-astronaut-dot-to-dot-puzzle":{"name":"Amerika 250 Astronot"},"usa-250-anniversary-sports-kids-podium-dot-to-dot-puzzle":{"name":"Podium Anak-Anak Olahraga Peringatan 250 Tahun Amerika"},"usa-250-anniversary-airplane-banner-dot-to-dot-puzzle":{"name":"Spanduk Pesawat Peringatan 250 Tahun Amerika"},"usa-250-space-shuttle-dot-to-dot-puzzle":{"name":"Pesawat Ulang-alik Amerika 250"},"usa-250-birthday-balloons-stars-dot-to-dot-puzzle":{"name":"Balon dan Bintang Ulang Tahun Amerika ke-250"},"usa-250-birthday-cake-dot-to-dot-puzzle":{"name":"Kue Ulang Tahun Amerika ke-250"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"Bendera Elang Amerika 250"},"burj-al-arab-dot-to-dot-puzzle":{"name":"Burj Al Arab"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"Teko Kopi Dallah"}}},"benefits":{"eyebrow":"Didukung oleh para pendidik anak usia dini","heading":"Mengapa lembar kerja menghubungkan titik-titik sangat bagus untuk perkembangan anak?","description":"Lembar kerja menghubungkan titik-titik bukan hanya sekadar hiburan—ini adalah alat berbasis riset yang digunakan oleh guru prasekolah dan taman kanak-kanak untuk membangun keterampilan belajar awal yang mendasar.","fineMotorTitle":"Mengembangkan keterampilan motorik halus","fineMotorText":"Menggambar garis titik-ke-titik mengembangkan cara memegang pensil, koordinasi mata-tangan, dan kontrol otot yang dibutuhkan anak-anak untuk menulis.","numberTitle":"Memperkuat pengenalan angka","numberText":"Mengikuti titik 1 → 2 → 3 secara berurutan mengajarkan urutan berhitung, pengenalan angka, dan konsep matematika dasar secara alami melalui permainan.","focusTitle":"Meningkatkan fokus dan konsentrasi","focusText":"Menyelesaikan teka-teki menghubungkan titik-titik membutuhkan perhatian yang berkelanjutan — cara yang tenang dan bebas layar untuk melatih fokus bagi anak prasekolah hingga kelas 3.","confidenceTitle":"Imbalan dan kepercayaan diri instan","confidenceText":"Ketika gambar tersembunyi muncul, anak-anak langsung merasakan rasa pencapaian. Kemenangan kecil itu menumbuhkan kecintaan terhadap belajar dan pola pikir berkembang."},"howTo":{"eyebrow":"Siap dalam waktu kurang dari 60 detik","heading":"Cara mengunduh dan mencetak lembar kerja menghubungkan titik-titik gratis Anda","step1Title":"Pilih teka-teki Anda","step1Text":"Pilih tema (hewan, dinosaurus, kendaraan, liburan) dan rentang titik yang sesuai dengan usia dan tingkat kemampuan anak Anda.","step2Title":"Unduh PDF gratis","step2Text":"Klik \"Unduh versi cetak gratis\" — tanpa akun, tanpa email, tanpa biaya. Browser Anda akan langsung mengunduh PDF.","step3Title":"Cetak dan nikmati.","step3Text":"Cetak di kertas ukuran standar US Letter (8,5\" × 11\"). Hitam putih sangat cocok. Berikan kepada anak Anda dan lihat mereka menghubungkan titik-titiknya!"},"trust":{"eyebrow":"Mengapa orang tua dan guru memilih kami?","heading":"Gratis, aman, dan sangat mudah digunakan.","noAccountTitle":"Tidak perlu membuat akun.","noAccountText":"Setiap lembar kerja menghubungkan titik-titik dapat diunduh secara instan — tanpa pendaftaran, tanpa email, tanpa biaya. Cukup klik dan cetak.","safeTitle":"Ruang kelas aman","safeText":"Halaman puzzle bersih dan bebas iklan yang dirancang untuk printer sekolah. Cocok untuk kegiatan pagi, pekerjaan rumah, atau waktu tenang.","fastTitle":"Dirancang untuk kecepatan.","fastText":"Halaman statis, gambar yang dioptimalkan, dan font lokal berarti teka-teki dimuat dengan cepat di perangkat apa pun — ponsel, tablet, atau laptop."},"faq":{"eyebrow":"Pertanyaan umum","heading":"Pertanyaan yang sering diajukan","q1":"Apakah semua lembar kerja menghubungkan titik-titik di situs ini sepenuhnya gratis?","a1":"Ya — setiap lembar kerja menghubungkan titik-titik di DotToDotFreePrintables.com 100% gratis untuk diunduh dan dicetak. Tidak diperlukan akun, langganan, atau kartu kredit.","q2":"Lembar kerja menghubungkan titik-titik cocok untuk usia berapa?","a2":"Materi cetak kami mencakup usia 2–12 tahun. Lembar kerja mudah (10–20 titik) cocok untuk balita dan anak prasekolah, lembar kerja sedang (20–50 titik) bagus untuk taman kanak-kanak dan kelas 1, dan lembar kerja yang lebih sulit (50–200+ titik) menantang siswa kelas 2 hingga 6.","q3":"Apa format lembar kerja menghubungkan titik-titik yang dapat dicetak?","a3":"Semua lembar kerja dapat diunduh sebagai file PDF siap cetak dengan ukuran kertas standar US Letter (8,5\" × 11\"). Buka di browser atau penampil PDF apa pun dan cetak — tidak diperlukan perangkat lunak khusus.","q4":"Apakah Anda memiliki lembar kerja menghubungkan titik-titik untuk anak prasekolah dan taman kanak-kanak?","a4":"Tentu saja. Lembar kerja termudah kami dimulai dari 1–10 titik (cocok untuk usia 2–4 ​​tahun) dan mencakup tema pengenalan alfabet dan angka yang dirancang untuk kelas prasekolah dan taman kanak-kanak.","q5":"Apakah guru dapat menggunakan lembar kerja menghubungkan titik-titik ini di kelas?","a5":"Ya! Materi cetak kami gratis untuk penggunaan pribadi dan di kelas. Materi ini populer untuk kegiatan pagi hari, aktivitas bagi siswa yang menyelesaikan tugas lebih cepat, rencana pelajaran pengganti, pusat keterampilan motorik halus, dan paket pekerjaan rumah.","q6":"Apakah teka-teki menghubungkan titik-titik membantu meningkatkan keterampilan motorik halus?","a6":"Ya — menggambar garis di antara titik-titik membangun kekuatan genggaman pensil dan koordinasi mata-tangan yang mendukung kesiapan menulis. Banyak terapis okupasi dan guru taman kanak-kanak merekomendasikan aktivitas menghubungkan titik-titik karena alasan ini.","q7":"Apakah Anda memiliki lembar kerja menghubungkan titik-titik bertema seperti hewan atau dinosaurus?","a7":"Kami memiliki 11 kategori termasuk hewan, dinosaurus, kendaraan, makhluk laut, taman bermain, Amerika 250 Tahun, luar angkasa, fantasi, tema musiman/liburan, paket lembar kerja guru, dan buku titik besar. Desain baru ditambahkan setiap minggu.","q8":"Bisakah saya mencetak teka-teki ini dalam warna hitam putih?","a8":"Ya — semua lembar kerja menghubungkan titik-titik kami dirancang untuk dicetak hitam putih agar menghemat tinta. Hasilnya terlihat bagus di printer rumah atau kelas mana pun."},"newsletter":{"eyebrow":"Paket pemula yang dapat dicetak — sepenuhnya gratis.","heading":"Dapatkan 20 lembar kerja menghubungkan titik secara gratis yang dikirimkan ke kotak masuk Anda.","description":"Koleksi yang ramah bagi orang tua dan guru, mencakup hewan, kendaraan, dinosaurus, dan tema musiman — semuanya berukuran sesuai kertas US Letter standar dan dioptimalkan untuk pencetakan hitam putih."},"blog":{"eyebrow":"Ide untuk orang dewasa","heading":"Tips belajar untuk di rumah dan di kelas","viewAll":"Lihat semua artikel","read":"Membaca"},"feedback":{"eyebrow":"Kami ingin sekali mendengar kabar dari Anda.","heading":"Kirim masukan","description":"Punya ide teka-teki, menemukan tautan yang rusak, atau hanya ingin menyapa? Kirimkan pesan kepada kami di bawah ini."},"footer":{"description":"Lembar kerja menghubungkan titik-titik dan teka-teki gratis untuk anak-anak, orang tua, dan guru. Semua teka-teki dapat diunduh, dicetak, dan dibagikan secara gratis.","kids":"Anak-anak","parents":"Orang tua","teachers":"Guru","blog":"Blog","faq":"FAQ","feedback":"Masukan","about":"Tentang","contact":"Kontak","privacy":"Pribadi","terms":"Ketentuan","sitemap":"Peta Situs","copyright":"© {year} DotToDotFreePrintables.com · Aktivitas cetak gratis untuk anak-anak"},"common":{"home":"Rumah","new":"Baru","comingSoon":"Segera hadir","downloadFree":"Unduh lembaran cetak gratis","viewDownload":"Lihat & Unduh","shareTitle":"{name} Dot-to-Dot Cetak - PDF Gratis","downloadAria":"Unduh PDF cetak dot-to-dot {name} gratis","bookmarkTitle":"{name} Dot-to-Dot Cetak – PDF Gratis untuk Anak-anak","showSlide":"Tampilkan slide {number}","ageRange":"Usia {min}-{max}","difficultyLabel":"Tingkat kesulitan {level} dari 3","difficulty":{"1":"Mudah","2":"Sedang","3":"Keras"},"dots":"1–{count} titik","homeVideoEyebrow":"Video","homeVideoH2":"Saksikan keseruan menghubungkan titik-titik dalam aksi.","skipToContent":"Lompat ke konten utama","joinTeachers":"Bergabunglah dengan {count}+ guru","breadcrumbAria":"Roti lapis"},"puzzleSearch":{"placeholder":"Search by name or topic... e.g. ocean, whale, T-Rex","searchAria":"Teka-teki pencarian","clearSearch":"Clear search","toggleFilters":"Toggle filters","filters":"Filters","filterOptions":"Filter options","topic":"Topic","numberOfDots":"Number of dots","recentlyAddedOnly":"Recently added only","clearAllFilters":"Clear all filters","clearFilters":"Clear filters","resultsFound":"{count, plural, one {# teka-teki ditemukan} other {# teka-teki ditemukan}}","puzzlesAvailable":"{count, plural, one {# puzzle available} other {# puzzles available}}","noMatches":"Tidak ada teka-teki yang sesuai dengan pencarian Anda.","openPuzzle":"Open {name}","imageAlt":"{name} gambar titik-ke-titik yang dapat dicetak","viewPuzzle":"View puzzle →","dotRanges":{"under35":"Under 35 dots","35to50":"35-50 dots","51to70":"51-70 dots","over70":"70+ dots"},"categories":{"Dinosaurs":"Dinosaurs","Ocean":"Ocean","Playgrounds":"Playgrounds","Garden":"Garden","Cute":"Cute","USA 250 Years":"America 250 Years","UAE":"UAE"}},"newsletterForm":{"ariaLabel":"Dapatkan paket gambar menghubungkan titik-titik yang dapat dicetak secara gratis.","emailLabel":"Alamat email","submit":"Kirim paket gratis","honeypot":"Biarkan kolom ini kosong","privacy":"Tidak ada spam, selamanya. Berhenti berlangganan kapan saja.","error":"Formulir ini tidak dapat dikirim.","notConnected":"Pendaftaran paket gratis belum terhubung."},"feedbackForm":{"ariaLabel":"Kirim masukan","notConnected":"Formulir umpan balik ini belum terhubung.","typeLabel":"Umpan balik seperti apa?","selectTopic":"Pilih topik...","types":{"general":"Umpan balik umum","requestTheme":"Minta tema teka-teki","brokenLink":"Laporkan tautan yang rusak","improvement":"Sarankan perbaikan","other":"Lainnya"},"messageLabel":"Pesan Anda","messagePlaceholder":"Sampaikan pendapat Anda...","emailLabel":"E-mail","emailOptional":"(Opsional - hanya jika Anda menginginkan balasan)","submit":"Kirim masukan","success":"Terima kasih. Masukan Anda telah dikirim.","disclaimer":"Mohon jangan menyertakan informasi pribadi yang sensitif. Alamat email bersifat opsional dan hanya digunakan jika kami perlu membalas.","iframeTitle":"Pengajuan umpan balik"},"contactPage":{"title":"Contact Us","intro":"The fastest way to reach us is email:","topicsTitle":"What we're happy to hear about","requestsTitle":"Puzzle requests.","requests":"Tell us a theme your child or class loves and the rough age range — requests genuinely shape what we publish next.","correctionsTitle":"Corrections.","corrections":"A misnumbered dot, a printing problem, a translation that reads oddly — report it and we will fix the page.","licensingTitle":"Classroom and licensing questions.","licensing":"Personal and classroom printing is already free. For anything beyond that — republishing, bundling, or commercial use — ask first.","licensingNote":"(see our <link>terms of use</link>).","feedbackTitle":"Feedback.","feedback":"What works, what doesn't, what you would like more of.","responseTitle":"Response time","response":"This is a small operation, so replies can take a few days. Correction reports get priority.","aboutPrefix":"More about the site and who makes it:","aboutLink":"about us"},"puzzleDetail":{"agesLabel":"Ages:","dotsLabel":"Dots:","freeLabel":"100% Free","difficultyHeading":"Difficulty","difficultyEasy":"Easy","difficultyMedium":"Medium","difficultyHard":"Hard","funFactPrefix":"Fun fact:","funFactLabel":"Fun fact!","noSignUp":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use.","comingSoon":"Download Free PDF – Coming Soon","youMightLike":"You might also like","faqQ1":"What age is the {name} dot to dot puzzle for?","faqA1":"It is designed for ages {age}. With {dots} dots, it suits children who can confidently count to {dots}; younger children can complete it with a little help.","faqQ2":"How do I print the {name} worksheet?","faqA2":"Click the download button to get the free PDF, then print it on regular paper (A4 or US Letter) from any browser or PDF reader. No special software is needed.","faqQ3":"Is the {name} printable really free?","faqA3":"Yes — it is 100% free, with no sign-up, account, or payment required. You may print it for home or classroom use."},"blogPage":{"eyebrow":"Learning resources","h1":"Dot to Dot Ideas for Parents and Teachers","description":"Practical guides for choosing activities, building early learning skills, and using printable worksheets at home or in the classroom.","breadcrumb":"Blog","latestEyebrow":"Latest articles","latestH2":"Helpful ideas you can use today","readArticle":"Read article","by":"By","backToAll":"← Back to all articles","savePinterest":"Save to Pinterest","relatedEyebrow":"Free printables","relatedHeading":"Try these dot to dot collections next"},"downloadButton":{"label":"Download Free Printable PDF","usage":"Free for home and classroom use.","paperNote":"Sized for {size} paper.","paperLetter":"US Letter","paperA4":"A4","alternateLink":"Prefer {size}? Download that version","downloadSize":"Download (Print Size: {size})"},"downloadBadge":{"downloaded":"Downloaded","times":"times","greatChoice":"You’ve made a great choice!"},"bookmarkButton":{"regionLabel":"Bookmark this page","shortcut":"Press <shortcut></shortcut> to bookmark!","dismiss":"Dismiss","shared":"Shared!","buttonAria":"Save or share this puzzle page","buttonTitle":"Save this puzzle","saved":"Saved!","save":"Save"},"languageSwitcher":{"label":"Language","selectLabel":"Select language"},"shareButtons":{"label":"Share","copyLink":"Copy link","copied":"Link copied!","shareMe":"Share me"},"bookmark":{"save":"Bookmark this page","saved":"Saved to bookmarks","labelText":"Bookmark this","hint":"Press Ctrl+D (or ⌘+D on Mac) to bookmark this page"},"purchase":{"premium":{"metaTitle":"Best of 2026 Premium Dot to Dot Puzzle Pack","metaDescription":"A print-ready collection of favorite dot to dot puzzles for kids, bundled into one convenient PDF.","eyebrow":"Premium printable collection","heading":"More puzzles. Less searching. Everything in one convenient PDF.","lede":"The Best of 2026 collection brings our favorite connect-the-dots activities together in one easy-to-print pack for quiet time, rainy days, homeschool, and classrooms.","digitalPdf":"Digital PDF","printAtHome":"Print at home","instantAccess":"Instant access","purchaseAria":"Purchase the Best of 2026 puzzle pack","coverAlt":"Best of 2026 - 25 Dot to Dot Puzzles book cover","oneTime":"one time","buyButton":"Get the puzzle pack","localNote":"On localhost, this opens a safe checkout demo and never charges a card.","detailsEyebrow":"Made for easy print-and-play","detailsHeading":"Everything you need for screen-free fun","detailsText":"Download once, keep it handy, and print the activities you want whenever you need them.","benefits":{"onePdf":"One convenient, print-ready PDF","kidFriendly":"Kid-friendly puzzles with varied difficulty","paperSizes":"Works on US Letter and A4 paper","instantAccess":"Instant access after successful payment","classroomUse":"Use at home or in one classroom"},"guaranteeHeading":"Simple, secure, and ready in minutes","guaranteeText":"After checkout, your private download link appears immediately. No subscription and no surprise renewal."},"checkout":{"consent":"I agree to immediate delivery of this digital PDF and understand that, once access begins, the sale is final and non-