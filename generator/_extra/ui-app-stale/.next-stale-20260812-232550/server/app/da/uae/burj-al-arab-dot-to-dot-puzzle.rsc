,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Burj Al Arab står på en kunstig ø og er et af de højeste hoteller i verden!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],["$","p",null,{"className":"asset-note","children":"Printable PDF path is not present in the export JSON."}],"$L10",["$","$L11",null,{"title":"Burj Al Arab Punkt-til-punkt udskrift - Gratis PDF","imageUrl":"","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/da/uae/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}]," Back to all ","Uae"," puzzles"]}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Burj Al Arab"," Dot-to-Dot Puzzle Guide"]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Burj Al Arab er en af ​​de mest genkendelige bygninger på Jorden – et skinnende, sejlformet tårn, der rejser sig fra sin egen menneskeskabte ø i Den Arabiske Golf. Bygget til at ligne det flagrende sejl på en traditionel dhow-båd, er det blevet et symbol på det moderne Dubai og De Forenede Arabiske Emirater. Dette puslespil med 66 prikker tegner dets dramatiske, buede silhuet. Find prik 1, og lad os bygge denne berømte skyline sammen!"}}],[["$","div","1–13",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–13"," — ","Masten og spidsen"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Start ved punkt 1 og forbind til punkt 13 for at tegne den høje, buede mast helt øverst på bygningen. Denne smalle sektion opbygger stabil blyantkontrol lige fra starten – en god opvarmning før de bredere former nedenfor. Opfordr børnene til at holde deres linjer glatte og let buede, ligesom det rigtige sejl."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Burj Al Arab er omkring 321 meter høj, hvilket gør den til en af ​​de højeste hotelbygninger i verden. Dens karakteristiske mast på toppen har endda en helikopterlandingsplads, som har været vært for tenniskampe og golfdemonstrationer højt over havet! Læs mere på <a href=\"https://en.wikipedia.org/wiki/Burj_Al_Arab\" target=\"_blank\" rel=\"nofollow noopener noreferrer\">Wikipedias Burj Al Arab-artikel</a>."]}]]}]]}],["$","div","14–26",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["14–26"," — ","Det buede sejl"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Fortsæt fra punkt 14 til punkt 26 for at feje bygningens berømte buede facade ud – den del, der ligner et sejl fyldt med vind. Børn øver sig her i en lang, yndefuld udadgående kurve, en af ​​de mest tilfredsstillende former i hele puslespillet. En langsom, stabil hånd giver den bedste fejende linje."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Bygningen blev tegnet af arkitekten Tom Wright, der ønskede at skabe en struktur lige så ikonisk som Operahuset i Sydney eller Eiffeltårnet. Sejlformen var inspireret af de traditionelle arabiske dhow-sejlskibe, der har sejlet i Golfen i århundreder."]}]]}]]}],["$","div","27–39",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["27–39"," — ","Rygstøtterammen"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Tegn punkt 27 til 39 for at tegne den høje, lodrette støttestruktur, der afstivner bygningen bagfra. Dette afsnit introducerer lige linjer blandet med blide vinkler, hvilket giver børnene øvelse i at bevæge sig mellem buede og lige streger i det samme puslespil."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Burj Al Arab er faktisk ikke den højeste bygning i Dubai – den titel tilhører Burj Khalifa, som er over dobbelt så høj! Men Burj Al Arab er fortsat en af ​​de mest fotograferede bygninger i verden takket være sin unikke form."]}]]}]]}],["$","div","40–52",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["40–52"," — ","Hovedtårnets krop"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Forbind punkt 40 til 52 for at udfylde den brede hoveddel af hotellårnet. Dette er den største del af puslespillet, der hjælper børn med at opbygge fokus og tålmodighed, efterhånden som den genkendelige silhuet virkelig begynder at tage form."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Indenfor er Burj Al Arab berømt for sit enorme atrium – højt nok til at rumme et 177 meter højt åbent område, et af de højeste atrier i verden. Lobbyens springvand indenfor er koreograferet til at danse i takt med musikken."]}]]}]]}],["$","div","53–66",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["53–66"," — ","Øbasen"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Færdiggør puslespillet ved at forbinde prikkerne 53 til 66 for at tegne bygningens base og den kunstige ø, den står på. Kun fjorten prikker til målstregen – opmuntr børnene til at fuldføre omridset med et sikkert og jordnært sæt afsluttende linjer."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Hotellet ligger på sin egen private ø, forbundet med fastlandet via en buet bro. Ingeniørerne måtte først bygge øen med sand og sten, før byggeriet af selve tårnet overhovedet kunne begynde – hele projektet tog flere års omhyggelig planlægning."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["More free ","Uae"," printables"]}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","burj-khalifa-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/da/uae/burj-khalifa-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Rekordhøje Burj Khalifa-tårn bygget op gennem 60 printbare nummererede prikker","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","children":[["$","p",null,{"className":"puzzle-category","children":"Uae"}],["$","h3",null,{"children":"Burj Khalifa"}],["$","div",null,{"className":"puzzle-meta","children":[["$","span",null,{"children":""}],["$","span",null,{"children":"1–0 prikker"}]]}],["$","$Lf",null,{"href":"/da/uae/burj-khalifa-dot-to-dot-puzzle/","className":"download-link","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":15,"height":15,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true","children":[["$","path","r04s7s",{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.5