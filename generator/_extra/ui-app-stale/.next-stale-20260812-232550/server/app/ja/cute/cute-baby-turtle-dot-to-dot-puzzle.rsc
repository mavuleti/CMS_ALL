ラ シーグリーン"," — 頭と顔は、殻と同じ柔らかい緑灰色のトーンを共有しています。"]}],["$","li","緑のウミガメ-33–47-シェルパターン",{"children":[["$","strong",null,{"children":["33–47"," (シェルパターン)",":"]}]," ",["$","span",null,{"aria-hidden":"true","style":{"display":"inline-block","width":34,"height":14,"borderRadius":7,"background":"#5FA777","border":"1px solid rgba(0,0,0,0.18)","verticalAlign":"middle","marginRight":6}}],"クレヨラ フォレストグリーン"," — 暗い緑の模様がシェル全体に自然な質感を加えます。"]}],["$","li","緑のウミガメ-48–65-脚と尾",{"children":[["$","strong",null,{"children":["48–65"," (脚と尾)",":"]}]," ",["$","span",null,{"aria-hidden":"true","style":{"display":"inline-block","width":34,"height":14,"borderRadius":7,"background":"#93DFB8","border":"1px solid rgba(0,0,0,0.18)","verticalAlign":"middle","marginRight":6}}],"クレヨラ シーグリーン"," — ひれと尾は同じ柔らかい緑の色合いです。"]}]]}]]}],["$","article","ペイントタートル",{"style":{"marginBottom":28,"paddingLeft":16,"borderLeft":"3px solid var(--pink-light, #f6a5c0)"},"children":[["$","h3",null,{"style":{"fontSize":"1.05rem","fontWeight":800,"marginBottom":6},"children":"ペイントタートル"}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":10},"children":"ペイントタートルは、オリーブから黒の殻に明るい赤と黄色の模様が施された、実在するカラフルな種です。"}],["$","ul",null,{"style":{"lineHeight":1.8,"paddingLeft":20,"margin":0},"children":[["$","li","ペイントタートル-1–16-シェル",{"children":[["$","strong",null,{"children":["1–16"," (シェル)",":"]}]," ",["$","span",null,{"aria-hidden":"true","style":{"display":"inline-block","width":34,"height":14,"borderRadius":7,"background":"#AF593E","border":"1px solid rgba(0,0,0,0.18)","verticalAlign":"middle","marginRight":6}}],"クレヨラ ブラウン"," — ペイントタートルのシェルはオリーブブラウンのベースカラーを持っています。"]}],["$","li","ペイントタートル-17–32-頭と小さな顔",{"children":[["$","strong",null,{"children":["17–32"," (頭と小さな顔)",":"]}]," ",["$","span",null,{"aria-hidden":"true","style":{"display":"inline-block","width":34,"height":14,"borderRadius":7,"background":"#FC2847","border":"1px solid rgba(0,0,0,0.18)","verticalAlign":"middle","marginRight":6}}],"クレヨラ スカーレット"," — 本物のペイントタートル