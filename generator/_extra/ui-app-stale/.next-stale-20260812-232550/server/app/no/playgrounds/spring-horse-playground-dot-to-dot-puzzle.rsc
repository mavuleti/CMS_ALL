2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://dottodotfreeprintables.com/no/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Playgrounds\",\"item\":\"https://dottodotfreeprintables.com/no/playgrounds/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Huskeplass\",\"item\":\"https://dottodotfreeprintables.com/no/playgrounds/spring-horse-playground-dot-to-dot-puzzle/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"Huskeplass\",\"description\":\"Et barns skiftende vekt får en vårhest til å gynge. Bygg denne lekehesten over 53 punkter med en gratis utskrivbar PDF for alderen 4–8.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"Brødsmulesti","children":[["$","$Lf",null,{"href":"/no/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Hjem"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/no/playgrounds/","children":"Playgrounds"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"Huskeplass"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Lekehest vårhest rytter som hopper i form fra 53 utskrivbare punkter","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":["Free ","Playgrounds"," Printable"]}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Huskeplass Dot-to-Dot Printable"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Koble sammen 42 enkle prikker for å avdekke en munter lekeplassscene komplett med husker! Dette utskrivbare puslespillet er perfekt for førskole- og barnehagebarn som øver på tallsekvensering mens de feirer gleden ved utendørslek."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Vanskelighetsgrad 1 av 3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Husker er en av de eldste oppfinnelsene på lekeplasser – barn har svingt på tauhusker i tusenvis av år!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],["$","p",null,{"className":"asset-note","children":"Printable PDF path is not present in the export JSON."}],"$L10",["$","$L11",null,{"title":"Huskeplass Prikk-til-prikk Utskrivbar - Gratis PDF","imageUrl":"","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/no/playgrounds/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}]," Back to all ","Playgrounds"," puzzles"]}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Huskeplass"," Dot-to-Dot Puzzle Guide"]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Lekeplasser er steder hvor fantasien løper løpsk og vennskap knyttes – og husken er den ubestridte kongen av lekeplassen. Få ting kan måle seg med den enkle gleden av å pumpe beina og føle vinden suse forbi mens du buer deg høyere og høyere opp i himmelen. Dette muntre puslespillet med 42 prikker fanger den magien. Finn prikk 1, plukk opp blyanten din, og la oss leke!"}}],[["$","div","1–13",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–13"," — ","Svingrammen"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Start ved punkt 1 og fortsett til punkt 8 for å tegne den høye A-rammen som holder huskene på plass. Barn øver på rette, trygge linjer som vinkler innover mot et punkt – en flott introduksjon til geometriske former i en morsom, virkelighetsnær kontekst. Oppmuntre til et bestemt, bevisst strøk for best resultat."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Det klassiske A-ramme-huskesettet ble designet for å være så stabilt som mulig – den trekantede formen fordeler vekten jevnt, slik at hele konstruksjonen ikke velter selv når barn svinger hardt. Trekanter er den sterkeste formen innen ingeniørfag, og det er derfor du ser dem overalt, fra broer til lekeplassrammer."]}]]}]]}],["$","div","14–27",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["14–27"," — ","Tverrstangen og kjettingene"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Fortsett fra punkt 9 til punkt 18 for å tegne den horisontale tverrstangen øverst og de hengende kjettingene. Barna øver på å veksle mellom horisontale linjer og nedovervinklede kjettinger – en fin øvelse i å endre retning bevisst og nøyaktig. Det er kjettingene som gjør svingbevegelsen mulig!"}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Moderne lekeplasskjeder er laget av galvanisert stål – stål belagt med et lag sink – for å forhindre rust. Før stålkjeder brukte husker tykke tau laget av naturfibre som hamp eller manila. Mange barns første erfaring med en huske var en enkel planke bundet til en tregren med tau, og den tradisjonen fortsetter i hager rundt om i verden i dag."]}]]}]]}],["$","div","28–40",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["28–40"," — ","Huskesetet og figuren"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Tegn punkt 19 til 28 for å tegne huskesetet og omrissetet av barnet som sitter på det. Dette er den mest givende delen av puslespillet – barna ser hele hensikten med strukturen komme sammen når en liten figur tar plassen deres. Minn barna på å se fremover til neste prikk før de løfter blyanten."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Følelsen av å svinge – det å heve og falle, det korte øyeblikket av vektløshet øverst i hver bue – aktiverer det vestibulære systemet i hjernen, som er ansvarlig for balanse og romlig bevissthet. Det er derfor det føles så bra å svinge: det er genuint gunstig sanseinntrykk som hjelper barn med å utvikle balanse, koordinasjon og kroppsbevissthet."]}]]}]]}],["$","div","41–53",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["41–53"," — ","Bakken og omgivelsene"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Koble sammen punkt 29 til 36 for å tegne bakken under huskene og detaljene rundt. Barna øver på å forankre scenen – og gir lekeplassen en følelse av sted og skala. Denne delen bygger en forståelse av forgrunn og bakgrunn som vil være nyttig for dem i kunst og tegning i årene som kommer."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Moderne lekeplasser bruker spesialdesignede sikkerhetsunderlag under husker – gummifliser, treflis eller gummismuler – for å dempe fall. Dette materialet er nøye konstruert for å absorbere støt. Før sikkerhetsunderlag ble standard på 1970- og 1980-tallet, hadde de fleste lekeplasser hard betong eller pakket jord under utstyret."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["More free ","Playgrounds"," printables"]}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","playhouse-slide-playground-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/no/playgrounds/pl