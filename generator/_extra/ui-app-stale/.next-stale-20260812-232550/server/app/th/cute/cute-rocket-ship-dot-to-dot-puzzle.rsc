e:["$","$L12",null,{"formats":"$undefined","locale":"th","messages":{"nav":{"scanMe":"สแกนฉันสิ","blog":"บล็อก","search":"ค้นหา","kids":"เด็กๆ - ปริศนา","teachers":"ครู","parents":"ผู้ปกครอง","contact":"ติดต่อเรา","freePack":"แพ็คฟรี"},"homepageUi":{"title":"ค้นหาแบบฝึกจุดต่อจุดที่พิมพ์ได้สมบูรณ์แบบ","description":"พิมพ์ เชื่อมจุด แล้วทำให้ภาพสวยงามมีชีวิตขึ้นมา ฟรีและพร้อมสนุกได้เลย!","searchPlaceholder":"ลองค้นหา มหาสมุทร ไดโนเสาร์ หรือดอกไม้","filterPuzzles":"กรองปริศนา","age":"อายุ","dots":"จุด","featuredPuzzles":"ปริศนาแนะนำที่พิมพ์ได้","savePuzzle":"บันทึก {name}","removeSavedPuzzle":"นำ {name} ออกจากรายการที่บันทึกไว้","downloads":"ดาวน์โหลด","bookTitle":"สุดยอดแห่งปี 2026 · {count}","bookDescription":"ปริศนาจุดต่อจุดสุดโปรดของเรารวมอยู่ในหนังสือ PDF พิมพ์ได้เล่มเดียว","searchUnavailable":"ระบบค้นหาไม่พร้อมใช้งานชั่วคราว โปรดลองอีกครั้ง","popularEyebrow":"ยอดนิยมในสัปดาห์นี้","mostDownloaded":"ปริศนาที่ดาวน์โหลดมากที่สุด","downloadCountAria":"{count} ดาวน์โหลดขึ้นไป","freshPrintables":"สิ่งพิมพ์ใหม่","recentlyAdded":"เพิ่มเข้ามาเมื่อเร็วๆ นี้","browseCategories":"เรียกดูหมวดหมู่ปริศนา","openCategories":"เปิดเมนูหมวดหมู่","closeCategories":"ปิดเมนูหมวดหมู่","browseByTheme":"เรียกดูตามธีม","quickLinks":"ลิงก์ด่วน","bundlePacks":"ชุดแพ็ค","parentsTeachers":"สำหรับผู้ปกครองและครู","more":"หมวดหมู่อื่นๆ","kids":"เด็ก","categoryNames":{"cute":"ปริศนาน่ารัก","flowers":"ดอกไม้"}},"audience":{"kidsTitle":"สำหรับเด็กๆ","kidsText":"เกมนี้มีธีมสัตว์น่ารัก ไดโนเสาร์ และยานพาหนะ พร้อมจุดหมายเลขที่ชัดเจน ช่วยให้ชนะได้ง่ายและสร้างความมั่นใจได้อย่างแท้จริง","parentsTitle":"สำหรับผู้ปกครอง","parentsText":"กิจกรรมผ่อนคลายที่ไม่ต้องใช้หน้าจอ สำหรับบ้าน การเดินทาง และร้านอาหาร พิมพ์จากอุปกรณ์ใดก็ได้ภายในเวลาไม่ถึงนาที","teachersTitle":"สำหรับครู","teachersText":"เกมต่อจุดที่ทำได้ง่าย ไม่ต้องเตรียมอะไรมาก เหมาะสำหรับกิจกรรมตอนเช้า นักเรียนที่ทำเสร็จเร็ว ครูผู้สอนแทน และสถานีการเรียนรู้ในห้องเรียน — ไม่ต้องเตรียมอะไรล่วงหน้า"},"categories":{"eyebrow":"จัดเรียงตามหัวข้อและระดับความยาก","heading":"เลือกดูเกมต่อจุดตามหมวดหมู่","description":"ตั้งแต่รูปทรงง่ายๆ 10 จุดสำหรับเด็กเล็ก ไปจนถึงความท้าทาย 200 จุดสำหรับเด็กโต — จัดเรียงตามหมวดหมู่เพื่อให้คุณค้นหาแบบฝึกหัดฟรีที่เหมาะสมได้อย่างรวดเร็ว","puzzles":"{count, plural, one {# ปริศนา} other {# ปริศนา}}","comingSoon":"เร็วๆ นี้","badges":{"dinosaurs":"พร้อมจำหน่ายแล้ว!","ocean":"พร้อมจำหน่ายแล้ว!","playgrounds":"พร้อมจำหน่ายแล้ว!","garden":"พร้อมจำหน่ายแล้ว!","usa250":"ใหม่!","uae":"พร้อมจำหน่ายแล้ว!","cute":"ใหม่!","circus":"ใหม่!"},"items":{"dinosaurs":{"name":"ไดโนเสาร์","description":"สนุกสุดเหวี่ยงไปกับเกมยุคก่อนประวัติศาสตร์! เกมต่อจุดฟรีๆ ที่เด็กๆ จะต้องหลงรัก ไม่ว่าจะเป็น ทีเร็กซ์ ไทรเซราทอปส์ เวโลซิแรปเตอร์ และ {count}"},"animals":{"name":"สัตว์","description":"สัตว์น่ารัก ๆ สำหรับฝึกนับเลขเบื้องต้น"},"vehicles":{"name":"ยานพาหนะ","description":"รถยนต์ รถบรรทุก จรวด และเครื่องจักร"},"fantasy":{"name":"แฟนตาซี","description":"ปราสาท ยูนิคอร์น มังกร และหัวข้อเรื่องราว"},"seasonal":{"name":"ตามฤดูกาล","description":"กิจกรรมในปฏิทินวันหยุดและปฏิทินห้องเรียน"},"ocean":{"name":"มหาสมุทร","description":"ภาพระบายสีสัตว์ทะเลและภาพระบายสีที่ให้ความรู้สึกสงบ"},"playgrounds":{"name":"สนามเด็กเล่น","description":"ชิงช้า สไลด์ และกิจกรรมกลางแจ้งสนุกๆ สำหรับนักผจญภัยตัวน้อย"},"garden":{"name":"สวน","description":"ถุงมือ เกรียง และอุปกรณ์สำหรับผู้ช่วยตัวน้อยในสวน"},"usa250":{"name":"อเมริกา 250 ปี","description":"ร่วมฉลองวันครบรอบ 250 ปีของอเมริกาด้วยเกมต่อจุดแสดงความรักชาติที่ยกย่องประวัติศาสตร์อเมริกัน"},"uae":{"name":"สหรัฐอาหรับเอมิเรตส์","description":"สำรวจสหรัฐอาหรับเอมิเรตส์! สถานที่สำคัญอันโดดเด่นอย่างโรงแรมเบิร์จ อัล อาหรับ พร้อมให้คุณเชื่อมต่อและเติมสีสัน"},"space":{"name":"ช่องว่าง","description":"ดาวเคราะห์ นักบินอวกาศ และการผจญภัยด้วยจรวด"},"worksheets":{"name":"แบบฝึกหัด","description":"แบบฝึกหัดเรียงลำดับตัวเลขพร้อมใช้งานสำหรับครู"},"bigDotBooks":{"name":"หนังสือบิ๊กดอท","description":"ปริศนาแบบยาวสำหรับผู้เรียนที่มีอายุมากกว่าและมีสมาธิจดจ่อ"},"cute":{"name":"น่ารัก","description":"ลูกสุนัขน่ารัก รถยนต์คันเล็ก และเกมลากเส้นต่อจุดสุดน่ารัก {count} เกม ที่เด็กๆ จะต้องหลงรัก"},"circus":{"name":"ละครสัตว์","description":"ผู้ควบคุมวง, เต็นท์ใหญ่, และความสนุกในเวลาแสดงสำหรับผู้เรียนวัยเยาว์."}}},"puzzleSection":{"eyebrow":"ตัวอย่างสินค้าที่สามารถพิมพ์ได้ฟรี — ไม่ต้องลงทะเบียน","heading":"แบบฝึกต่อจุดยอดนิยมที่สามารถพิมพ์ได้ในขณะนี้","weeklyPack":"ดูชุดสินค้าประจำสัปดาห์ →","downloadLink":"ดาวน์โหลดไฟล์สำหรับพิมพ์ฟรี","new":"ใหม่","imageAlt":"แบบฝึกหัดลากเส้นต่อจุดฟรีสำหรับ {name} และ {age}","categories":{"Dinosaurs":"ไดโนเสาร์","Ocean":"มหาสมุทร","Playgrounds":"สนามเด็กเล่น","Garden":"สวน","Cute":"น่ารัก","USA 250 Years":"อเมริกา 250 ปี","UAE":"สหรัฐอาหรับเอมิเรตส์"},"items":{"trex-61-dot-to-dot-puzzle":{"name":"ความท้าทาย 61 จุด ทีเร็กซ์"},"brontosaurus-dot-to-dot-puzzle":{"name":"บรอนโตซอรัส"},"mermaid-dot-to-dot-puzzle":{"name":"เงือก"},"merman-dot-to-dot-puzzle":{"name":"เงือก"},"seahorse-dot-to-dot-puzzle":{"name":"ม้าน้ำ"},"whale-dot-to-dot-puzzle":{"name":"วาฬ"},"swing-playgrounds-dot-to-dot-puzzle":{"name":"สนามเด็กเล่นชิงช้า"},"slide-playgrounds-dot-to-dot-puzzle":{"name":"สนามเด็กเล่นสไลเดอร์"},"seesaw-playground-dot-to-dot-puzzle":{"name":"สนามเด็กเล่นกระดานหก"},"roller-coaster-playground-dot-to-dot-puzzle":{"name":"สนามเด็กเล่นรถไฟเหาะ"},"wheelbarrow-playground-dot-to-dot-puzzle":{"name":"สนามเด็กเล่นรถเข็น"},"garden-gloves-dot-to-dot-puzzle":{"name":"ถุงมือทำสวน"},"garden-trowel-dot-to-dot-puzzle":{"name":"พลั่วทำสวน"},"gas-balloon-usa-250-dot-to-dot-puzzle":{"name":"บอลลูนแก๊ส อเมริกา 250"},"america-250-birthday-fireworks-dot-to-dot-puzzle":{"name":"พลุเฉลิมฉลองวันเกิดครบรอบ 250 ปีของอเมริกา"},"america-250-anniversary-liberty-bell-wings-1776-dot-to-dot-puzzle":{"name":"ปีกระฆังเสรีภาพอเมริกา 250 ชิ้น"},"usa-250-astronaut-dot-to-dot-puzzle":{"name":"นักบินอวกาศอเมริกา 250"},"usa-250-anniversary-sports-kids-podium-dot-to-dot-puzzle":{"name":"แท่นรับรางวัลกีฬาสำหรับเด็ก เนื่องในโอกาสครบรอบ 250 ปีของอเมริกา"},"usa-250-anniversary-airplane-banner-dot-to-dot-puzzle":{"name":"ป้ายแบนเนอร์เครื่องบินฉลองครบรอบ 250 ปีอเมริกา"},"usa-250-space-shuttle-dot-to-dot-puzzle":{"name":"ยานอวกาศอเมริกา 250"},"usa-250-birthday-balloons-stars-dot-to-dot-puzzle":{"name":"ลูกโป่งและดาวฉลองวันเกิดครบรอบ 250 ปีของอเมริกา"},"usa-250-birthday-cake-dot-to-dot-puzzle":{"name":"เค้กวันเกิดครบรอบ 250 ปีของอเมริกา"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"ธงนกอินทรีอเมริกา 250"},"burj-al-arab-dot-to-dot-puzzle":{"name":"บูร์จ อัล อาหรับ"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"กาต้มกาแฟดัลลาห์"}}},"benefits":{"eyebrow":"ได้รับการสนับสนุนจากนักการศึกษาปฐมวัย","heading":"เหตุใดแบบฝึกหัดลากเส้นต่อจุดจึงดีเยี่ยมสำหรับการพัฒนาเด็ก","description":"แบบฝึกหัดต่อจุดไม่ใช่แค่สนุกเท่านั้น แต่ยังเป็นเครื่องมือที่ได้รับการสนับสนุนจากงานวิจัย ซึ่งครูในระดับก่อนวัยเรียนและอนุบาลใช้ในการสร้างทักษะการเรียนรู้ขั้นพื้นฐาน","fineMotorTitle":"ช่วยพัฒนาทักษะการเคลื่อนไหวของกล้ามเนื้อมือ","fineMotorText":"การวาดเส้นเชื่อมจุดช่วยพัฒนาทักษะการจับดินสอ การประสานงานระหว่างมือและตา และการควบคุมกล้ามเนื้อที่เด็กๆ จำเป็นต้องใช้ในการเขียนหนังสือ","numberTitle":"เสริมสร้างการจดจำตัวเลข","numberText":"การนับตามลำดับ 1 → 2 → 3 ช่วยสอนลำดับการนับ การจดจำตัวเลข และแนวคิดทางคณิตศาสตร์เบื้องต้นได้อย่างเป็นธรรมชาติผ่านการเล่น","focusTitle":"ช่วยเพิ่มสมาธิและจดจ่อ","focusText":"การต่อจุดให้สมบูรณ์นั้นต้องใช้สมาธิอย่างต่อเนื่อง ซึ่งเป็นวิธีฝึกสมาธิที่สงบและไม่ต้องใช้หน้าจอ เหมาะสำหรับเด็กก่อนวัยเรียนจนถึงชั้นประถมศึกษาปีที่ 3","confidenceTitle":"ผลตอบแทนและความมั่นใจทันที","confidenceText":"เมื่อภาพที่ซ่อนอยู่ปรากฏขึ้น เด็กๆ จะรู้สึกถึงความสำเร็จในทันที ชัยชนะเล็กๆ นี้ช่วยสร้างความรักในการเรียนรู้และพัฒนาความคิดแบบเติบโต (growth mindset)"},"howTo":{"eyebrow":"พร้อมภายในเวลาไม่ถึง 60 วินาที","heading":"วิธีดาวน์โหลดและพิมพ์แบบฝึกหัดลากเส้นต่อจุดฟรี","step1Title":"เลือกปริศนาของคุณ","step1Text":"เลือกธีม (สัตว์ ไดโนเสาร์ ยานพาหนะ วันหยุด) และจำนวนจุดที่เหมาะสมกับอายุและระดับความสามารถของเด็ก","step2Title":"ดาวน์โหลดไฟล์ PDF ฟรี","step2Text":"คลิก \"ดาวน์โหลดไฟล์สำหรับพิมพ์ฟรี\" — ไม่ต้องสมัครบัญชี ไม่ต้องใช้อีเมล ไม่ต้องเสียค่าใช้จ่ายใดๆ เบราว์เซอร์ของคุณจะดาวน์โหลดไฟล์ PDF ทันที","step3Title":"พิมพ์และเพลิดเพลินได้เลย","step3Text":"พิมพ์ลงบนกระดาษขนาดมาตรฐาน US Letter (8.5\" × 11\") พิมพ์ขาวดำได้สวยงาม ยื่นให้ลูกของคุณแล้วดูพวกเขาต่อจุดต่างๆ เข้าด้วยกัน!"},"trust":{"eyebrow":"เหตุผลที่ผู้ปกครองและครูเลือกเรา","heading":"ฟรี ปลอดภัย และใช้งานง่ายอย่างเหลือเชื่อ","noAccountTitle":"ไม่จำเป็นต้องมีบัญชีผู้ใช้","noAccountText":"ภาพลากเส้นต่อจุดทุกภาพสามารถดาวน์โหลดได้ทันที — ไม่ต้องลงทะเบียน ไม่ต้องใช้อีเมล ไม่ต้องเสียค่าใช้จ่าย เพียงแค่คลิกแล้วพิมพ์ได้เลย","safeTitle":"ความปลอดภัยในห้องเรียน","safeText":"หน้าปริศนาที่สะอาดตา ปราศจากโฆษณา ออกแบบมาสำหรับเครื่องพิมพ์ในโรงเรียน เหมาะสำหรับกิจกรรมยามเช้า การบ้าน หรือช่วงเวลาพักผ่อนเงียบๆ","fastTitle":"ออกแบบมาเพื่อความรวดเร็ว","fastText":"หน้าเว็บแบบคงที่ รูปภาพที่ปรับแต่งแล้ว และฟอนต์เฉพาะพื้นที่ ทำให้เกมปริศนาโหลดได้อย่างรวดเร็วบนทุกอุปกรณ์ ไม่ว่าจะเป็นโทรศัพท์ แท็บเล็ต หรือแล็ปท็อป"},"faq":{"eyebrow":"คำถามที่พบบ่อย","heading":"คำถามที่พบบ่อย","q1":"แบบลากเส้นต่อจุดทั้งหมดในเว็บไซต์นี้ฟรีทั้งหมดหรือไม่?","a1":"ใช่แล้ว — แบบฝึกหัดลากเส้นต่อจุดทุกแผ่นบนเว็บไซต์ DotToDotFreePrintables.com สามารถดาวน์โหลดและพิมพ์ได้ฟรี 100% ไม่จำเป็นต้องสร้างบัญชี สมัครสมาชิก หรือใช้บัตรเครดิตแต่อย่างใด","q2":"แบบฝึกหัดลากเส้นจุดเหมาะสำหรับเด็กอายุเท่าไหร่?","a2":"แบบฝึกหัดของเราเหมาะสำหรับเด็กอายุ 2-12 ปี แบบฝึกหัดง่าย (10-20 จุด) เหมาะสำหรับเด็กวัยหัดเดินและเด็กก่อนวัยเรียน แบบฝึกหัดระดับกลาง (20-50 จุด) เหมาะสำหรับเด็กอนุบาลและชั้นประถมศึกษาปีที่ 1 และแบบฝึกหัดระดับยาก (50-200 จุดขึ้นไป) เหมาะสำหรับเด็กชั้นประถมศึกษาปีที่ 2 ถึง 6","q3":"ไฟล์เกมต่อจุดมีรูปแบบอย่างไร?","a3":"เอกสารประกอบการเรียนทั้งหมดจะดาวน์โหลดเป็นไฟล์ PDF ที่พร้อมพิมพ์ ขนาดมาตรฐานสำหรับกระดาษขนาด US Letter (8.5\" × 11\") เปิดในเบราว์เซอร์หรือโปรแกรมดูไฟล์ PDF ใดก็ได้แล้วพิมพ์ได้เลย ไม่จำเป็นต้องใช้ซอฟต์แวร์พิเศษใดๆ","q4":"คุณมีแบบฝึกหัดลากเส้นต่อจุดสำหรับเด็กก่อนวัยเรียนและเด็กอนุบาลหรือไม่?","a4":"แน่นอนค่ะ แบบฝึกหัดที่ง่ายที่สุดของเราเริ่มต้นที่ 1-10 จุด (เหมาะสำหรับเด็กอายุ 2-4 ปี) และรวมถึงแบบฝึกหัดเกี่ยวกับการเรียนรู้ตัวอักษรและตัวเลขที่ออกแบบมาสำหรับห้องเรียนก่อนวัยเรียนและอนุบาลค่ะ","q5":"ครูสามารถใช้แบบฝึกหัดลากเส้นต่อจุดเหล่านี้ในชั้นเรียนได้หรือไม่?","a5":"ใช่แล้ว! สื่อการสอนของเรานั้นฟรีสำหรับการใช้งานส่วนตัวและในห้องเรียน เป็นที่นิยมสำหรับการทำกิจกรรมช่วงเช้า กิจกรรมสำหรับนักเรียนที่ทำเสร็จก่อนเวลา แผนการสอนสำหรับครูผู้สอนแทน ศูนย์พัฒนาทักษะกล้ามเนื้อมือ และชุดการบ้าน","q6":"เกมลากเส้นต่อจุดช่วยพัฒนาทักษะการเคลื่อนไหวของกล้ามเนื้อมือหรือไม่?","a6":"ใช่แล้ว การลากเส้นเชื่อมจุดช่วยเสริมสร้างความแข็งแรงของกล้ามเนื้อในการจับดินสอและการประสานงานระหว่างมือและตา ซึ่งเป็นสิ่งสำคัญในการเตรียมความพร้อมสำหรับการเขียน นักกิจกรรมบำบัดและครูอนุบาลหลายคนจึงแนะนำกิจกรรมเชื่อมจุดด้วยเหตุผลนี้","q7":"คุณมีแบบฝึกหัดลากเส้นต่อจุดตามธีมต่างๆ เช่น สัตว์ หรือไดโนเสาร์ไหม?","a7":"เรามี 11 หมวดหมู่ ได้แก่ สัตว์ ไดโนเสาร์ ยานพาหนะ สัตว์ทะเล สนามเด็กเล่น อเมริกาครบรอบ 250 ปี อวกาศ แฟนตาซี ธีมตามฤดูกาล/วันหยุด ชุดแบบฝึกหัดสำหรับครู และหนังสือจุดใหญ่ มีการเพิ่มดีไซน์ใหม่ๆ ทุกสัปดาห์","q8":"ฉันสามารถพิมพ์ปริศนาเหล่านี้เป็นขาวดำได้หรือไม่?","a8":"ใช่ค่ะ แบบฝึกหัดลากเส้นต่อจุดทั้งหมดของเราออกแบบมาสำหรับการพิมพ์ขาวดำเพื่อประหยัดหมึก พิมพ์ออกมาได้สวยงามบนเครื่องพิมพ์ที่บ้านหรือในห้องเรียนทุกเครื่องค่ะ"},"newsletter":{"eyebrow":"ชุดเริ่มต้นสำหรับพิมพ์ — ฟรีทั้งหมด","heading":"รับแบบฝึกหัดลากเส้นจุด 20 แบบฟรี ส่งตรงถึงอีเมลของคุณ","description":"ชุดภาพประกอบที่เหมาะสำหรับผู้ปกครองและครู ครอบคลุมทั้งสัตว์ ยานพาหนะ ไดโนเสาร์ และธีมตามฤดูกาล โดยทุกภาพมีขนาดพอดีกับกระดาษขนาดมาตรฐาน US Letter และปรับให้เหมาะสมสำหรับการพิมพ์ขาวดำ"},"blog":{"eyebrow":"ไอเดียสำหรับผู้ใหญ่","heading":"เคล็ดลับการเรียนรู้สำหรับบ้านและห้องเรียน","viewAll":"ดูบทความทั้งหมด","read":"อ่าน"},"feedback":{"eyebrow":"เรายินดีรับฟังความคิดเห็นจากคุณ","heading":"ส่งข้อเสนอแนะ","description":"มีไอเดียเกี่ยวกับปริศนา พบลิงก์เสีย หรือแค่อยากทักทาย? เขียนข้อความถึงเราได้ด้านล่างเลย"},"footer":{"description":"แบบฝึกหัดลากเส้นจุดและต่