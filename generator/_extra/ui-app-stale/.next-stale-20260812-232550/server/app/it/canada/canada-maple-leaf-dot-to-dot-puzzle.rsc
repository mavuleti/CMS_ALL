en":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","La foglia d'acero è apparsa al centro della bandiera nazionale del Canada dal 1965."]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],["$","p",null,{"className":"asset-note","children":"Printable PDF path is not present in the export JSON."}],"$L10",["$","$L11",null,{"title":"Foglia d'acero Collega i Punti Stampabile - PDF Gratuito","imageUrl":"","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/it/canada/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}]," Back to all ","Canada"," puzzles"]}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Foglia d'acero"," Dot-to-Dot Puzzle Guide"]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Gli alberi d'acero illuminano le foreste canadesi con foglie rosse, arancioni e dorate ogni autunno. La foglia d'acero ha rappresentato il Canada per generazioni e si trova orgogliosamente al centro della bandiera rossa e bianca del paese. Questo puzzle di 70 punti segue i bordi appuntiti della foglia e il suo robusto gambo. Trova il punto 1, continua a muovere la matita in ordine numerico e guarda un simbolo canadese prendere forma!"}}],[["$","div","1–14",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–14"," — ","Il Punto Superiore"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Inizia dal punto 1 e collega fino al punto 14 per formare il punto alto in cima alla foglia. Segui ogni piccola curva con attenzione: gli angoli acuti danno alla foglia d'acero la sua forma riconoscibile."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"La bandiera del Canada presenta una foglia d'acero rossa stilizzata con 11 punte. Scopri il design e la storia della bandiera da <a href=\"https://www.canada.ca/en/canadian-heritage/services/flag-canada-history.html\" target=\"_blank\" rel=\"nofollow noopener noreferrer\">Canadian Heritage</a>."]}]]}]]}],["$","div","15–28",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["15–28"," — ","I Punti della Mano Destra"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Continua dal punto 15 al punto 28, muovendoti lungo il lato destro della foglia. Rallenta ad ogni angolo e controlla il numero successivo prima di cambiare direzione."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Il Canada ha 10 specie di acero native. L'acero da zucchero è particolarmente famoso perché la sua linfa può essere trasformata in sciroppo d'acero."]}]]}]]}],["$","div","29–42",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["29–42"," — ","Il Gambo"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Collega i punti 29 al 42 per disegnare il bordo inferiore e il gambo stretto. Usa tratti più corti attorno alle curve strette in modo che la tua linea rimanga vicina ai punti."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Le persone raccolgono la linfa d'acero all'inizio della primavera, quando le notti fredde e le giornate più calde aiutano la linfa a fluire all'interno dell'albero."]}]]}]]}],["$","div","43–56",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["43–56"," — ","I Punti della Mano Sinistra"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Traccia i punti 43-56 risalendo il lato sinistro. Questi punti rispecchiano le forme a destra, quindi confronta entrambi i lati mentre disegni."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Molto prima che la moderna bandiera canadese fosse adottata, le foglie d'acero apparivano su distintivi canadesi, stemmi, monete ed emblemi militari."]}]]}]]}],["$","div","57–70",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["57–70"," — ","Chiusura della Foglia"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Finisci con i punti da 57 a 70, tornando alla cima della foglia. Conta lentamente fino all'ultimo punto, poi controlla che ogni punto e angolo sia connesso."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Le foglie d'acero producono cibo per l'albero utilizzando la luce solare. In autunno, il loro pigmento verde si degrada e altri colori diventano più facili da vedere."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["More free ","Canada"," printables"]}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","canada-canoe-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"hr