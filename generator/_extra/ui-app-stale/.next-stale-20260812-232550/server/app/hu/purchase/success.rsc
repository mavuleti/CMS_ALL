lectTopic":"Válasszon egy témát...","types":{"general":"Általános visszajelzés","requestTheme":"Kirakós téma kérése","brokenLink":"Hibás link jelentése","improvement":"Javasoljon egy fejlesztést","other":"Más"},"messageLabel":"Az üzeneted","messagePlaceholder":"Mondd el a véleményed...","emailLabel":"Email","emailOptional":"(opcionális - csak akkor, ha választ szeretne kapni)","submit":"Visszajelzés küldése","success":"Köszönjük. Visszajelzését elküldtük.","disclaimer":"Kérjük, ne adjon meg érzékeny személyes adatokat. Az e-mail cím megadása opcionális, és csak akkor használjuk, ha válaszolnunk kell.","iframeTitle":"Visszajelzés beküldése"},"contactPage":{"title":"Contact Us","intro":"The fastest way to reach us is email:","topicsTitle":"What we're happy to hear about","requestsTitle":"Puzzle requests.","requests":"Tell us a theme your child or class loves and the rough age range — requests genuinely shape what we publish next.","correctionsTitle":"Corrections.","corrections":"A misnumbered dot, a printing problem, a translation that reads oddly — report it and we will fix the page.","licensingTitle":"Classroom and licensing questions.","licensing":"Personal and classroom printing is already free. For anything beyond that — republishing, bundling, or commercial use — ask first.","licensingNote":"(see our <link>terms of use</link>).","feedbackTitle":"Feedback.","feedback":"What works, what doesn't, what you would like more of.","responseTitle":"Response time","response":"This is a small operation, so replies can take a few days. Correction reports get priority.","aboutPrefix":"More about the site and who makes it:","aboutLink":"about us"},"puzzleDetail":{"agesLabel":"Ages:","dotsLabel":"Dots:","freeLabel":"100% Free","difficultyHeading":"Difficulty","difficultyEasy":"Easy","difficultyMedium":"Medium","difficultyHard":"Hard","funFactPrefix":"Fun fact:","funFactLabel":"Fun fact!","noSignUp":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use.","comingSoon":"Download Free PDF – Coming Soon","youMightLike":"You might also like","faqQ1":"What age is the {name} dot to dot puzzle for?","faqA1":"It is designed for ages {age}. With {dots} dots, it suits children who can confidently count to {dots}; younger children can complete it with a little help.","faqQ2":"How do I print the {name} worksheet?","faqA2":"Click the download button to get the free PDF, then print it on regular paper (A4 or US Letter) from any browser or PDF reader. No special software is needed.","faqQ3":"Is the {name} printable really free?","faqA3":"Yes — it is 100% free, with no sign-up, account, or payment required. You may print it for home or classroom use."},"blogPage":{"eyebrow":"Learning resources","h1":"Dot to Dot Ideas for Parents and Teachers","description":"Practical guides for choosing activities, building early learning skills, and using printable worksheets at home or in the classroom.","breadcrumb":"Blog","latestEyebrow":"Latest articles","latestH2":"Helpful ideas you can use today","readArticle":"Read article","by":"By","backToAll":"← Back to all articles","savePinterest":"Save to Pinterest","relatedEyebrow":"Free printables","relatedHeading":"Try these dot to dot collections next"},"downloadButton":{"label":"Download Free Printable PDF","usage":"Free for home and classroom use.","paperNote":"Sized for {size} paper.","paperLetter":"US Letter","paperA4":"A4","alternateLink":"Prefer {size}? Download that version","downloadSize":"Download (Print Size: {size})"},"downloadBadge":{"downloaded":"Downloaded","times":"times","greatChoice":"You’ve made a great choice!"},"bookmarkButton":{"regionLabel":"Bookmark this page","shortcut":"Press <shortcut></shortcut> to bookmark!","dismiss":"Dismiss","shared":"Shared!","buttonAria":"Save or share this puzzle page","buttonTitle":"Save this puzzle","saved":"Saved!","save":"Save"},"languageSwitcher":{"label":"Language","selectLabel":"Select language"},"share