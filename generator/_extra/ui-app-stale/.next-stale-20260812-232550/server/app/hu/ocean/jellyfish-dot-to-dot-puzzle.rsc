2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://dottodotfreeprintables.com/hu/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ocean\",\"item\":\"https://dottodotfreeprintables.com/hu/ocean/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Medúza\",\"item\":\"https://dottodotfreeprintables.com/hu/ocean/jellyfish-dot-to-dot-puzzle/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"Medúza\",\"description\":\"Köss össze 88 pontot, hogy megrajzold ezt a sodródó óceáni csodát. Ez a kicsit nagyobb, 6-9 éves gyerekeknek szánt feladatlap remek lépés előre azoknak, akik már készen állnak a hosszabb számsorokra és a részletesebb pontról pontra gyakorlásra.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"Zsemle","children":[["$","$Lf",null,{"href":"/hu/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Otthon"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/hu/ocean/","children":"Ocean"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"Medúza"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Medúza körvonala 88 számozott ponttal, közepes nehézségű ingyenes nyomtatható óceáni rejtvény","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":["Free ","Ocean"," Printable"]}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Medúza Dot-to-Dot Printable"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Köss össze 88 pontot, hogy felfedd a tengeren sodródó kecses medúzát. Ez a valamivel nagyobb kirakós nagyszerű lépés a 6-9 éves gyermekek számára, akik készen állnak az extra pontokra és a részletesebb számsorrend-gyakorlásra."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Nehézség 1 a 3-ból","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","A medúzáknak nincs agyuk, szívük és csontjaik — mégis több mint 500 millió éve túlélnek!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],["$","p",null,{"className":"asset-note","children":"Printable PDF path is not present in the export JSON."}],"$L10",["$","$L11",null,{"title":"Medúza Pont-pont Nyomtatható - Ingyenes PDF","imageUrl":"","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/hu/ocean/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}]," Back to all ","Ocean"," puzzles"]}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Medúza"," Dot-to-Dot Puzzle Guide"]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"A medúzák az óceán legfurcsább és legősibb állatai közé tartoznak – jóval azelőtt sodródtak a tengereken, hogy a dinoszauruszok megjelentek volna a Földön, és jóval azelőtt, hogy a halak, vagy akár a csontok is léteztek volna. Agy, szív és vér nélkül élő bizonyítékai annak, hogy a természetnek nincs szüksége bonyolultságra a sikerhez. Ez a 88 pontos kirakó egy kielégítő lépés az idősebb gyermekek számára, akik készen állnak a nagyobb kihívásra. Keresd meg az 1. pontot, és kezdjünk sodródni!"}}],[["$","div","1–18",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–18"," — ","A harang"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Kezdd az 1. pontnál, és csatlakozz a 18. ponthoz, hogy átrajzold a lekerekített, kupola alakú harangot – a medúza fő testét. Ez a kirakó legnagyobb része, és remek lehetőség a sima, széles ívek gyakorlására a ceruza felemelése nélkül. Bátorítsd a lassú, egyenletes vonásokat, hogy a kupola alakja szép és egyenletes maradjon."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"A medúza harangja nemcsak egy testformát jelöl – az állat mozgását is. A harang összehúzásával és ellazításával, mint egy pulzáló esernyő, a medúza vizet löki ki maga mögé, és előrehajtja magát. Ez az állatvilág egyik legrégebbi és legegyszerűbb mozgásformája, és 500 millió évvel később is gyönyörűen működik."]}]]}]]}],["$","div","19–40",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["19–40"," — ","A rojtok és sallangok"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Folytasd a 19. ponttól a 40. pontig, hogy megrajzold a fodros, szegélyt a harang töve körül. Ebben a részben sok apró, egymáshoz közeli ív található, ami nagyszerű gyakorlás a gondos, türelmes pontkereséshez – jó kihívást jelent a gyerekeknek, akik a legegyszerűbb rejtvényeken túl is haladnak."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Néhány medúzafaj képes saját fényt előállítani egy biolumineszcencia nevű kémiai reakció révén. A mély, sötét óceánban egy világító medúza úgy nézhet ki, mint egy úszó lámpás – ez egy gyönyörű módja annak, hogy vonzza a zsákmányt, vagy megijessze a ragadozót, fajtól függően."]}]]}]]}],["$","div","41–62",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["41–62"," — ","A hátulsó csápok"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"A 41-től 62-ig terjedő pontok segítségével rajzold meg a harang alatt lebegő hosszú, húzódó csápokat. Ezek a vonalak hosszabbak és lazábbak, mint a korábbi részek, ezért bátorítsd a gyerekeket, hogy laza kézzel rajzolják őket, mintha maga a ceruza lebegne a vízben."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"A dobozmedúza csápjai az állatvilág legerősebb mérgét hordozzák, amellyel azonnal elkábítják a kis halakat és garnélákat. A legtöbb medúza azonban ártalmatlan az emberre – csak egy maroknyi faj képes olyan csípést okozni, ami miatt az embereknek aggódniuk kellene."]}]]}]]}],["$","div","63–80",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["63–80"," — ","A szájüregi karok"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Kösd össze a 63-as és 80-as pontokat, hogy hozzáadd a medúza közepe közelében található rövidebb, fodrosabb szájkarokat, amelyek segítenek a táplálékot a szája felé terelni. Ez a rész a nagy figyelmet érdemli, mivel a vonalak egymáshoz közel helyezkednek el. A lassabb tempó itt a legtisztább eredményt eredményezi."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"A medúzáknak nincs szájuk és külön kijáratuk – a táplálék és a salakanyag ugyanazon a nyíláson keresztül kerül be és ki. Szokatlanul hangozhat, de ez egy csodálatosan hatékony konstrukció, amely félmilliárd éve nem igényelt fejlesztéseket."]}]]}]]}],["$","div","81–88",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["81–88"," — ","Az utolsó szálak"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Fejezd be a kirakóst a 81-től 88-ig terjedő pontok összekötésével, hogy befejezd az utolsó néhány sodródó szálat a csápok alatt. Már csak nyolc pont van hátra a célvonalig – ez egy nyugodt, gyengéd módja egy nagyobb kirakós megoldásának. Vegyél egy mély lélegzetet, és hagyd, hogy az utolsó vonalak természetesen a helyükre kerüljenek."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Medúzák a Föld minden óceánjában megtalálhatók, az Egyenlítő közelében lévő meleg felszíni vizektől a sarkvidékek fagyos mélységéig. Egyes fajokat több mint 3600 méterrel a felszín alatt találtak, csendben sodródva teljes sötétségben."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["More free ","Ocean"," printables"]}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","mermaid-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/hu/ocean/mermaid-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Sellő alakja 54 számozott ponttal körberajzolva, ingyenes nyomtatható óceáni pontról pontra lap","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","children":[["$","p",null,{"className":"puzzle-category","children":"Ocean"}],["$","h3",null,{"children":"Sellő"}],["$","div",null,{"className":"puzzle-meta","children":[["$","span",null,{"children":""}],["$","span",null,{"children":"1–0 pont"}]]}],["$","$Lf",null,{"href":"/hu/ocean/mermaid-dot-to-dot-puzzle/","className":"download-link","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":15,"height":15,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"r