e:["$","$L12",null,{"formats":"$undefined","locale":"pt-BR","messages":{"nav":{"scanMe":"Escaneie-me","blog":"Blog","search":"Procurar","kids":"Crianças - Quebra-cabeças","teachers":"Professores","parents":"Pais","contact":"Contate-nos","freePack":"Pacote grátis"},"homepageUi":{"title":"Encontre as melhores atividades de ligar pontos para imprimir","description":"Imprima, ligue os pontos e dê vida a imagens incríveis. Grátis e pronto pra diversão!","searchPlaceholder":"Experimente oceano, dinossauro ou flores","filterPuzzles":"Filtrar quebra-cabeças","age":"Idade","dots":"pontos","featuredPuzzles":"Quebra-cabeças para imprimir em destaque","savePuzzle":"Salvar {name}","removeSavedPuzzle":"Remover {name} dos salvos","downloads":"downloads","bookTitle":"O melhor de 2026 · {count}","bookDescription":"Nossos quebra-cabeças de ligar pontos favoritos em um único livro PDF para imprimir.","searchUnavailable":"A busca está temporariamente indisponível. Tente novamente.","popularEyebrow":"Popular esta semana","mostDownloaded":"Quebra-cabeças mais baixados","downloadCountAria":"{count} ou mais downloads","freshPrintables":"Imprimíveis novos","recentlyAdded":"Adicionados recentemente","browseCategories":"Navegar por categorias de quebra-cabeças","openCategories":"Abrir menu de categorias","closeCategories":"Fechar menu de categorias","browseByTheme":"Navegar por tema","quickLinks":"Links rápidos","bundlePacks":"Pacotes de Bundles","parentsTeachers":"Para Pais e Professores","more":"Mais categorias","kids":"Crianças","categoryNames":{"cute":"Quebra-cabeças fofos","flowers":"Flores"}},"audience":{"kidsTitle":"Para crianças","kidsText":"Temas amigáveis ​​de animais, dinossauros e veículos com pontos numerados claros. Vitórias fáceis que aumentam a confiança.","parentsTitle":"Para pais","parentsText":"Atividades relaxantes sem telas para casa, viagens e restaurantes. Imprima de qualquer dispositivo em menos de um minuto.","teachersTitle":"Para professores","teachersText":"Atividades de ligar os pontos com pouco preparo, ideais para atividades matinais, alunos que terminam as tarefas mais cedo, professores substitutos e estações de aula — sem necessidade de preparação."},"categories":{"eyebrow":"Organizado por tema e nível de habilidade","heading":"Navegue pelos jogos de ligar os pontos por categoria","description":"Desde formas simples com 10 pontos para crianças pequenas até desafios com 200 pontos para crianças maiores — tudo organizado por categoria para que você encontre o arquivo para imprimir gratuito ideal em segundos.","puzzles":"{count, plural, one {# quebra-cabeça} other {# quebra-cabeças}}","comingSoon":"Em breve","badges":{"dinosaurs":"Disponível agora!","ocean":"Disponível agora!","playgrounds":"Disponível agora!","garden":"Disponível agora!","usa250":"Novo!","uae":"Disponível agora!","cute":"Novo!","circus":"Novo!"},"items":{"dinosaurs":{"name":"Dinossauros","description":"Prepare-se para uma aventura pré-histórica! {count} que seus filhos vão adorar."},"animals":{"name":"Animais","description":"Criaturas amigáveis ​​para praticar números desde cedo."},"vehicles":{"name":"Veículos","description":"Carros, caminhões, foguetes e máquinas."},"fantasy":{"name":"Fantasia","description":"Castelos, unicórnios, dragões e ideias para histórias."},"seasonal":{"name":"Sazonal","description":"Atividades com calendário de feriados e salas de aula."},"ocean":{"name":"Oceano","description":"Desenhos para colorir de animais marinhos e paisagens tranquilas."},"playgrounds":{"name":"Parques infantis","description":"Balanços, escorregadores e diversão ao ar livre para os pequenos aventureiros."},"garden":{"name":"Jardim","description":"Luvas, pás e ferramentas para os pequenos ajudantes do jardim."},"usa250":{"name":"América 250 Anos","description":"Comemore o 250º aniversário dos Estados Unidos com quebra-cabeças patrióticos de ligar os pontos que homenageiam a história americana."},"uae":{"name":"Emirados Árabes Unidos","description":"Explore os Emirados Árabes Unidos! Pontos turísticos icônicos como o Burj Al Arab, prontos para conectar e colorir."},"space":{"name":"Espaço","description":"Planetas, astronautas e aventuras em foguetes."},"worksheets":{"name":"Folhas de exercícios","description":"Folhas de sequenciamento numérico prontas para uso em sala de aula."},"bigDotBooks":{"name":"Livros Big Dot","description":"Quebra-cabeças de formato longo para alunos mais velhos com foco."},"cute":{"name":"Bonitinho","description":"Filhotes adoráveis, carrinhos e {count} encantadores quebra-cabeças de ligar os pontos gratuitos que seus filhos vão adorar."},"circus":{"name":"Circo","description":"Mestres de cerimônia, tendas grandes e diversão de show para jovens aprendizes."}}},"puzzleSection":{"eyebrow":"Amostras imprimíveis gratuitas — sem necessidade de cadastro","heading":"Folhas populares de ligar os pontos para imprimir agora","weeklyPack":"Veja o pacote semanal →","downloadLink":"Baixe gratuitamente a versão para impressão.","new":"Novo","imageAlt":"{name} folha de exercícios gratuita para imprimir de ligar os pontos para {age}","categories":{"Dinosaurs":"Dinossauros","Ocean":"Oceano","Playgrounds":"Parques infantis","Garden":"Jardim","Cute":"Bonitinho","USA 250 Years":"América 250 Anos","UAE":"Emirados Árabes Unidos"},"items":{"trex-61-dot-to-dot-puzzle":{"name":"Desafio T-Rex de 61 pontos"},"brontosaurus-dot-to-dot-puzzle":{"name":"Brontossauro"},"mermaid-dot-to-dot-puzzle":{"name":"Sereia"},"merman-dot-to-dot-puzzle":{"name":"Tritão"},"seahorse-dot-to-dot-puzzle":{"name":"Cavalo-marinho"},"whale-dot-to-dot-puzzle":{"name":"Baleia"},"swing-playgrounds-dot-to-dot-puzzle":{"name":"Parque infantil com balanços"},"slide-playgrounds-dot-to-dot-puzzle":{"name":"Parque infantil com escorregador"},"seesaw-playground-dot-to-dot-puzzle":{"name":"Parque infantil Gangorra"},"roller-coaster-playground-dot-to-dot-puzzle":{"name":"Parque de diversões com montanha-russa"},"wheelbarrow-playground-dot-to-dot-puzzle":{"name":"Parque infantil com carrinho de mão"},"garden-gloves-dot-to-dot-puzzle":{"name":"Luvas de jardinagem"},"garden-trowel-dot-to-dot-puzzle":{"name":"Pá de jardim"},"gas-balloon-usa-250-dot-to-dot-puzzle":{"name":"Balão a gás América 250"},"america-250-birthday-fireworks-dot-to-dot-puzzle":{"name":"Fogos de artifício do 250º aniversário dos Estados Unidos"},"america-250-anniversary-liberty-bell-wings-1776-dot-to-dot-puzzle":{"name":"América 250 Asas do Sino da Liberdade"},"usa-250-astronaut-dot-to-dot-puzzle":{"name":"Astronauta americano 250"},"usa-250-anniversary-sports-kids-podium-dot-to-dot-puzzle":{"name":"Pódio Infantil Esportivo do 250º Aniversário dos Estados Unidos"},"usa-250-anniversary-airplane-banner-dot-to-dot-puzzle":{"name":"Bandeira comemorativa do 250º aniversário dos Estados Unidos"},"usa-250-space-shuttle-dot-to-dot-puzzle":{"name":"Ônibus Espacial America 250"},"usa-250-birthday-balloons-stars-dot-to-dot-puzzle":{"name":"Balões e estrelas para comemorar o 250º aniversário dos Estados Unidos"},"usa-250-birthday-cake-dot-to-dot-puzzle":{"name":"Bolo de aniversário de 250 anos dos Estados Unidos"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"Bandeira da Águia dos 250 Anos da América"},"burj-al-arab-dot-to-dot-puzzle":{"name":"Burdj Al Árab"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"Cafeteira Dallah"}}},"benefits":{"eyebrow":"Com o apoio de educadores da primeira infância.","heading":"Por que as folhas de exercícios de ligar os pontos são ótimas para o desenvolvimento infantil","description":"Os desenhos para imprimir de ligar os pontos são mais do que apenas diversão — são uma ferramenta comprovada por pesquisas, utilizada por professores da pré-escola e do jardim de infância para desenvolver habilidades essenciais de aprendizagem precoce.","fineMotorTitle":"Desenvolve a coordenação motora fina.","fineMotorText":"Desenhar linhas de ligar os pontos desenvolve a pega correta do lápis, a coordenação motora e o controlo muscular necessários para a escrita manual.","numberTitle":"Reforça o reconhecimento de números.","numberText":"Seguir a sequência de pontos 1 → 2 → 3 ensina a ordem dos números, o reconhecimento de números e conceitos matemáticos básicos de forma natural e lúdica.","focusTitle":"Melhora o foco e a concentração.","focusText":"Completar um quebra-cabeça de ligar os pontos exige atenção sustentada — uma maneira calma e sem telas de praticar o foco para crianças da pré-escola até o 3º ano do ensino fundamental.","confidenceTitle":"Recompensa e confiança instantâneas","confidenceText":"Quando a imagem escondida aparece, as crianças sentem uma sensação imediata de conquista. Essa pequena vitória constrói o amor pelo aprendizado e uma mentalidade de crescimento."},"howTo":{"eyebrow":"Pronto em menos de 60 segundos","heading":"Como baixar e imprimir suas folhas de exercícios de ligar os pontos gratuitas","step1Title":"Escolha o seu quebra-cabeça","step1Text":"Escolha um tema (animais, dinossauros, veículos, feriado) e uma gama de pontos que corresponda à idade e ao nível de habilidade do seu filho.","step2Title":"Baixe o PDF gratuito","step2Text":"Clique em \"Baixar versão para impressão gratuita\" — sem necessidade de cadastro, e-mail ou pagamento. Seu navegador fará o download do PDF instantaneamente.","step3Title":"Imprima e aproveite!","step3Text":"Imprima em papel tamanho Carta padrão (8,5\" × 11\"). A impressão em preto e branco funciona perfeitamente. Entregue para seu filho e observe-o conectar os pontos!"},"trust":{"eyebrow":"Por que pais e professores nos escolhem?","heading":"Gratuito, seguro e ridiculamente fácil de usar.","noAccountTitle":"Não é necessário criar uma conta.","noAccountText":"Todos os desenhos para imprimir de ligar os pontos são baixados imediatamente — sem cadastro, sem e-mail, sem pagamento. Basta clicar e imprimir.","safeTitle":"Seguro para sala de aula","safeText":"Páginas de quebra-cabeças limpas e sem anúncios, projetadas para impressoras escolares. Ideais para atividades matinais, tarefas de casa ou momentos de tranquilidade.","fastTitle":"Rápido por natureza","fastText":"Páginas estáticas, imagens otimizadas e fontes locais garantem que os quebra-cabeças carreguem rapidamente em qualquer dispositivo — celular, tablet ou laptop."},"faq":{"eyebrow":"Perguntas frequentes","heading":"Perguntas frequentes","q1":"Todos os desenhos para ligar os pontos neste site são totalmente gratuitos?","a1":"Sim — todas as folhas de exercícios de ligar os pontos no DotToDotFreePrintables.com são 100% gratuitas para baixar e imprimir. Não é necessário criar uma conta, assinar um plano ou usar cartão de crédito.","q2":"Para que idade são adequadas as folhas de exercícios de ligar os pontos?","a2":"Nossos materiais para imprimir abrangem idades de 2 a 12 anos. As folhas de atividades fáceis (10 a 20 pontos) são adequadas para crianças pequenas e em idade pré-escolar, as folhas de nível médio (20 a 50 pontos) são ótimas para o jardim de infância e o 1º ano, e as folhas mais difíceis (50 a mais de 200 pontos) desafiam alunos do 2º ao 6º ano.","q3":"Qual o formato dos desenhos para imprimir de ligar os pontos?","a3":"Todas as folhas de exercícios são baixadas como arquivos PDF prontos para impressão, no tamanho padrão de papel Carta (8,5\" × 11\"). Abra em qualquer navegador ou visualizador de PDF e imprima — nenhum software especial é necessário.","q4":"Você tem folhas de atividades de ligar os pontos para pré-escola e jardim de infância?","a4":"Com certeza. Nossas folhas de atividades mais fáceis começam com 1 a 10 pontos (perfeitas para crianças de 2 a 4 anos) e incluem temas de reconhecimento de alfabeto e números, desenvolvidos para salas de aula da pré-escola e do jardim de infância.","q5":"Os professores podem usar essas folhas de exercícios de ligar os pontos em sala de aula?","a5":"Sim! Nossos materiais para impressão são gratuitos para uso pessoal e em sala de aula. Eles são populares para atividades matinais, atividades para alunos que terminam as tarefas mais cedo, planos de aula para professores substitutos, centros de desenvolvimento da coordenação motora fina e pacotes de tarefas de casa.","q6":"Os jogos de ligar os pontos ajudam a desenvolver a coordenação motora fina?","a6":"Sim — ligar os pontos com linhas ajuda a desenvolver a força da preensão do lápis e a coordenação motora, que são essenciais para o desenvolvimento da escrita. Muitos terapeutas ocupacionais e professores da educação infantil recomendam atividades de ligar os pontos por esse motivo.","q7":"Você tem desenhos para imprimir de ligar os pontos com temas como animais ou dinossauros?","a7":"Temos 11 categorias, incluindo animais, dinossauros, veículos, criaturas marinhas, parques infantis, 250 anos da América, espaço, fantasia, temas sazonais/de feriados, pacotes de atividades para professores e livros de pontos grandes. Novos designs são adicionados semanalmente.","q8":"Posso imprimir esses quebra-cabeças em preto e branco?","a8":"Sim, todas as nossas folhas de exercícios de ligar os pontos são projetadas para impressão em preto e branco, economizando tinta. Elas ficam ótimas em qualquer impressora doméstica ou escolar."},"newsletter":{"eyebrow":"Kit inicial para imprimir — totalmente grátis","heading":"Receba 20 desenhos para ligar os pontos gratuitos diretamente na sua caixa de entrada.","description":"Uma coleção prática para pais e professores, que abrange animais, veículos, dinossauros e temas sazonais — todas no tamanho padrão de papel Carta (US Letter) e otimizadas para impressão em preto e branco."},"blog":{"eyebrow":"Ideias para adultos","heading":"Dicas de aprendizagem para casa e para a sala de aula.","viewAll":"Ver todos os artigos","read":"Ler"},"feedback":{"eyebrow":"Adoraríamos ouvir sua opinião.","heading":"Enviar feedback","description":"Tem uma ideia para um enigma, encontrou um link quebrado ou só quer dizer olá? Deixe uma mensagem abaixo."},"footer":{"description":"Desenhos de ligar os p