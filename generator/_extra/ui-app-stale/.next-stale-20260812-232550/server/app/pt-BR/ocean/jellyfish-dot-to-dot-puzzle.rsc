lidate.01","content":"B681C0C723F28F15919D6170A9C0E054"}],["$","meta","45",{"name":"google-adsense-account","content":"ca-pub-8007137365521327"}],["$","meta","46",{"property":"og:title","content":"Água-Viva Ligar os Pontos — Desafio de 88 Pontos"}],["$","meta","47",{"property":"og:description","content":"Esta atividade de 88 pontos avança para o nível intermediário das nossas atividades de ligar os pontos, pensada para crianças de 6 a 9 anos do ensino fundamental que já dominam o básico. Sem cérebro, sem coração, sem ossos — e ainda assim as águas-vivas existem há 500 milhões de anos. Baixe o PDF em A4 e trace essa sobrevivente do oceano."}],["$","meta","48",{"property":"og:url","content":"https://dottodotfreeprintables.com/pt-BR/ocean/jellyfish-dot-to-dot-puzzle/"}],["$","meta","49",{"property":"og:site_name","content":"DotToDotFreePrintables.com"}],["$","meta","50",{"property":"og:type","content":"article"}],["$","meta","51",{"name":"twitter:card","content":"summary"}],["$","meta","52",{"name":"twitter:title","content":"Água-Viva Ligar os Pontos — Desafio de 88 Pontos"}],["$","meta","53",{"name":"twitter:description","content":"Esta atividade de 88 pontos avança para o nível intermediário das nossas atividades de ligar os pontos, pensada para crianças de 6 a 9 anos do ensino fundamental que já dominam o básico. Sem cérebro, sem coração, sem ossos — e ainda assim as águas-vivas existem há 500 milhões de anos. Baixe o PDF em A4 e trace essa sobrevivente do oceano."}],["$","link","54",{"rel":"icon","href":"/favicon.ico?v=previous-dot-icon"}],["$","link","55",{"rel":"icon","href":"/favicon.svg?v=previous-dot-icon","type":"image/svg+xml"}],["$","link","56",{"rel":"icon","href":"/favicon-16x16.png?v=previous-dot-icon","sizes":"16x16","type":"image/png"}],["$","link","57",{"rel":"icon","href":"/favicon-32x32.png?v=previous-dot-icon","sizes":"32x32","type":"image/png"}],["$","link","58",{"rel":"apple-touch-icon","href":"/apple-touch-icon.png?v=previous-dot-icon","sizes":"