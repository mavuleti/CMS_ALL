ck","coverAlt":"Best of 2026 - 25 Dot to Dot Puzzles book cover","oneTime":"one time","buyButton":"Get the puzzle pack","localNote":"On localhost, this opens a safe checkout demo and never charges a card.","detailsEyebrow":"Made for easy print-and-play","detailsHeading":"Everything you need for screen-free fun","detailsText":"Download once, keep it handy, and print the activities you want whenever you need them.","benefits":{"onePdf":"One convenient, print-ready PDF","kidFriendly":"Kid-friendly puzzles with varied difficulty","paperSizes":"Works on US Letter and A4 paper","instantAccess":"Instant access after successful payment","classroomUse":"Use at home or in one classroom"},"guaranteeHeading":"Simple, secure, and ready in minutes","guaranteeText":"After checkout, your private download link appears immediately. No subscription and no surprise renewal."},"checkout":{"consent":"I agree to immediate delivery of this digital PDF and understand that, once access begins, the sale is final and non-refundable except where required by law or if the file is not delivered or is defective.","refundPolicy":"Read the refund policy","opening":"Opening checkout...","secureNote":"Secure checkout powered by Stripe. One-time payment. No subscription.","error":"Something went wrong starting checkout. Please try again."},"success":{"metaTitle":"Thank You for Your Purchase","eyebrow":"Payment confirmed","heading":"Thank you! Your purchase is complete.","lede":"Your payment was successful. It may take a few seconds for your purchase to appear on your account."},"cancelled":{"metaTitle":"Checkout Cancelled","eyebrow":"No payment taken","heading":"Checkout cancelled","lede":"No charge was made. You can try again any time."},"download":{"demoTitle":"Local checkout test passed.","demoText":"The real paid success screen shows the PDF download button here. The local demo does not release the private file.","button":"Download your puzzle pack","expires":"This link expires in 24 hours. Save yo