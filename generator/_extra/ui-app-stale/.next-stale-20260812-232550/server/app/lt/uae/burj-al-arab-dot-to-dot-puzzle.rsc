",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Burės formos „Burj Al Arab“ viešbutis, iškylantis iš 66 taškų orientyrų galvosūkio puslapyje","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":["Free ","Uae"," Printable"]}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Buržas Al Arab Dot-to-Dot Printable"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Sujunkite 66 taškų, kad atskleistumėte Burj Al Arab, ikonišką burės formos viešbutį, kylantį iš savo salos prie Dubajaus krantų. Ši lengva galvosūkis puikiai tinka jauniems mokiniams, praktikuojantiems skaičių seką, atrandant vieną iš garsiausių pasaulio panoramų."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Sudėtingumas 1 iš 3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Burj Al Arab stovi dirbtinėje saloje ir yra vienas aukščiausių viešbučių pasaulyje!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],["$","p",null,{"className":"asset-note","children":"Printable PDF path is not present in the export JSON."}],"$L10",["$","$L11",null,{"title":"Buržas Al Arab Taškas į Tašką Spausdinamas - Nemokamas PDF","imageUrl":"","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/lt/uae/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}]," Back to all ","Uae"," puzzles"]}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Buržas Al Arab"," Dot-to-Dot Puzzle Guide"]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"„Burj Al Arab“ yra vienas atpažįstamiausių pastatų Žemėje – žvilgantis, burės formos bokštas, kylantis iš savo dirbtinės salos Persijos įlankoje. Pastatytas taip, kad atrodytų kaip plazdanti tradicinio dhow laivo burė, jis tapo šiuolaikinio Dubajaus ir Jungtinių Arabų Emyratų simboliu. Šioje 66 taškų dėlionėje pavaizduotas jo dramatiškas išlenktas siluetas. Raskite 1 tašką ir kartu sukurkime šią garsiąją miesto panoramą!"}}],[["$","div","1–13",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–13"," — ","Stiebas ir antgalis"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Pradėkite nuo 1 taško ir jungkitės su 13 tašku, kad nubrėžtumėte aukštą, išlenktą stiebą pačiame pastato viršuje. Ši siaura atkarpa nuo pat pradžių lavina tvirtą valdymą pieštuku – puikus apšilimas prieš platesnes formas apačioje. Skatinkite vaikus išlaikyti linijas lygias ir šiek tiek išlenktas, kaip ir tikroje burėje."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"„Burj Al Arab“ yra maždaug 321 metro (1053 pėdų) aukščio, todėl tai yra vienas aukščiausių viešbučių pastatų pasaulyje. Jo išskirtinis stiebas viršuje netgi turi sraigtasparnių nusileidimo aikštelę, kurioje aukštai virš jūros vyko teniso rungtynės ir golfo demonstracijos! Daugiau skaitykite <a href=\"https://en.wikipedia.org/wiki/Burj_Al_Arab\" target=\"_blank\" rel=\"nofollow noopener noreferrer\">Vikipedijos straipsnyje apie „Burj Al Arab“</a>."]}]]}]]}],["$","div","14–26",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["14–26"," — ","Lenkta burė"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Tęskite nuo 14 iki 26 taško, kad nubrėžtumėte garsųjį išlenktą pastato fasadą – tą dalį, kuri atrodo kaip vėjo pripildyta burė. Vaikai čia praktikuoja ilgą, grakščią išorinę kreivę – vieną maloniausių formų visoje dėlionėje. Lėta, tvirta ranka leidžia geriausiai nubrėžti šluojančią liniją."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Pastatą suprojektavo architektas Tomas Wrightas, norėjęs sukurti tokį ikonišką statinį kaip Sidnėjaus operos teatras ar Eifelio bokštas. Burės formą įkvėpė tradiciniai arabų burlaiviai „dhow“, kurie šimtmečius plaukioja Meksikos įlankoje."]}]]}]]}],["$","div","27–39",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["27–39"," — ","Nugaros atramos rėmas"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Apibrėžkite taškus nuo 27 iki 39, kad nubrėžtumėte aukštą vertikalią atraminę konstrukciją, kuri sutvirtina pastatą iš galo. Šioje dalyje pristatomos tiesesnės linijos, sumaišytos su švelniais kampais, suteikiant vaikams galimybę judėti tarp lenktų ir tiesių brūkšnių toje pačioje dėlionėje."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"„Burj Al Arab“ iš tikrųjų nėra aukščiausias pastatas Dubajuje – šis titulas priklauso „Burj Khalifa“, kuris yra daugiau nei dvigubai aukštesnis! Tačiau dėl savo unikalios formos „Burj Al Arab“ išlieka vienu labiausiai fotografuojamų pastatų pasaulyje."]}]]}]]}],["$","div","40–52",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["40–52"," — ","Pagrindinis bokšto korpusas"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Sujunkite taškus nuo 40 iki 52, kad užpildytumėte platų viešbučio bokšto korpusą. Tai didžiausia dėlionės dalis, padedanti vaikams lavinti susikaupimą ir kantrybę, kai atpažįstamas siluetas pradeda įgauti formą."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Viduje „Burj Al Arab“ garsėja didžiuliu atriumu – jis pakankamai aukštas, kad tilptų 590 pėdų aukščio atvira erdvė – vienas aukščiausių atriumų pasaulyje. Vestibiulio fontanai yra sukurti taip, kad šoktų pagal muziką."]}]]}]]}],["$","div","53–66",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["53–66"," — ","Salos bazė"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Užbaikite galvosūkį sujungdami taškus nuo 53 iki 66, kad nupieštumėte pastato pagrindą ir dirbtinę salą, ant kurios jis stovi. Iki finišo linijos liko vos keturiolika taškų – paskatinkite vaikus užbaigti kontūrą užtikrintai, pagrįstai nubrėžtomis paskutinėmis linijomis."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Viešbutis įsikūręs privačioje saloje, sujungtoje su žemynu vingiuotu tiltu. Inžinieriai pirmiausia turėjo pastatyti salą iš smėlio ir uolienų, prieš pradedant paties bokšto statybas – visas projektas užtruko ilgus metus kruopštaus planavimo."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["More free ","Uae"," printables"]}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","burj-khalifa-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/lt/uae/burj-khalifa-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Rekordus laužantis Burj Khalifa bokštas, sudarytas iš 60 spausdinamų numeruotų taškų","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","children":[["$","p",null,{"className":"puzzle-category","children":"Uae"}],["$","h3",null,{"children":"Burdž Chalifa"}],["$","div",null,{"className":"puzzle-meta","children":[["$","span",null,{"children":""}],["$","span",null,{"children":"1–0 taškai"}]]}],["$","$Lf",null,{"href":"/lt/uae/burj-khalifa-dot-to-dot-puzzle/","className":"download-link","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":15,"height":15,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true","children":[["$","path","r04s7s",{"d":"M11.525 2.295a.53.