 link appears immediately. No subscription and no surprise renewal."},"checkout":{"consent":"I agree to immediate delivery of this digital PDF and understand that, once access begins, the sale is final and non-refundable except where required by law or if the file is not delivered or is defective.","refundPolicy":"Read the refund policy","opening":"Opening checkout...","secureNote":"Secure checkout powered by Stripe. One-time payment. No subscription.","error":"Something went wrong starting checkout. Please try again."},"success":{"metaTitle":"Thank You for Your Purchase","eyebrow":"Payment confirmed","heading":"Thank you! Your purchase is complete.","lede":"Your payment was successful. It may take a few seconds for your purchase to appear on your account."},"cancelled":{"metaTitle":"Checkout Cancelled","eyebrow":"No payment taken","heading":"Checkout cancelled","lede":"No charge was made. You can try again any time."},"download":{"demoTitle":"Local checkout test passed.","demoText":"The real paid success screen shows the PDF download button here. The local demo does not release the private file.","button":"Download your puzzle pack","expires":"This link expires in 24 hours. Save your download somewhere safe.","failed":"We couldn't confirm your purchase yet. If you were charged, please refresh this page in a minute or contact us for help.","preparing":"Preparing your download..."},"ad":{"advertisementAria":"Advertisement: Best of 2026 dot to dot activity book","viewPackAria":"View the Best of 2026 dot to dot puzzle pack","pdfBook":"PDF BOOK","bookTitle":"Best of 2026","packName":"Dot to Dot Puzzle Pack","puzzleCount":"25 Dot to Dot Puzzles","viewBook":"View book"},"shared":{"specialSale":"Special sale","returnToPack":"Return to the puzzle pack","contactUs":"Contact us"}}},"now":"$undefined","timeZone":"America/New_York","children":[["$","$L13",null,{}],"$L14",["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","$4","children"],"error":"$undefin