2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://dottodotfreeprintables.com/sk/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Dinosaurs\",\"item\":\"https://dottodotfreeprintables.com/sk/dinosaurs/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Alosaurus\",\"item\":\"https://dottodotfreeprintables.com/sk/dinosaurs/allosaurus/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"Alosaurus\",\"description\":\"Allosaurus vládol júre dlho predtým, ako sa objavil T-Rex. Sledujte 42 bodov okolo tohto mocného predátora v hádanke navrhnutej pre deti vo veku 6–10 rokov.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"Navigačná cesta","children":[["$","$Lf",null,{"href":"/sk/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Domov"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/sk/dinosaurs/","children":"Dinosaurs"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"Alosaurus"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Hrozivý Allosaurus s odhalenými silnými čeľusťami, zostavený z 42 tlačiteľných bodov","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":["Free ","Dinosaurs"," Printable"]}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Alosaurus Dot-to-Dot Printable"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Spojte body, aby ste odhalili Allosaurusa — najznámejšieho dinosaura obdobia jury, ešte predtým, ako existoval T-Rex! Mal silné zuby, mocné čeľuste a mohol žiť v skupinách. Tento ťažší pracovný list predstavuje výzvu pre žiakov 1. až 3. ročníka."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Obtiažnosť 1 z 3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Na jednom mieste v Utahu sa našlo viac ako 40 fosílií alosaura!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],["$","p",null,{"className":"asset-note","children":"Printable PDF path is not present in the export JSON."}],"$L10",["$","$L11",null,{"title":"Alosaurus Spoj bodky - Bezplatný PDF","imageUrl":"","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/sk/dinosaurs/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}]," Back to all ","Dinosaurs"," puzzles"]}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Alosaurus"," Dot-to-Dot Puzzle Guide"]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Dlho predtým, ako T-Rex vládol kriedovému obdobiu, bol Allosaurus najpozoruhodnejším veľkým dinosaurom na Zemi. Tento jurský objaviteľ, rýchlejší, obratnejší a možno aj múdrejší ako mnoho dinosaurov v okolí, bol hviezdou svojej doby. So 42 bodkami a obtiažnosťou „ťažká“ je táto hádanka skutočnou skúškou počítacích schopností a sústredenia – ideálna pre staršie deti, ktoré sú pripravené na skutočnú výzvu!"}}],[["$","div","1–8",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–8"," — ","Hlava"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Začnite od bodu 1 a prepojte ho s bodom 8, aby ste nakreslili veľkú, hlbokú lebku s charakteristickými hrebeňmi nad očami. Allosaurus mal kostnaté hrebene, ktoré sa tiahli od ňufáka až nad oči – detail, vďaka ktorému vyzeral skutočne divoko. Deti si precvičujú kreslenie výrazného, ​​hranatého tvaru lebky s niekoľkými zaujímavými zmenami smeru."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Allosaurus mal veľmi nezvyčajnú čeľusť – vedci si myslia, že používal veľký, silný uhryznutie tak, že silnou čeľusťou tlačil hlavu nadol silnými krčnými svalmi, a nie len cvakal ako väčšina zvierat. Jeho zúbkované zuby boli pre mäsožravca jeho veľkosti perfektné, vďaka čomu bol jedným z najúčinnejších lovcov jury."]}]]}]]}],["$","div","9–18",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["9–18"," — ","Krk a ramená"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Pokračujte od bodu 9 k bodu 18 a obkreslite silný krk a široké ramená. Allosaurus mal pozoruhodne svalnatý krk, ktorý mu dodával neuveriteľne silný uhryz. Táto časť zahŕňa sebavedomé, plynulé krivky – deti, ktoré sa ponáhľajú, tu majú tendenciu strácať presnosť, takže je to skvelá časť na precvičovanie trpezlivosti."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Allosaurus meral približne 8,5 až 12 metrov a vážil až 2 tony – bol oveľa ľahší ako T-Rex, ale oveľa obratnejší. Vedci sa domnievajú, že táto obratnosť v kombinácii s možným skupinovým správaním mu umožnila pohybovať sa po boku zvierat mnohonásobne väčších ako on sám, vrátane obrovských sauropodov!"]}]]}]]}],["$","div","19–28",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["19–28"," — ","Telo a ruky"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Obkreslite body 19 až 28, aby ste znázornili svalnaté telo a silné trojprsté ruky. Na rozdiel od T-Rexa mal Allosaurus ruky, ktoré mohol skutočne používať – silné a vhodné pre aktívny život v Jurskom období. Deti precvičujú strednú časť s množstvom detailov, čím si budujú sústredenú pozornosť, ktorú si vyžaduje hádanka s obtiažnosťou 3."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"V lome Cleveland-Lloyd Dinosaur Quarry v Utahu sa našlo viac ako 60 jednotlivých exemplárov alosaurov – zďaleka najväčšia koncentrácia kostí jurských predátorov, aká bola kedy objavená. Prečo sa ich toľko ocitlo na jednom mieste, zostáva jednou z najdiskutovanejších záhad paleontológie."]}]]}]]}],["$","div","29–36",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["29–36"," — ","Silné nohy"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Spojte body 29 až 36 a nakreslite dlhé, silné nohy. Allosaurus bol stavaný rovnako pre rýchlosť ako pre silu – jeho nohy boli úmerne dlhšie ako nohy T-Rexa, vďaka čomu bol rýchlejším a obratnejším lovcom. Deti si precvičujú sebavedomé zábery smerom nadol, ktoré vyjadrujú atletickú stavbu zvieraťa."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Allosaurus pravdepodobne dokázal šprintovať rýchlosťou okolo 32 – 50 kilometrov za hodinu – rýchlejšie, ako dokáže bežať väčšina ľudí. Niektorí vedci sa domnievajú, že používal taktiku prepadnutia, pričom sa skrýval v vegetácii a potom zaútočil vysokou rýchlosťou. Boli nájdené fosílne stopy, ktoré ukazujú, ako Allosaurus prenasleduje sauropoda, čo nám poskytuje vzácny pohľad na skutočné lovecké správanie."]}]]}]]}],["$","div","37–42",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["37–42"," — ","Chvost"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Dokončite hádanku spojením bodov 37 až 42, aby ste dostali dlhý, pevný chvost na miesto. Šesť bodiek na uzavretie náročnej hádanky – povzbudzujte deti, aby tieto posledné čiary napísali čo najčistejšie a najistejšie. Silný koniec je rovnako uspokojivý ako silný začiatok."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Allosaurus žil približne pred 155 miliónmi rokov – takmer 90 miliónov rokov pred T-Rexom. Ak dáte Allosaura a T-Rexa vedľa seba v čase, Allosaurus je v skutočnosti geologickým vekom bližšie k Stegosaurovi, ktorého lovil, než k T-Rexovi, ktorý prišiel po ňom. Čas v hlbokej prehistórii je skutočne ohromujúci."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["More free ","Dinosaurs"," printables"]}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","trex-61-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/sk/dinosaurs/trex-61-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Mocný Tyrannosaurus Rex, ktorý vychádza z 61 číslovaných bodiek, bezplatný pracovný list s dinosaurami","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","children":[["$","p",null,{"className":"puzzle-category","children":"Dinosaurs"}],["$","h3",null,{"children":"Výzva T-Rexa 61-bodka"}],["$","div",null,{"className":"puzzle-meta","children":[["$","span",null,{"children":""}],["$","span",null,{"children":"1–0 bodov"}]]}],["$","$Lf",null,{"href":"/sk/dinosaurs/trex-61-dot-to-dot-puzzle/","className":"download-link","children":[[