v",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Chlpatý levíček sa usmieva z 74 prepojených bodov, voľná stránka pre mladých riešiteľov","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":["Free ","Cute"," Printable"]}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Roztomilý lev Dot-to-Dot Printable"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Spojte 74 bodov, aby ste odhalili roztomilého levíčka. Tento jednoduchý tlačiteľný puzzle pomáha mladým žiakom cvičiť sekvencovanie čísel, kontrolu ceruzky a koncentráciu."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Obtiažnosť 1 z 3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Leví rev je počuť až do vzdialenosti 8 kilometrov – ale levíčatá nevedia revať vôbec, kým nemajú približne dva roky. Dovtedy mňaukajú!"]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],["$","p",null,{"className":"asset-note","children":"Printable PDF path is not present in the export JSON."}],"$L10",["$","$L11",null,{"title":"Roztomilý lev Spoj bodky - Bezplatný PDF","imageUrl":"","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/sk/cute/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}]," Back to all ","Cute"," puzzles"]}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Roztomilý lev"," Dot-to-Dot Puzzle Guide"]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Kráľ džungle ešte nikdy nevyzeral tak prítulne! S veľkou nadýchanou hrivou, okrúhlymi líčkami a šuštivým chumáčovým chvostom čaká toto priateľské levíča, kedy skočí na vašu stránku. So 74 bodmi je to uspokojivá výzva, ktorá sa postupne zvyšuje – tak si nabrúste ceruzku, zhlboka sa nadýchnite a dajme tomuto malému kráľovi jeho páperovú korunu!"}}],[["$","div","1–16",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–16"," — ","Nadýchaná hriva"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Začnite od bodu 1 a pokračujte k bodu 16, aby ste nakreslili levovu slávnu nadýchanú hrivu. Hriva sa skladá z množstva malých hrboľov a kriviek, takže je to perfektná rozcvička na starostlivé ovládanie ceruzkou – kreslite jednu vlnu po druhej a nadýchaná hriva sa krásne nahromadí."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Hrivu majú iba samce levov a tá s pribúdajúcim vekom tmavne a hustejšie rastie. Vedci zistili, že levice uprednostňujú levy s najtmavšou a najhustšou hrivou – veľká hriva je znakom silného a zdravého leva."]}]]}]]}],["$","div","17–32",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["17–32"," — ","Tvár a malý nos"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Pokračujte od bodu 17 po bod 32 a vytvarujte okrúhlu tvár leva, gombíkový nos a mäkké líčka. Toto je najdetailnejšia časť skladačky s bodkami umiestnenými blízko seba – skvelé cvičenie trpezlivosti a presnosti pre rastúce ruky."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Levy majú špeciálny drsný jazyk pokrytý malými háčikmi nazývanými papily. Je taký drsný, že dokáže zoškrabovať mäso z kostí – ale levy ho používajú aj jemne, na čistenie svojich mláďat a členov svojej smečky."]}]]}]]}],["$","div","33–48",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["33–48"," — ","Telo"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Obkreslite body 33 až 48, aby ste nakreslili mäkké, zaoblené telo mláďaťa. Čiary sú tu dlhšie a hladšie ako v časti s tvárou, preto povzbudzujte k jednému sebavedomému ťahu na čiaru – je to krásna zmena rytmu po všetkej tej starostlivej práci s detailmi."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Levy sú jediné veľké mačky, ktoré žijú v rodinných skupinách nazývaných smečky. Smečka môže mať až 30 levov a levice v smečke často strážia a dokonca kŕmia navzájom svoje mláďatá."]}]]}]]}],["$","div","49–62",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["49–62"," — ","Nohy a labky"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Spojte bodky 49 až 62 a pridajte pevné nohy a veľké mäkké laby. Levie laby sú nádherne okrúhle, takže spomaľte na krivkách – stabilné, rovné línie im dodajú vzhľad dostatočne pevných na to, aby uniesli budúceho kráľa."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Dospelá levia laba môže byť väčšia ako tanier a má pazúry, ktoré sa zasúvajú ako pazúry domácej mačky. Mláďatá si nacvičujú skákanie na chvosty dávno predtým, ako sa vôbec pustia do skutočného lovu."]}]]}]]}],["$","div","63–74",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["63–74"," — ","Chlpatý chvost"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Dokončite spojením bodov 63 až 74, čím nakreslíte dlhý chvost s nadýchaným chumáčom na špičke. Zostáva už len dvanásť bodiek – hladký a sebavedomý výsledok vdýchne život celému levovi. Nezabudnite na koniec pridať fúzy a šťastný úsmev!"}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Levy sú jediné mačky na svete, ktoré majú na špičke chvosta chumáč srsti. Vnútri chumáča je ukrytá malá kostná výbežok – a nikto si nie je úplne istý, na čo slúži!"]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["More free ","Cute"," printables"]}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","chi