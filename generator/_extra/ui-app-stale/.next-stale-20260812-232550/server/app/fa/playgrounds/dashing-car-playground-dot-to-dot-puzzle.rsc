e:["$","$L12",null,{"formats":"$undefined","locale":"fa","messages":{"nav":{"scanMe":"من را اسکن کن","blog":"وبلاگ","search":"جستجو","kids":"بچه‌ها - پازل","teachers":"معلمان","parents":"والدین","contact":"تماس با ما","freePack":"بسته رایگان"},"homepageUi":{"title":"نقطه‌به‌نقطه‌های قابل چاپ ایده‌آل را پیدا کنید","description":"چاپ کنید، نقطه‌ها را به هم وصل کنید و تصاویر شگفت‌انگیز را زنده کنید. رایگان و آماده برای سرگرمی!","searchPlaceholder":"اقیانوس، دایناسور یا گل را امتحان کنید","filterPuzzles":"فیلتر پازل‌ها","age":"سن","dots":"نقطه","featuredPuzzles":"پازل‌های قابل چاپ ویژه","savePuzzle":"ذخیره {name}","removeSavedPuzzle":"حذف {name} از ذخیره‌شده‌ها","downloads":"دانلود","bookTitle":"برترین‌های ۲۰۲۶ · {count}","bookDescription":"پازل‌های نقطه‌به‌نقطه‌ی مورد علاقه ما در یک کتاب PDF قابل چاپ.","searchUnavailable":"جستجو موقتاً در دسترس نیست. لطفاً دوباره امتحان کنید.","popularEyebrow":"محبوب این هفته","mostDownloaded":"بیشترین پازل‌های دانلود شده","downloadCountAria":"{count} یا بیشتر دانلودها","freshPrintables":"چاپ‌های تازه","recentlyAdded":"به تازگی اضافه شده","browseCategories":"دسته‌بندی‌های پازل را مرور کنید","openCategories":"باز کردن منوی دسته‌بندی‌ها","closeCategories":"بستن منوی دسته‌بندی‌ها","browseByTheme":"مرور بر اساس تم","quickLinks":"لینک‌های سریع","bundlePacks":"بسته‌های ترکیبی","parentsTeachers":"برای والدین و معلمان","more":"دسته‌بندی‌های بیشتر","kids":"کودکان","categoryNames":{"cute":"پازل‌های بامزه","flowers":"گل‌ها"}},"audience":{"kidsTitle":"برای بچه‌ها","kidsText":"تم‌های دوستانه حیوانات، دایناسورها و وسایل نقلیه با نقاط شماره‌گذاری شده واضح. بردهای آسان که اعتماد به نفس واقعی ایجاد می‌کنند.","parentsTitle":"برای والدین","parentsText":"فعالیت‌های آرام و بدون نیاز به صفحه نمایش برای خانه، مسافرت و رستوران. چاپ از هر دستگاهی در کمتر از یک دقیقه.","teachersTitle":"برای معلمان","teachersText":"نکات ضروری برای تمرین صبحگاهی، دانش‌آموزانی که زود تمام می‌کنند، دانش‌آموزان جایگزین و ایستگاه‌های کلاس درس - بدون نیاز به آمادگی قبلی."},"categories":{"eyebrow":"بر اساس موضوع و سطح مهارت سازماندهی شده است","heading":"پازل‌های نقطه به نقطه را بر اساس دسته‌بندی مرور کنید","description":"از شکل‌های ساده ۱۰ نقطه‌ای برای کودکان نوپا گرفته تا چالش‌های ۲۰۰ نقطه‌ای برای بچه‌های بزرگتر - بر اساس دسته‌بندی مرتب شده‌اند تا بتوانید شکل مناسب و رایگان قابل چاپ را در عرض چند ثانیه پیدا کنید.","puzzles":"{count, plural, one {# پازل} other {# پازل}}","comingSoon":"به زودی","badges":{"dinosaurs":"همین الان موجوده!","ocean":"همین الان موجوده!","playgrounds":"همین الان موجوده!","garden":"همین الان موجوده!","usa250":"جدید!","uae":"همین الان موجوده!","cute":"جدید!","circus":"جدید!"},"items":{"dinosaurs":{"name":"دایناسورها","description":"غرق در سرگرمی‌های ماقبل تاریخ شوید! تی‌رکس، تریسراتوپس، ولوسیراپتور و {count} پازل‌های نقطه به نقطه رایگان، بچه‌های شما عاشقشان خواهند شد."},"animals":{"name":"حیوانات","description":"موجوداتی دوست‌داشتنی برای تمرین اولیه اعداد."},"vehicles":{"name":"وسایل نقلیه","description":"ماشین‌ها، کامیون‌ها، موشک‌ها و ماشین‌آلات."},"fantasy":{"name":"فانتزی","description":"قلعه‌ها، اسب‌های تک‌شاخ، اژدهاها و داستان‌های الهام‌بخش."},"seasonal":{"name":"فصلی","description":"فعالیت‌های تقویم تعطیلات و کلاس درس."},"ocean":{"name":"اقیانوس","description":"حیوانات دریایی و صفحات رنگ آمیزی آرامش."},"playgrounds":{"name":"زمین‌های بازی","description":"تاب، سرسره و تفریحات فضای باز برای ماجراجویان کوچک."},"garden":{"name":"باغ","description":"دستکش، بیلچه و ابزار برای کمک به باغبانان کوچک."},"usa250":{"name":"آمریکا ۲۵۰ سال","description":"دویست و پنجاهمین سالگرد تولد آمریکا را با پازل‌های میهن‌پرستانه‌ی نقطه به نقطه که به تاریخ آمریکا می‌پردازند، جشن بگیرید."},"uae":{"name":"امارات متحده عربی","description":"امارات متحده عربی را کاوش کنید! بناهای نمادینی مانند برج العرب، آماده‌ی اتصال و رنگ‌آمیزی هستند."},"space":{"name":"فضا","description":"سیارات، فضانوردان و ماجراجویی‌های موشکی."},"worksheets":{"name":"برگه‌های کار","description":"برگه‌های توالی اعداد آماده برای معلم."},"bigDotBooks":{"name":"کتاب‌های بیگ دات","description":"پازل‌های بلند برای زبان‌آموزان مسن‌ترِ متمرکز."},"cute":{"name":"ناز","description":"توله سگ‌های بامزه، ماشین‌های کوچک و {count} پازل جذاب و رایگان نقطه به نقطه که بچه‌هایتان عاشقشان خواهند شد."},"circus":{"name":"سیرک","description":"مدیران حلقه، چادرهای بزرگ و سرگرمی زمان نمایش برای یادگیرندگان جوان."}}},"puzzleSection":{"eyebrow":"نمونه‌های قابل چاپ رایگان - بدون نیاز به ثبت‌نام","heading":"ورق‌های نقطه‌چین محبوب برای چاپ همین حالا","weeklyPack":"بسته هفتگی را ببینید →","downloadLink":"دانلود رایگان نسخه قابل چاپ","new":"جدید","imageAlt":"{name} کاربرگ قابل چاپ نقطه به نقطه رایگان برای {age}","categories":{"Dinosaurs":"دایناسورها","Ocean":"اقیانوس","Playgrounds":"زمین‌های بازی","Garden":"باغ","Cute":"ناز","USA 250 Years":"آمریکا ۲۵۰ سال","UAE":"امارات متحده عربی"},"items":{"trex-61-dot-to-dot-puzzle":{"name":"چالش ۶۱ نقطه‌ای تی-رکس"},"brontosaurus-dot-to-dot-puzzle":{"name":"برونتوسوروس"},"mermaid-dot-to-dot-puzzle":{"name":"پری دریایی"},"merman-dot-to-dot-puzzle":{"name":"مردمن"},"seahorse-dot-to-dot-puzzle":{"name":"اسب دریایی"},"whale-dot-to-dot-puzzle":{"name":"نهنگ"},"swing-playgrounds-dot-to-dot-puzzle":{"name":"زمین بازی تاب"},"slide-playgrounds-dot-to-dot-puzzle":{"name":"زمین بازی سرسره"},"seesaw-playground-dot-to-dot-puzzle":{"name":"زمین بازی سیسا"},"roller-coaster-playground-dot-to-dot-puzzle":{"name":"زمین بازی ترن هوایی"},"wheelbarrow-playground-dot-to-dot-puzzle":{"name":"زمین بازی چرخ دستی"},"garden-gloves-dot-to-dot-puzzle":{"name":"دستکش باغبانی"},"garden-trowel-dot-to-dot-puzzle":{"name":"ماله باغبانی"},"gas-balloon-usa-250-dot-to-dot-puzzle":{"name":"بالن گازی آمریکا ۲۵۰"},"america-250-birthday-fireworks-dot-to-dot-puzzle":{"name":"آتش بازی تولد ۲۵۰ سالگی آمریکا"},"america-250-anniversary-liberty-bell-wings-1776-dot-to-dot-puzzle":{"name":"آمریکا ۲۵۰ لیبرتی بل وینگز"},"usa-250-astronaut-dot-to-dot-puzzle":{"name":"فضانورد آمریکا ۲۵۰"},"usa-250-anniversary-sports-kids-podium-dot-to-dot-puzzle":{"name":"سکوی ۲۵۰ سالگی ورزش کودکان آمریکا"},"usa-250-anniversary-airplane-banner-dot-to-dot-puzzle":{"name":"بنر هواپیما به مناسبت ۲۵۰ سالگی آمریکا"},"usa-250-space-shuttle-dot-to-dot-puzzle":{"name":"شاتل فضایی آمریکا ۲۵۰"},"usa-250-birthday-balloons-stars-dot-to-dot-puzzle":{"name":"آمریکا ۲۵۰ بادکنک و ستاره تولد"},"usa-250-birthday-cake-dot-to-dot-puzzle":{"name":"کیک تولد آمریکا ۲۵۰"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"بنر ایگل آمریکا ۲۵۰"},"burj-al-arab-dot-to-dot-puzzle":{"name":"برج العرب"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"قهوه جوش دالاه"}}},"benefits":{"eyebrow":"با حمایت مربیان دوران کودکی","heading":"چرا کاربرگ‌های نقطه به نقطه برای رشد کودک عالی هستند؟","description":"طرح‌های چاپی «نقطه‌ها را به هم وصل کن» چیزی بیش از یک سرگرمی هستند - آن‌ها ابزاری مبتنی بر تحقیق هستند که توسط معلمان پیش‌دبستانی و مهدکودک برای ایجاد مهارت‌های اصلی یادگیری اولیه استفاده می‌شوند.","fineMotorTitle":"مهارت‌های حرکتی ظریف را تقویت می‌کند","fineMotorText":"کشیدن خطوط نقطه به نقطه، قدرت گرفتن مداد، هماهنگی چشم و دست و کنترل عضلات مورد نیاز کودکان برای نوشتن را تقویت می‌کند.","numberTitle":"تقویت تشخیص اعداد","numberText":"دنبال کردن نقطه‌های ۱ → ۲ → ۳ به ترتیب، ترتیب شمارش، تشخیص اعداد و مفاهیم اولیه ریاضی را به طور طبیعی از طریق بازی آموزش می‌دهد.","focusTitle":"تمرکز و توجه را بهبود می‌بخشد","focusText":"تکمیل یک پازلِ وصل کردن نقطه‌ها نیاز به توجه مداوم دارد - روشی آرام و بدون صفحه نمایش برای تمرین تمرکز برای پیش‌دبستانی تا کلاس سوم.","confidenceTitle":"پاداش فوری و اعتماد به نفس","confidenceText":"وقتی تصویر پنهان ظاهر می‌شود، بچه‌ها فوراً حس موفقیت را تجربه می‌کنند. این پیروزی کوچک، عشق به یادگیری و طرز فکر رشد را در آنها ایجاد می‌کند."},"howTo":{"eyebrow":"آماده در کمتر از ۶۰ ثانیه","heading":"چگونه کاربرگ‌های نقطه به نقطه رایگان خود را دانلود و چاپ کنید","step1Title":"پازل خود را انتخاب کنید","step1Text":"یک تم (حیوانات، دایناسورها، وسایل نقلیه، تعطیلات) و یک محدوده نقطه گذاری انتخاب کنید که با سن و سطح مهارت فرزندتان مطابقت داشته باشد.","step2Title":"دانلود رایگان فایل PDF","step2Text":"روی «دانلود رایگان قابل چاپ» کلیک کنید - بدون نیاز به حساب کاربری، ایمیل و پرداخت هزینه. مرورگر شما فوراً فایل PDF را دانلود می‌کند.","step3Title":"چاپ کنید و لذت ببرید","step3Text":"روی کاغذ استاندارد US Letter (20.5 × 23.5 سانتی‌متر) چاپ کنید. چاپ سیاه و سفید کاملاً مناسب است. آن را به فرزندتان بدهید و تماشا کنید که چطور نقطه‌ها را به هم وصل می‌کند!"},"trust":{"eyebrow":"چرا والدین و معلمان ما را انتخاب می‌کنند؟","heading":"رایگان، امن و فوق‌العاده آسان برای استفاده.","noAccountTitle":"بدون نیاز به حساب کاربری","noAccountText":"هر فایل قابل چاپ نقطه به نقطه بلافاصله دانلود می‌شود - بدون ثبت نام، بدون ایمیل، بدون نیاز به پرداخت هزینه. فقط کلیک کنید و چاپ کنید.","safeTitle":"گاوصندوق کلاس درس","safeText":"صفحات پازل تمیز و بدون تبلیغات که برای چاپگرهای مدارس طراحی شده‌اند. برای کار صبحگاهی، تکالیف یا اوقات فراغت مناسب هستند.","fastTitle":"طراحی سریع","fastText":"صفحات استاتیک، تصاویر بهینه شده و فونت‌های محلی به این معنی است که پازل‌ها به سرعت در هر دستگاهی - تلفن، تبلت یا لپ‌تاپ - بارگذاری می‌شوند."},"faq":{"eyebrow":"سوالات متداول","heading":"سوالات متداول","q1":"آیا همه طرح‌های چاپ نقطه به نقطه در این سایت کاملاً رایگان هستند؟","a1":"بله - دانلود و چاپ هر برگه تمرینی نقطه چین در DotToDotFreePrintables.com کاملاً رایگان است. هیچ حساب کاربری، اشتراک یا کارت اعتباری لازم نیست.","q2":"کاربرگ‌های نقطه به نقطه برای چه سنی مناسب هستند؟","a2":"صفحات چاپی ما سنین ۲ تا ۱۲ سال را پوشش می‌دهند. صفحات تمرین آسان (۱۰ تا ۲۰ نقطه) برای کودکان نوپا و پیش‌دبستانی مناسب است، صفحات تمرین متوسط ​​(۲۰ تا ۵۰ نقطه) برای مهدکودک و کلاس اول عالی هستند و صفحات تمرین سخت‌تر (۵۰ تا ۲۰۰+ نقطه) برای کلاس دوم تا ششم مناسب است.","q3":"فایل‌های قابل چاپ connect-the-dots چه فرمتی دارند؟","a3":"تمام برگه‌های کار به صورت فایل‌های PDF آماده چاپ، با اندازه کاغذ استاندارد US Letter (8.5 اینچ × 11 اینچ) دانلود می‌شوند. آن‌ها را در هر مرورگر یا نرم‌افزار نمایش PDF باز کنید و چاپ کنید - به نرم‌افزار خاصی نیاز نیست.","q4":"آیا برای پیش‌دبستانی و مهدکودک، کاربرگ‌های نقطه به نقطه دارید؟","a4":"کاملاً. ساده‌ترین برگه‌های تمرین ما از ۱ تا ۱۰ نقطه شروع می‌شوند (مناسب برای سنین ۲ تا ۴ سال) و شامل تم‌های الفبا و تشخیص اعداد هستند که برای کلاس‌های پیش‌دبستانی و مهدکودک طراحی شده‌اند.","q5":"آیا معلمان می‌توانند از این برگه‌های تمرینیِ «نقطه‌های وصل» در کلاس استفاده کنند؟","a5":"بله! طرح‌های چاپی ما برای استفاده شخصی و کلاسی رایگان هستند. آن‌ها برای کارهای صبحگاهی، فعالیت‌های زود تمام کردن، برنامه‌های درسی جایگزین، مراکز حرکتی ظریف و بسته‌های تکالیف محبوب هستند.","q6":"آیا پازل‌های نقطه به نقطه به مهارت‌های حرکتی ظریف کمک می‌کنند؟","a6":"بله - کشیدن خطوط بین نقاط، قدرت گرفتن مداد و هماهنگی دست و چشم را که از آمادگی برای نوشتن پشتیبانی می‌کند، افزایش می‌دهد. بسیاری از کاردرمانگران و معلمان مهدکودک به همین دلیل فعالیت‌های وصل کردن نقطه‌ها را توصیه می‌کنند.","q7":"آیا طرح‌های چاپی نقطه به نقطه با موضوع حیوانات یا دایناسورها دارید؟","a7":"ما ۱۱ دسته داریم شامل حیوانات، دایناسورها، وسایل نقلیه، موجودات اقیانوسی، زمین‌های بازی، آمریکا ۲۵۰ سال، فضا، فانتزی، تم‌های فصلی/تعطیلات، بسته‌های کاربرگ معلم و کتاب‌های نقطه‌ای بزرگ. طرح‌های جدید هفتگی اضافه می‌شوند.","q8":"آیا می‌توانم این پازل‌ها را سیاه و سفید چاپ کنم؟","a8":"بله — تمام کاربرگ‌های ما برای چاپ سیاه و سفید طراحی شده‌اند تا در مصرف جوهر صرفه‌جویی شود. آن‌ها روی هر چاپگر خانگی یا کلاسی عالی به نظر می‌رسند."},"newsletter":{"eyebrow":"بسته آغازین قابل چاپ - کاملاً رایگان","heading":"۲۰ نمونه چاپ نقطه به نقطه رایگان را در صندوق ورودی خود دریافت کنید.","description":"مجموعه‌ای مناسب برای والدین و معلمان که شامل حیوانات، وسایل نقلیه، دایناسورها و مضامین فصلی می‌شود - همه برای کاغذ استاندارد US Letter اندازه‌بندی شده‌اند و برای چاپ سیاه و سفید بهینه شده‌اند."},"blog":{"eyebrow":"ایده‌هایی برای بزرگسالان","heading":"نکات آموزشی برای خانه و کلاس درس","viewAll":"مشاهده همه مقالات","read":"بخوانید"},"feedback":{"eyebrow":"ما دوست داریم از شما بشنویم","heading":"ارسال بازخورد","description":"ایده‌ای برای حل یک معما دارید، لینکی خراب می‌بینید یا فقط می‌خواهید سلامی به ما برسانید؟ در زیر برای ما بنویسید."},"footer":{"description":"پازل‌های نقطه به نقطه قابل چاپ و کاربرگ‌های اتصال نقطه‌ها برای کودکان، والدین و معلمان. همه پازل‌ها برای دانلود، چاپ و اشتراک‌گذاری رایگان هستند.","kids":"بچه‌ها","parents":"والدین","teachers":"معلمان","blog":"وبلاگ","faq":"سوالات متداول","feedback":"بازخورد","about":"درباره","contact":"تماس","privacy":"حریم خصوصی","terms":"شرایط","sitemap":"نقشه سایت","copyright":"© {year} DotToDotFreePrintables.com · فعالیت‌های رایگان قابل چاپ برای کودکان"},"common":{"home":"خانه","new":"جدید","comingSoon":"به زودی","downloadFree":"دانلود رایگان نسخه قابل چاپ","viewDownload":"مشاهده و دانلود","shareTitle":"{name} نقطه به نقطه قابل چاپ - PDF رایگان","downloadAria":"دانلود PDF قابل چاپ نقطه به نقطه رایگان {name}","bookmarkTitle":"{name} نقطه به نقطه قابل چاپ – PDF رایگان برای کودکان","showSlide":"نمایش اسلاید {number}","ageRange":"سن {min}-{max}","difficultyLabel":"سختی {level} از ۳","difficulty":{"1":"آسان","2":"متوسط","3":"سخت"},"dots":"۱–{count} نقطه","homeVideoEyebrow":"ویدئو","homeVideoH2":"سرگرمی نقطه به نقطه را در عمل تماشا کنید","skipToContent":"پرش به محتوای اصلی","joinTeachers":"به {count}+ معلم بپیوندید","breadcrumbAria":"نوار نان"},"puzzleSearch":{"placeholder":"Search by name or topic... e.g. ocean, whale, T-Rex","searchAria":"پازل‌های جستجو","clearSearch":"Clear search","toggleFilters":"Toggle filters","filters":"Filters","filterOptions":"Filter options","topic":"Topic","numberOfDots":"Number of dots","recentlyAddedOnly":"Recently added only","clearAllFilters":"Clear all filters","clearFilters":"Clear filters","resultsFound":"{count, plural, one {# پازل پیدا شد} other {# پازل پیدا شد}}","puzzlesAvailable":"{count, plural, one {# puzzle available} other {# puzzles available}}","noMatches":"هیچ معمایی با جستجوی شما مطابقت نداشت.","openPuzzle":"Open {name}","imageAlt":"{name} نقطه به نقطه قابل چاپ","viewPuzzle":"View puzzle →","dotRanges":{"under35":"Under 35 dots","35to50":"35-50 dots","51to70":"51-70 dots","over70":"70+ dots"},"categories":{"Dinosaurs":