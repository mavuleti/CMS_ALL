d:["$","$L10",null,{"formats":"$undefined","locale":"en","messages":{"nav":{"scanMe":"Scan me","blog":"Blog","search":"Search","kids":"Kids - Puzzles","teachers":"Teachers","parents":"Parents","contact":"Contact us","freePack":"Free pack"},"homepageUi":{"title":"Find the perfect dot to dot printables","description":"Print, connect the dots, and bring amazing pictures to life. Free and ready for fun!","searchPlaceholder":"Try ocean, dinosaur, or flowers","filterPuzzles":"Filter puzzles","age":"Age","dots":"Dots","featuredPuzzles":"Featured printable puzzles","savePuzzle":"Save {name}","removeSavedPuzzle":"Remove {name} from saved puzzles","downloads":"downloads","bookTitle":"Best of 2026 · {count}","bookDescription":"Our favorite dot-to-dots in one printable PDF book.","searchUnavailable":"Search is temporarily unavailable. Please try again.","popularEyebrow":"Popular this week","mostDownloaded":"Most downloaded puzzles","downloadCountAria":"{count} or more downloads","freshPrintables":"Fresh printables","recentlyAdded":"Recently added","browseCategories":"Browse puzzle categories","openCategories":"Open categories menu","closeCategories":"Close categories menu","browseByTheme":"Browse by theme","quickLinks":"Quick links","bundlePacks":"Bundle Packs","parentsTeachers":"For Parents & Teachers","more":"More categories","kids":"Kids","categoryNames":{"cute":"Cute Puzzles","flowers":"Flowers"}},"audience":{"kidsTitle":"For kids","kidsText":"Friendly animal, dinosaur, and vehicle themes with clear numbered dots. Easy wins that build real confidence.","parentsTitle":"For parents","parentsText":"Screen-free quiet-time activities for home, travel, and restaurants. Print from any device in under a minute.","teachersTitle":"For teachers","teachersText":"Low-prep connect-the-dots for morning work, early finishers, subs, and classroom stations — no prep required."},"categories":{"eyebrow":"Organized by theme and skill level","heading":"Browse dot to dot puzzles by category","description":"From simple 38-dot shapes for beginners to 130+ dot challenges for older kids — sorted by category so you find the right free printable in seconds.","puzzles":"{count, plural, one {# puzzle} other {# puzzles}}","comingSoon":"Coming soon","badges":{"dinosaurs":"Available now!","ocean":"Available now!","playgrounds":"Available now!","garden":"Available now!","usa250":"New!","uae":"Available now!","cute":"New!","circus":"New!"},"items":{"dinosaurs":{"name":"Dinosaurs","description":"Roar into prehistoric fun! T-Rex, Triceratops, Velociraptor and {count} free dot to dot puzzles your kids will love."},"animals":{"name":"Animals","description":"Friendly creatures for early number practice."},"vehicles":{"name":"Vehicles","description":"Cars, trucks, rockets, and machines."},"fantasy":{"name":"Fantasy","description":"Castles, unicorns, dragons, and story prompts."},"seasonal":{"name":"Seasonal","description":"Holiday and classroom calendar activities."},"ocean":{"name":"Ocean","description":"Sea animals and calm coloring and colouring pages."},"playgrounds":{"name":"Playgrounds","description":"Swings, slides, and outdoor fun for little adventurers."},"garden":{"name":"Garden","description":"Gloves, trowels, and tools for little garden helpers."},"usa250":{"name":"America 250 Years","description":"Celebrate America's 250th birthday with patriotic dot to dot puzzles honoring American history."},"uae":{"name":"UAE","description":"Explore the United Arab Emirates! Iconic landmarks like the Burj Al Arab, ready to connect and colour."},"space":{"name":"Space","description":"Planets, astronauts, and rocket adventures."},"worksheets":{"name":"Worksheets","description":"Teacher-ready number sequencing sheets."},"bigDotBooks":{"name":"Big Dot Books","description":"Long-form puzzles for focused older learners."},"cute":{"name":"Cute","description":"Adorable puppies, little cars, and {count} charming free dot to dot puzzles your kids will love."},"circus":{"name":"Circus","description":"Ringmasters, big tops, and showtime fun for young learners."}}},"puzzleSection":{"eyebrow":"Free printable samples — no sign-up","heading":"Popular connect-the-dots sheets to print now","weeklyPack":"See weekly pack →","downloadLink":"Download free printable","new":"New","imageAlt":"{name} free dot to dot printable worksheet for {age}","categories":{"Dinosaurs":"Dinosaurs","Ocean":"Ocean","Playgrounds":"Playgrounds","Garden":"Garden","Cute":"Cute","USA 250 Years":"America 250 Years","UAE":"UAE"},"items":{"trex-61-dot-to-dot-puzzle":{"name":"T-Rex 61-Dot Challenge"},"brontosaurus-dot-to-dot-puzzle":{"name":"Brontosaurus"},"mermaid-dot-to-dot-puzzle":{"name":"Mermaid"},"merman-dot-to-dot-puzzle":{"name":"Merman"},"seahorse-dot-to-dot-puzzle":{"name":"Seahorse"},"whale-dot-to-dot-puzzle":{"name":"Whale"},"swing-playgrounds-dot-to-dot-puzzle":{"name":"Swing Playground"},"slide-playgrounds-dot-to-dot-puzzle":{"name":"Slide Playground"},"seesaw-playground-dot-to-dot-puzzle":{"name":"Seesaw Playground"},"roller-coaster-playground-dot-to-dot-puzzle":{"name":"Roller Coaster Playground"},"wheelbarrow-playground-dot-to-dot-puzzle":{"name":"Wheelbarrow Playground"},"garden-gloves-dot-to-dot-puzzle":{"name":"Garden Gloves"},"garden-trowel-dot-to-dot-puzzle":{"name":"Garden Trowel"},"gas-balloon-usa-250-dot-to-dot-puzzle":{"name":"Gas Balloon America 250"},"america-250-birthday-fireworks-dot-to-dot-puzzle":{"name":"America 250 Birthday Fireworks"},"america-250-anniversary-liberty-bell-wings-1776-dot-to-dot-puzzle":{"name":"America 250 Liberty Bell Wings"},"usa-250-astronaut-dot-to-dot-puzzle":{"name":"America 250 Astronaut"},"usa-250-anniversary-sports-kids-podium-dot-to-dot-puzzle":{"name":"America 250 Anniversary Sports Kids Podium"},"usa-250-anniversary-airplane-banner-dot-to-dot-puzzle":{"name":"America 250 Anniversary Airplane Banner"},"usa-250-space-shuttle-dot-to-dot-puzzle":{"name":"America 250 Space Shuttle"},"usa-250-birthday-balloons-stars-dot-to-dot-puzzle":{"name":"America 250 Birthday Balloons and Stars"},"usa-250-birthday-cake-dot-to-dot-puzzle":{"name":"America 250 Birthday Cake"},"america-250-anniversary-eagle-banner-dot-to-dot-puzzle":{"name":"America 250 Eagle Banner"},"burj-al-arab-dot-to-dot-puzzle":{"name":"Burj Al Arab"},"dallah-coffee-pot-dot-to-dot-puzzle":{"name":"Dallah Coffee Pot"}}},"benefits":{"eyebrow":"Backed by early childhood educators","heading":"Why dot to dot worksheets are great for child development","description":"Connect-the-dots printables are more than just fun — they support early learning in preschool (nursery/reception), kindergarten/prep, and UK EYFS classrooms across the US, UK, Canada, and Australia.","fineMotorTitle":"Builds fine motor skills","fineMotorText":"Drawing dot to dot lines develops pencil grip, hand-eye coordination, and the muscle control children need for handwriting.","numberTitle":"Reinforces number recognition","numberText":"Following dots 1 → 2 → 3 in sequence teaches counting order, number recognition, and early math concepts naturally through play.","focusTitle":"Improves focus and concentration","focusText":"Completing a connect-the-dots puzzle requires sustained attention — a calm, screen-free way to practice focus for preschool to grade 3.","confidenceTitle":"Instant reward and confidence","confidenceText":"When the hidden picture appears, kids feel an immediate sense of achievement. That small win builds a love of learning and a growth mindset."},"howTo":{"eyebrow":"Ready in under 60 seconds","heading":"How to download and print your free dot to dot worksheets","step1Title":"Choose your puzzle","step1Text":"Pick a theme (animals, dinosaurs, vehicles, holiday) and a dot range that matches your child's age and skill level.","step2Title":"Download the free PDF","step2Text":"Click \"Download free printable\" — no account, no email, no paywall. Your browser downloads the PDF instantly.","step3Title":"Print and enjoy","step3Text":"Print on standard US Letter (8.5\" × 11\") or A4 paper. Black and white works perfectly. After connecting the dots, children can use the finished picture as a coloring (colouring) page."},"trust":{"eyebrow":"Why parents and teachers choose us","heading":"Free, safe, and ridiculously easy to use.","noAccountTitle":"No account required","noAccountText":"Every dot to dot printable downloads immediately — no sign-up, no email, no paywall. Just click and print.","safeTitle":"Classroom safe","safeText":"Clean, ad-free puzzle pages designed for school printers. Works for morning work, homework, or quiet time.","fastTitle":"Fast by design","fastText":"Static pages, optimized images, and local fonts mean puzzles load fast on any device — phone, tablet, or laptop."},"faq":{"eyebrow":"Common questions","heading":"Frequently asked questions","q1":"Are all dot to dot printables on this site completely free?","a1":"Yes — every connect-the-dots worksheet on DotToDotFreePrintables.com is 100% free to download and print. No account, subscription, or credit card is ever required.","q2":"What age are dot to dot worksheets suitable for?","a2":"Our printables cover ages 4–12. Easy worksheets (around 38–55 dots) suit preschoolers and kindergartners (prep in Australia), medium sheets (around 60–90 dots) are great for kindergarten and 1st grade, and harder sheets (90–130+ dots) challenge 2nd through 6th graders.","q3":"What format are the connect-the-dots printables?","a3":"All worksheets download as print-ready PDF files sized for standard US Letter (8.5\" × 11\") or A4 paper. Open in any browser or PDF viewer and print — no special software needed.","q4":"Do you have dot to dot worksheets for preschool and kindergarten?","a4":"Absolutely. Our easiest worksheets start at 1–10 dots (perfect for ages 2–4) and include alphabet and number-recognition themes designed for Pre-K and kindergarten classrooms.","q5":"Can teachers use these connect-the-dots worksheets in class?","a5":"Yes! Our printables are free for personal and classroom use. They are popular for morning work, early finisher activities, substitute lesson plans, fine motor centers, and homework packets.","q6":"Do dot to dot puzzles help with fine motor skills?","a6":"Yes — drawing lines between dots builds the pencil-grip strength and hand-eye coordination that support handwriting readiness. Many occupational therapists and kindergarten teachers recommend connect-the-dots activities for this reason.","q7":"Do you have themed dot to dot printables like animals or dinosaurs?","a7":"We have 11 categories including animals, dinosaurs, vehicles, ocean creatures, playgrounds, America 250 Years, space, fantasy, seasonal/holiday themes, teacher worksheet packs, and big dot books. New designs are added weekly.","q8":"Can I print these puzzles in black and white?","a8":"Yes — all of our connect-the-dots worksheets are designed for black and white printing to save on ink. They look great on any home or classroom printer."},"newsletter":{"eyebrow":"Printable starter pack — totally free","heading":"Get 20 free dot to dot printables delivered to your inbox.","description":"A parent and teacher-friendly collection covering animals, vehicles, dinosaurs, and seasonal themes — sized for standard US Letter or A4 paper and optimized for black and white printing."},"blog":{"eyebrow":"Ideas for grown-ups","heading":"Learning tips for home and classroom","viewAll":"View all articles","read":"Read"},"feedback":{"eyebrow":"We'd love to hear from you","heading":"Send feedback","description":"Have a puzzle idea, spotted a broken link, or just want to say hi? Drop us a note below."},"footer":{"description":"Free dot to dot printables and connect-the-dots worksheets for kids, parents, and teachers in the US, UK, Canada, and Australia. All puzzles are free to download, print, and share.","kids":"Kids","parents":"Parents","teachers":"Teachers","blog":"Blog","faq":"FAQ","feedback":"Feedback","about":"About","contact":"Contact","privacy":"Privacy","term