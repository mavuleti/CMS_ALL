2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://dottodotfreeprintables.com/fi/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Usa 250\",\"item\":\"https://dottodotfreeprintables.com/fi/usa-250/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Amerikka 250 -kotkabanderoli\",\"item\":\"https://dottodotfreeprintables.com/fi/usa-250/america-250-anniversary-eagle-banner-dot-to-dot-puzzle/\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"Amerikka 250 -kotkabanderoli\",\"description\":\"Valittuna kansalliseksi symboliksi vuonna 1782, kalju kotka kantaa America 250 -banneria 104 pisteen yli. Tulosta ilmainen PDF ikäryhmälle 6–10.\",\"educationalUse\":\"Fine motor skills, number sequencing\"}"}}],["$","main",null,{"children":[["$","nav",null,{"className":"breadcrumb","aria-label":"Leipäpolku","children":[["$","$Lf",null,{"href":"/fi/","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-house","aria-hidden":"true","children":[["$","path","5wwlr5",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"}],["$","path","1d0kgt",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"}],"$undefined"]}]," ","Kotiin"]}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","$Lf",null,{"href":"/fi/usa-250/","children":"Usa 250"}],["$","span",null,{"aria-hidden":"true","children":" › "}],["$","span",null,{"aria-current":"page","children":"Amerikka 250 -kotkabanderoli"}]]}],["$","div",null,{"style":{"maxWidth":1180,"margin":"0 auto","padding":"0 24px 20px"},"children":null}],["$","div",null,{"className":"puzzle-page-layout section","style":{"paddingTop":0},"children":[["$","div",null,{"className":"puzzle-preview-col","children":[["$","div",null,{"className":"puzzle-preview-card","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Majesteettinen kalju kotka kantaa pitkää banneria, siivet levitettynä 104 tulostettavan pisteen yli","width":540,"height":420,"loading":"eager","fetchPriority":"high","decoding":"async","className":"$undefined","style":{"width":"100%","height":"auto","display":"block","borderRadius":16}}]}],["$","div",null,{"className":"puzzle-side-ad","children":null}]]}],["$","div",null,{"className":"puzzle-details-col","children":[["$","p",null,{"className":"eyebrow","children":["Free ","Usa 250"," Printable"]}],["$","h1",null,{"style":{"fontSize":"clamp(1.8rem, 4vw, 2.8rem)"},"children":"Amerikka 250 -kotkabanderoli Dot-to-Dot Printable"}],["$","p",null,{"style":{"color":"var(--muted)","fontSize":"1.05rem","lineHeight":1.65,"margin":"14px 0 20px"},"children":"Yhdistä 104 pistettä paljastaaksesi majesteettisen amerikanvalkopäämerikotkan, joka kantaa isänmaallista lippua Amerikan 250-vuotisjuhlan kunniaksi! Tämä ilmainen tulostettava tehtävä auttaa lapsia harjoittelemaan numeroiden lukemista ja keskittymistä samalla kun he kunnioittavat yhtä Amerikan voimakkaimmista vapauden ja voiman symboleista. Täydellinen 6–10-vuotiaille."}],["$","div",null,{"className":"meta-chips","children":[["$","span",null,{"className":"chip","children":["Ages:"," ",""]}],["$","span",null,{"className":"chip","children":["Dots:"," 1–",0]}],["$","span",null,{"className":"chip chip--free","children":"100% Free"}]]}],["$","div",null,{"style":{"margin":"16px 0"},"children":[["$","p",null,{"style":{"fontWeight":800,"marginBottom":8,"fontSize":"0.9rem"},"children":"Difficulty"}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":10},"children":[["$","div",null,{"className":"difficulty","role":"img","aria-label":"Vaikeusaste 1/3","style":{"margin":0},"children":[["$","span","1",{"className":"on"}],["$","span","2",{"className":""}],["$","span","3",{"className":""}]]}],["$","span",null,{"style":{"fontSize":"0.85rem","fontWeight":800,"color":"var(--muted)"},"children":"Easy"}]]}]]}],["$","div",null,{"className":"fun-fact-box","children":[["$","span",null,{"style":{"fontSize":"1.3rem"},"aria-hidden":"true","children":"!"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fun fact:"}]," ","Kalju kotka valittiin Yhdysvaltojen kansalliseksi symboliksi vuonna 1782. Se esiintyy Yhdysvaltojen suursealissa, presidentin lipussa ja lukemattomissa virallisissa tunnuksissa — edustaen vapautta, voimaa ja Amerikan tasavallan kestävää henkeä."]}]]}],["$","div",null,{"style":{"margin":"20px 0 16px"},"children":null}],["$","p",null,{"className":"asset-note","children":"Printable PDF path is not present in the export JSON."}],"$L10",["$","$L11",null,{"title":"Amerikka 250 -kotkabanderoli Yhdistä pisteet - Tulostettava - Ilmainen PDF","imageUrl":"","compact":true}],["$","p",null,{"style":{"fontSize":"0.8rem","color":"var(--muted)","marginTop":10,"lineHeight":1.5},"children":"No sign-up needed. Opens as a PDF. Print on US Letter (8.5 × 11 inch) or A4 paper. Free for home and classroom use."}],["$","$Lf",null,{"href":"/fi/usa-250/","style":{"display":"inline-flex","alignItems":"center","gap":6,"marginTop":18,"fontWeight":800,"color":"#d94f70","textDecoration":"none"},"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}]," Back to all ","Usa 250"," puzzles"]}]]}]]}],["$","section",null,{"id":"dot-guide","className":"section","style":{"paddingTop":0,"maxWidth":800,"margin":"0 auto","padding":"0 24px 48px"},"children":[["$","h2",null,{"style":{"fontSize":"clamp(1.4rem, 3vw, 2rem)","marginBottom":12},"children":["Amerikka 250 -kotkabanderoli"," Dot-to-Dot Puzzle Guide"]}],["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7,"marginBottom":28},"dangerouslySetInnerHTML":{"__html":"Amerikka täyttää 250 vuotta – eikä mikään symboli vangitse tätä henkeä paremmin kuin mahtava kaljupäämerikotka! Kotka on koristanut Yhdysvaltojen suurta sinettiä 244 vuoden ajan ja liitänyt elävänä vapauden symbolina. Tänään kotkasi pitelee lippua julistaakseen Amerikan suurinta syntymäpäivää. Ota kynä, etsi piste 1 ja autetaan tätä kotkaa lentoon!"}}],[["$","div","1–22",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["1–22"," — ","Kotkan pää ja nokka"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Aloita pisteestä 1 ja yhdistä se pisteeseen 22 piirtääksesi kaljukotkan rohkean ja ylpeän pään – mukaan lukien sen terävän, kaarevan nokan. Lapset harjoittelevat tässä lyhyitä suuntaavia vetoja ja lempeitä käyriä, kehittäen kynän hallintaa ja muodostaen kotkan tunnistettavimman piirteen."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Valkopäämerikotka ei oikeastaan ole kalju! Sen nimi tulee vanhasta englanninkielisestä sanasta \"balde\", joka tarkoittaa valkoista. Silmiinpistävät valkoiset pään höyhenet ilmestyvät, kun lintu saavuttaa aikuisuuden noin viiden vuoden iässä. Ennen sitä nuorilla kotkilla on ruskean ja valkoisen kirjava höyhenpeite."]}]]}]]}],["$","div","23–46",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["23–46"," — ","Siipien kärkiväli — Vasen siipi"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Jatka pisteestä 23 pisteeseen 46 pyyhkäistäksesi kotkan voimakkaan vasemman siiven. Nämä pitkät, sulavat vedot ovat erinomaista harjoitusta lapsille käsien liikkeiden ja laaja-alaisen kynänhallinnan kehittämiseksi. Kannusta lapsia sujuvaan ja varmaan vetoon olkapäästä siivenkärkeen."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Valkopäämerikotkan siipien kärkiväli voi olla jopa 2,4 metriä (lähes 8 jalkaa) – suunnilleen yhtä leveä kuin pienen auton pituus! Näiden valtavien siipien ansiosta kotka voi liidellä tuntikausia nousevien lämpimien ilmapatsaiden, termikkojen, päällä tuskin lainkaan räpytellen."]}]]}]]}],["$","div","47–70",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["47–70"," — ","Siipien kärkiväli — Oikea siipi"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Peilaa vasen siipi yhdistämällä pisteet 47 ja 70 muodostaaksesi oikean siiven. Symmetria on tärkeä visuaalinen käsite nuorille oppijoille, ja molempien siipien yhdistäminen antaa tyydyttävän tasapainon ja saavutuksen tunteen. Huomaa, kuinka viivat nyt pyyhkäisevät vastakkaiseen suuntaan."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Kotkilla on jopa 7 000 höyhentä peittäen ruumistaan, joista jokainen on muotoiltu tarkasti tehtäväänsä varten – leveät lentohöyhenet nostoa varten, pehmeät vartalohöyhenet eristystä varten ja jäykät pyrstöhöyhenet ohjaamista varten. Ne sulkasatoivat ja kasvattavat höyheniä uudelleen vähitellen, jotta ne voivat aina lentää."]}]]}]]}],["$","div","71–88",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["71–88"," — ","Kynnet ja isänmaallinen lippu"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Yhdistä pisteet 71 ja 88 piirtääksesi kotkan voimakkaat kynnet, jotka tarttuvat hulmuavaan vuosipäiväbanneriin. Lapset harjoittelevat teräviä kulmikkaita viivoja ja kaarevia nauhan muotoja – vaativampia vetoja, jotka palkitsevat huolellisen tarkkaavaisuuden ja vakaan kädenhallinnan."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Kotkan kynnet voivat kohdistaa noin 400 paunan neliötuumaa kohden (psi) otteen – paljon voimakkaamman kuin keskimääräisen ihmisen käden. Kynsiä käytetään kalojen ja pienten nisäkkäiden pyydystämiseen, ja kotkan ote on niin luja, että saalis harvoin pääsee karkuun pyydystämisen jälkeen."]}]]}]]}],["$","div","89–104",{"style":{"marginBottom":24,"paddingLeft":16,"borderLeft":"3px solid var(--blue-light, #63b3ed)"},"children":[["$","h3",null,{"style":{"fontSize":"1rem","fontWeight":800,"marginBottom":6},"children":["89–104"," — ","Tähdet, kilpi ja viimeistelyn yksityiskohdat"]}],["$","p",null,{"style":{"lineHeight":1.7,"marginBottom":6},"children":"Täydennä palapeli yhdistämällä pisteet 89 ja 104 lisätäksesi isänmaalliset tähdet, kilpimerkinnät ja viimeiset yksityiskohdat, jotka tekevät tästä kotkasta aidosti amerikkalaisen. Käytä aikaa näiden viimeisten pisteiden kanssa – tasainen viimeistely kokoaa kokonaisuuden kauniisti yhteen."}],["$","div",null,{"className":"guide-fact","children":[["$","span",null,{"className":"guide-fact__icon","aria-hidden":"true","children":"💡"}],["$","div",null,{"className":"guide-fact__body","children":[["$","span",null,{"className":"guide-fact__label","children":"Fun fact!"}],["$","br",null,{}],"Vuonna 1782 suunniteltu Yhdysvaltain suuri sinetti esittää kaljupäämerikotkaa pitelemässä oliivinoksaa toisessa kynnessä (symboli rauhaa) ja 13 nuolen nippua toisessa (symboli valmiutta puolustaa vapautta). Kotka on kääntynyt oliivinoksaa kohti muistutuksena siitä, että rauha on aina ensimmäinen valinta."]}]]}]]}]]]}],["$","section",null,{"className":"section","style":{"paddingTop":8},"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["More free ","Usa 250"," printables"]}],["$","h2",null,{"style":{"fontSize":"clamp(1.5rem, 3vw, 2.2rem)"},"children":"You might also like"}]]}],["$","div",null,{"className":"puzzle-grid","children":[["$","article","gas-balloon-usa-250-dot-to-dot-puzzle",{"className":"puzzle-card","children":[["$","$Lf",null,{"href":"/fi/usa-250/gas-balloon-usa-250-dot-to-dot-puzzle/","className":"puzzle-image","children":["$","img",null,{"src":"","srcSet":"$undefined","sizes":"$undefined","alt":"Juhlava kaasupallo leijuu Amerikka 250 -aiheisen maiseman yllä, kannateltuna 48 pisteestä","width":420,"height":320,"loading":"lazy","fetchPriority":"auto","decoding":"async","className":"$undefined","style":"$undefined"}]}],["$","div",null,{"className":"puzzle-body","children":[["$","p",null,{"className":"puzzle-category","children":"Usa 250"}],["$","h3",null