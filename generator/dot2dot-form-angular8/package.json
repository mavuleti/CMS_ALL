{
  "name": "dot-to-dot-cms",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "assets:menu": "python ../tools/build_menu_assets.py ../../content src/assets/content",
    "schema:preview": "python ../tools/migrate_legacy_schema.py ../../content --dry-run",
    "schema:convert": "python ../tools/migrate_legacy_schema.py ../../content",
    "prestart": "npm run assets:menu",
    "start": "ng serve",
    "prebuild": "npm run assets:menu",
    "build": "ng build",
    "pretest": "npm run build",
    "test": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.20",
    "@angular/cli": "21.2.20",
    "@angular/compiler-cli": "21.2.19",
    "@angular/language-service": "21.2.19",
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3"
  }
}
